# Firebase Web config (safe to expose on the client, but keep it in .env).
# Copy this file to `.env` and fill in the values from:
# Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
# Expo inlines any variable prefixed with EXPO_PUBLIC_ into the client bundle.
# Restart the dev server (`npx expo start -c`) after changing these values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# RevenueCat public SDK keys (Project settings > API keys in app.revenuecat.com).
# Public/client-side keys, same trust level as the Firebase config above.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# FASE iOS-4 — TEMPORARY, local Sandbox testing only. Set to the exact string
# `true` to let a promo code with NO real appleOfferCodeMonthly/Annual open
# Purchases.presentCodeRedemptionSheet() anyway, so a real Apple Sandbox Code
# can be redeemed end-to-end. Only ever takes effect in a __DEV__ bundle
# (never a release/EAS/App Store build — see
# src/lib/appleOfferCodeSandboxTest.ts). Any value other than `true`,
# including absence, keeps the normal fail-closed behavior. Never set this
# in a shared/CI/EAS environment.
EXPO_PUBLIC_ENABLE_APPLE_OFFER_CODE_SANDBOX_TEST=
