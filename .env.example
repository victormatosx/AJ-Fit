# Firebase Web config (safe to expose on the client, but keep it in .env).
# Copy this file to `.env` and fill in the values from:
# Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
# Expo inlines any variable prefixed with EXPO_PUBLIC_ into the client bundle.
# Restart the dev server (`npx expo start -c`) after changing these values.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# RevenueCat public SDK keys (Project settings > API keys in app.revenuecat.com).
# Public/client-side keys, same trust level as the Firebase config above.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Opt-in only: verbose RevenueCat request/StoreKit logs in development builds.
# Keep disabled unless actively investigating billing.
EXPO_PUBLIC_REVENUECAT_DEBUG_LOGS=0

# Development-only timing diagnostics; values contain stage + duration only.
EXPO_PUBLIC_PHOTO_VAULT_PERF=0

# Development-only: enables the local Subscription Override dev tool
# (Settings > Developer). Even when set to 1, it only takes effect in a
# debug (__DEV__) JS bundle — it is dead-code-eliminated and structurally
# inert in any preview/production build regardless of this value. Never set
# this in a preview/production EAS build profile.
EXPO_PUBLIC_ENABLE_DEV_SUBSCRIPTION_OVERRIDES=0

# Development-only: shows the read-only Workout Lifecycle QA panel
# (Settings > Developer). Same dead-code-eliminated __DEV__-only shape as
# the flag above. This panel never grants QA_ACCELERATED progression
# thresholds by itself — it only displays the backend's own decision (see
# docs/workout-lifecycle/v2/qa/MANUAL_ACCELERATED_LIFECYCLE_QA.md). Never
# set this in a preview/production EAS build profile.
EXPO_PUBLIC_ENABLE_DEV_WORKOUT_LIFECYCLE_QA_PANEL=0

# App Check Debug Provider token, scoped to YOU and this machine — never
# shared between developers. Generate your own value once (e.g. `uuidgen`),
# register it in Firebase Console > App Check > Apps > com.ajfit.app >
# Manage debug tokens with a display name identifying you/this machine, and
# put ONLY the real value in your local `.env` (gitignored) — never here.
#
# Read by plugins/app-check-debug-token at `expo prebuild` time, which
# generates ios/AJFit/AJFitAppCheckDebugTokenLocal.swift (gitignored, never
# committed) — its ENTIRE content is wrapped in `#if DEBUG`, so a
# Release/TestFlight/App Store build never compiles it at all and always
# uses App Attest instead. This is a compile-time guarantee, not a runtime
# check: the value cannot physically end up in a Release .app bundle.
#
# Required for every iOS Development Build — its absence fails loudly (a
# distinct, catchable ERR_APP_CHECK_DEBUG_TOKEN_MISSING error) the moment
# something needs an App Check token, by design: no silent random fallback.
AJFIT_APP_CHECK_DEBUG_TOKEN=

# Snapshot diary registration. Server switch is configured separately; no UID allowlist.
EXPO_PUBLIC_NUTRITION_PLAN_SNAPSHOT_ENABLED=false
