# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# Também na forma de symlink (os worktrees apontam para o node_modules da
# árvore principal): `node_modules/` com barra casa só diretório, e foi assim
# que um symlink com caminho absoluto da máquina acabou rastreado.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
firebase-debug.log
firestore-debug.log

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
modules/**/build/

# Gradle caches de modulos nativos locais (build artifacts)
modules/*/android/.gradle/
modules/*/android/build/

# Generated by plugins/app-check-debug-token at `expo prebuild` time from the
# local AJFIT_APP_CHECK_DEBUG_TOKEN env var (see .env.example). Never commit —
# unlike /ios above, modules/ is normally tracked, so this needs its own
# explicit, exact-path entry.
modules/ajfit-app-check/ios/AJFitAppCheckDebugTokenLocal.swift

# Home bootstrap perf audit — local cold-start capture artifacts, not source.
perf-runs/

# Local git worktrees (isolated workspaces for subagent-driven development)
.worktrees/

# Generated Open Food Facts bulk exports and resumable-import state.
# Curated source fixtures in this directory remain versionable.
/scripts/nutrition/sources/openfoodfacts-products.csv.gz
/scripts/nutrition/sources/off-brazil-bulk.jsonl
/scripts/nutrition/sources/off-brazil-csv.jsonl
/scripts/nutrition/sources/*.checkpoint.json
.streak-test-scratch/
