{
  "expo": {
    "name": "AJ Fit",
    "slug": "aj-fit",
    "scheme": "ajfit",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/logo-ajfit-app.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#020010",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ajfit.app",
      "appleTeamId": "TGYZB49RLA",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "deploymentTarget": "16.4"
    },
    "android": {
      "package": "com.ajfit.mobile",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#020010",
        "foregroundImage": "./assets/logo-ajfit-app.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ac6b8f54-5fef-4e2d-9904-0a2a863b805a"
      },
      "googleWebClientId": "753375043967-oldj9c61p82vni4s1n5fjkks3gueh4se.apps.googleusercontent.com",
      "googleIosClientId": "753375043967-siop689dt3f7njn4kjtlq6hd1ev9lun2.apps.googleusercontent.com"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.753375043967-siop689dt3f7njn4kjtlq6hd1ev9lun2"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O AJ Fit usa o Face ID para proteger o acesso às suas fotos privadas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O AJ Fit acessa suas fotos para você escolher imagens de perfil, suporte, do seu cofre privado ou para compartilhar seu treino.",
          "cameraPermission": "O AJ Fit acessa sua câmera para você tirar fotos de perfil, suporte, do seu cofre privado ou para compartilhar seu treino.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false,
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-sharing",
      "expo-video",
      [
        "expo-notifications",
        {
          "defaultChannel": "ajfit_general",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/aj-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-system-ui",
      "./plugins/rest-activity",
      "./plugins/app-check-debug-token",
      [
        "./plugins/instagram-stories",
        {
          "metaAppId": "1566726211857054",
          "androidEnabled": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "enforceContrast": false
        }
      ],
      "./plugins/ios-min-deployment-target",
      "expo-font",
      "expo-status-bar"
    ]
  }
}
