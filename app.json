{
  "expo": {
    "name": "AJ Fit",
    "slug": "aj-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ajfit.mobile",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ajfit.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ac6b8f54-5fef-4e2d-9904-0a2a863b805a"
      },
      "googleWebClientId": "753375043967-oldj9c61p82vni4s1n5fjkks3gueh4se.apps.googleusercontent.com",
      "googleIosClientId": "753375043967-sfm41c00upk4u0nbee451d3cs9bsbe1s.apps.googleusercontent.com"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.753375043967-sfm41c00upk4u0nbee451d3cs9bsbe1s"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store"
    ]
  }
}
