{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ajfit://nutrition/ai-output-schema/1.0.0",
  "title": "AJ Fit Nutrition AI Generation Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meals"
  ],
  "properties": {
    "meals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "recommendedOptionIndex",
          "options"
        ],
        "properties": {
          "slot": {
            "enum": [
              "breakfast",
              "morning_snack",
              "lunch",
              "afternoon_snack",
              "dinner",
              "supper"
            ]
          },
          "recommendedOptionIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "foods"
              ],
              "properties": {
                "foods": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "foodId",
                      "grams"
                    ],
                    "properties": {
                      "foodId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "grams": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "postValidationRequirements": [
    "all_food_ids_must_exist",
    "all_food_ids_must_be_in_allowed_subset",
    "all_foods_must_be_generation_status_approved",
    "excluded_foods_must_not_appear",
    "dietary_pattern_must_be_respected",
    "allergen_constraints_must_be_respected",
    "nutrition_must_be_recomputed_from_catalog",
    "meal_targets_must_pass_deterministic_tolerances",
    "daily_targets_must_pass_deterministic_tolerances"
  ]
}
