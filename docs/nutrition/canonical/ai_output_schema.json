{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ajfit://nutrition/ai-output-schema/3.0.0",
  "title": "AJ Fit Nutrition AI Generation Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meals"
  ],
  "properties": {
    "meals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "foods"
        ],
        "properties": {
          "slot": {
            "enum": [
              "breakfast",
              "morning_snack",
              "lunch",
              "afternoon_snack",
              "dinner",
              "supper"
            ]
          },
          "foods": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "quantity",
                "unit",
                "preparationNote",
                "estimatedNutrition",
                "allergens",
                "ingredients"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 5000
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "preparationNote": {
                  "type": "string",
                  "maxLength": 200
                },
                "estimatedNutrition": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kcal", "proteinG", "carbsG", "fatG", "fiberG"],
                  "properties": {
                    "kcal": { "type": "number", "minimum": 0 },
                    "proteinG": { "type": "number", "minimum": 0 },
                    "carbsG": { "type": "number", "minimum": 0 },
                    "fatG": { "type": "number", "minimum": 0 },
                    "fiberG": { "type": "number", "minimum": 0 }
                  }
                },
                "ingredients": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 30,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "origin"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "origin": {
                        "type": "string",
                        "enum": [
                          "plant",
                          "mineral",
                          "dairy",
                          "egg",
                          "fish",
                          "shellfish",
                          "terrestrial_animal",
                          "other_animal",
                          "unknown"
                        ]
                      }
                    }
                  }
                },
                "allergens": {
                  "type": "array",
                  "maxItems": 9,
                  "uniqueItems": true,
                  "items": { "enum": ["milk", "egg", "peanut", "tree_nuts", "soy", "wheat", "fish", "shellfish", "other"] }
                }
              }
            }
          }
        }
      }
    }
  },
  "notes": [
    "v3 (2026-10-10, cost pass): exactly one recommended option per meal on the initial full-plan generation — no options/recommendedOptionIndex wrapper. Alternatives for a single meal are generated on demand via a separate call/schema (OPENAI_MEAL_ALTERNATIVE_SCHEMA in functions/src/nutrition/ai/provider.ts), which still returns 2-3 options + recommendedOptionIndex, unchanged."
  ],
  "postValidationRequirements": [
    "no_catalog_or_foodid_resolution",
    "self_declared_allergens_must_respect_excluded_allergens",
    "meal_targets_must_pass_deterministic_tolerances",
    "daily_targets_must_pass_deterministic_tolerances"
  ]
}
