{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ajfit://nutrition/meal-plan-schema/1.0.0",
  "title": "AJ Fit Nutrition Meal Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "generationId",
    "status",
    "profileSnapshot",
    "engineSnapshot",
    "meals",
    "versions"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "generationId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "profileSnapshot": {
      "type": "object"
    },
    "engineSnapshot": {
      "type": "object"
    },
    "meals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "recommendedOptionId",
          "options"
        ],
        "properties": {
          "slot": {
            "enum": [
              "breakfast",
              "morning_snack",
              "lunch",
              "afternoon_snack",
              "dinner",
              "supper"
            ]
          },
          "recommendedOptionId": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "foods",
                "totals"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "foods": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "foodId",
                      "grams",
                      "snapshot"
                    ],
                    "properties": {
                      "foodId": {
                        "type": "string"
                      },
                      "grams": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "snapshot": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "kcal",
                          "proteinG",
                          "carbsG",
                          "fatG"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "kcal": {
                            "type": "number",
                            "minimum": 0
                          },
                          "proteinG": {
                            "type": "number",
                            "minimum": 0
                          },
                          "carbsG": {
                            "type": "number",
                            "minimum": 0
                          },
                          "fatG": {
                            "type": "number",
                            "minimum": 0
                          },
                          "fiberG": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          }
                        }
                      }
                    }
                  }
                },
                "totals": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kcal",
                    "proteinG",
                    "carbsG",
                    "fatG",
                    "fiberG"
                  ],
                  "properties": {
                    "kcal": {
                      "type": "number",
                      "minimum": 0
                    },
                    "proteinG": {
                      "type": "number",
                      "minimum": 0
                    },
                    "carbsG": {
                      "type": "number",
                      "minimum": 0
                    },
                    "fatG": {
                      "type": "number",
                      "minimum": 0
                    },
                    "fiberG": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planSchemaVersion",
        "nutritionEngineVersion",
        "questionnaireVersion",
        "foodCatalogVersion",
        "aiGenerationSchemaVersion"
      ],
      "properties": {
        "planSchemaVersion": {
          "type": "string"
        },
        "nutritionEngineVersion": {
          "type": "string"
        },
        "questionnaireVersion": {
          "type": [
            "integer",
            "string"
          ]
        },
        "foodCatalogVersion": {
          "type": "string"
        },
        "aiGenerationSchemaVersion": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        }
      }
    }
  }
}
