{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ajfit://nutrition/meal-plan-schema/2.0.0",
  "title": "AJ Fit Nutrition Meal Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planId",
    "generationId",
    "status",
    "profileSnapshot",
    "physicalSnapshot",
    "engineSnapshot",
    "meals",
    "dailyTotals",
    "generationMetadata",
    "versions"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "generationId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "profileSnapshot": {
      "type": "object"
    },
    "physicalSnapshot": { "type": "object" },
    "engineSnapshot": {
      "type": "object"
    },
    "meals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "recommendedOptionId",
          "options"
        ],
        "properties": {
          "slot": {
            "enum": [
              "breakfast",
              "morning_snack",
              "lunch",
              "afternoon_snack",
              "dinner",
              "supper"
            ]
          },
          "recommendedOptionId": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "foods",
                "totals"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "foods": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "quantity",
                      "unit",
                      "preparationNote",
                      "estimatedNutrition",
                      "allergens"
                    ],
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                      "quantity": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 },
                      "unit": { "type": "string", "minLength": 1, "maxLength": 24 },
                      "preparationNote": { "type": "string", "maxLength": 200 },
                      "estimatedNutrition": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kcal", "proteinG", "carbsG", "fatG", "fiberG"],
                        "properties": {
                          "kcal": { "type": "number", "minimum": 0 },
                          "proteinG": { "type": "number", "minimum": 0 },
                          "carbsG": { "type": "number", "minimum": 0 },
                          "fatG": { "type": "number", "minimum": 0 },
                          "fiberG": { "type": "number", "minimum": 0 }
                        }
                      },
                      "allergens": {
                        "type": "array",
                        "maxItems": 9,
                        "uniqueItems": true,
                        "items": { "enum": ["milk", "egg", "peanut", "tree_nuts", "soy", "wheat", "fish", "shellfish", "other"] }
                      }
                    }
                  }
                },
                "totals": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kcal",
                    "proteinG",
                    "carbsG",
                    "fatG",
                    "fiberG"
                  ],
                  "properties": {
                    "kcal": {
                      "type": "number",
                      "minimum": 0
                    },
                    "proteinG": {
                      "type": "number",
                      "minimum": 0
                    },
                    "carbsG": {
                      "type": "number",
                      "minimum": 0
                    },
                    "fatG": {
                      "type": "number",
                      "minimum": 0
                    },
                    "fiberG": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dailyTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kcal", "proteinG", "carbsG", "fatG", "fiberG"],
      "properties": {
        "kcal": { "type": "number", "minimum": 0 },
        "proteinG": { "type": "number", "minimum": 0 },
        "carbsG": { "type": "number", "minimum": 0 },
        "fatG": { "type": "number", "minimum": 0 },
        "fiberG": { "type": "number", "minimum": 0 }
      }
    },
    "generationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "attempts", "corrected", "fallbackUsed"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "corrected": { "type": "boolean" },
        "fallbackUsed": { "type": "boolean" }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planSchemaVersion",
        "nutritionEngineVersion",
        "questionnaireVersion",
        "foodCatalogVersion",
        "aiGenerationSchemaVersion",
        "promptVersion"
      ],
      "properties": {
        "planSchemaVersion": {
          "type": "string"
        },
        "nutritionEngineVersion": {
          "type": "string"
        },
        "questionnaireVersion": {
          "type": "integer"
        },
        "foodCatalogVersion": {
          "type": "string",
          "description": "Vestigial since diet-quality-v3 (2026-10-10) — generation no longer reads nutritionFoods. Kept for schema stability; always a fixed placeholder string now."
        },
        "aiGenerationSchemaVersion": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        }
      }
    }
  }
}
