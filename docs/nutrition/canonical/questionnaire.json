{
  "schemaVersion": "1.0.0",
  "questionnaireVersion": 1,
  "name": "nutrition_profile",
  "displayName": "Perfil nutricional",
  "cta": "Criar minha dieta",
  "inheritFromExistingProfile": [
    "sex",
    "birthDate",
    "height",
    "goal"
  ],
  "weightSource": "latest_progress_weight",
  "goalCategoryResolution": {
    "directMappingSource": "canonical/nutrition_rules.json goals.normalization.mapping",
    "ambiguousGeneralGoals": ["strength", "conditioning", "perf", "return_to_training", "recon"],
    "ambiguousGeneralGoalsNote": "Must always match canonical/nutrition_rules.json goals.normalization.ambiguous.values exactly — single source of truth is that file, duplicated here only so the questionnaire's conditional question below is self-describing.",
    "note": "The general AJ Fit goal is NEVER replaced. When it has no direct mapping, the nutritionGoalCategory question below is required to resolve the energy-direction input the Nutrition Engine needs."
  },
  "questions": [
    {
      "id": "nutritionGoalCategory",
      "type": "single_select",
      "requiredWhen": "generalGoal in goalCategoryResolution.ambiguousGeneralGoals",
      "required": false,
      "options": [
        "muscle_gain",
        "weight_loss",
        "maintenance",
        "body_recomposition"
      ],
      "semantics": "resolves_energy_direction_only",
      "doesNotCreateIndependentGoal": true
    },
    {
      "id": "progressionPace",
      "type": "single_select",
      "required": true,
      "options": [
        "gradual",
        "moderate",
        "accelerated"
      ]
    },
    {
      "id": "targetWeightKg",
      "type": "number",
      "required": false
    },
    {
      "id": "nonTrainingActivityLevel",
      "type": "single_select",
      "required": true,
      "options": [
        "sedentary",
        "low_active",
        "active",
        "very_active"
      ]
    },
    {
      "id": "mealSlots",
      "type": "multi_select",
      "required": true,
      "minSelections": 2,
      "maxSelections": 6,
      "options": [
        "breakfast",
        "morning_snack",
        "lunch",
        "afternoon_snack",
        "dinner",
        "supper"
      ]
    },
    {
      "id": "dietaryPattern",
      "type": "single_select",
      "required": true,
      "options": [
        "omnivore",
        "vegetarian",
        "vegan",
        "pescatarian"
      ]
    },
    {
      "id": "preferredFoodIds",
      "type": "food_selection",
      "required": false,
      "allowIndifferent": true
    },
    {
      "id": "usualFoodIds",
      "type": "food_selection",
      "required": false
    },
    {
      "id": "excludedFoodIds",
      "type": "food_selection",
      "required": false,
      "semantics": "hard_exclusion"
    },
    {
      "id": "excludedAllergens",
      "type": "multi_select",
      "required": false,
      "semantics": "hard_exclusion",
      "options": ["milk", "egg", "peanut", "tree_nuts", "soy", "wheat", "fish", "shellfish", "other"]
    },
    {
      "id": "supplements",
      "type": "multi_select",
      "required": false,
      "options": [
        "whey_or_protein",
        "creatine",
        "caffeine_or_preworkout",
        "multivitamin",
        "omega_3",
        "other"
      ],
      "directlyImpactsPlan": [
        "whey_or_protein"
      ]
    },
    {
      "id": "pregnant",
      "type": "boolean",
      "required": true,
      "semantics": "current_state_not_snapshot",
      "prefillSource": "quiz_pregnancy_screening_initial_only"
    },
    {
      "id": "breastfeeding",
      "type": "boolean",
      "required": true,
      "semantics": "current_state_not_snapshot"
    },
    {
      "id": "varietyPreference",
      "type": "single_select",
      "required": true,
      "options": [
        "repeatable",
        "variety",
        "indifferent"
      ]
    }
  ],
  "pregnancyAndLactationStateOwner": "nutritionProfile/current",
  "pregnancyInitialPrefillSource": "quiz_pregnancy_screening",
  "pregnancyInitialPrefillSourceNote": "Quiz.pregnancyScreening is an immutable onboarding snapshot and must only be used to pre-fill pregnant/breastfeeding the first time nutritionProfile/current is created. It is never read again after that; the current value always lives in nutritionProfile/current and must be revalidated before every generation.",
  "medicalConditionsCollectedInV1": false,
  "freeTextQuestion": false,
  "languages": [
    "pt-BR"
  ],
  "snapshotOnGeneration": true
}
