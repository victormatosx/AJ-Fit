        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "allergy",
              "lactose",
              "gluten",
              "dietary_pattern",
              "ingredients",
              "quantity",
              "macros",
              "calories",
              "preferences",
              "insufficient_information"
