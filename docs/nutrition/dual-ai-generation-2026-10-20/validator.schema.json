          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium"
            ]
          },
          "mealIndex": {
            "type": [
              "integer",
              "null"
            ]
          },
          "optionIndex": {
            "type": [
              "integer",
              "null"
            ]
          },
          "foodIndex": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "suggestedCorrection": {
            "type": "string"
          }
        }
      }
    },
    "requiresRegeneration": {
      "type": "boolean"
    }
