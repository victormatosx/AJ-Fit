[debug] [2026-08-01T20:23:12.738Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ajfit-2f321/rulesets {"name":"projects/ajfit-2f321/rulesets/9573edca-7667-4a19-b599-a2ff3366c9df","source":{"files":[{"content":"rules_version = '2';\n\nservice firebase.storage {\n  match /b/{bucket}/o {\n    match /users/{userId}/profile/{fileName} {\n      allow read: if request.auth != null && request.auth.uid == userId;\n      allow create, update: if request.auth != null\n        && request.auth.uid == userId\n        && request.resource.size <= 5 * 1024 * 1024\n        && request.resource.contentType.matches('image/.*');\n      allow delete: if request.auth != null && request.auth.uid == userId;\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-08-01T20:23:12.610623Z","metadata":{"services":["firebase.storage"]}}
