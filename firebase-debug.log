[debug] [2026-08-01T20:55:38.353Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ajfit-2f321/rulesets {"name":"projects/ajfit-2f321/rulesets/9387d68c-75f1-4c3a-82a0-6f06ee2d07ba","source":{"files":[{"content":"rules_version = '2';\n\n// AJ Fit — Firestore Security Rules (SUGESTÃO / pendente de validação humana).\n//\n// Baseado em:\n//   - docs/12_seguranca_geral_do_app.md (cliente não é fonte de verdade;\n//     acesso apenas aos próprios dados; RevenueCat é dono da assinatura)\n//   - docs/04_contratos_de_api.md §5 (contrato do documento users/{userId})\n//\n// Princípio: o app só escreve profile e metadata.updatedAt. Preferências,\n// assinatura e metadados internos têm mapas próprios e validação independente.\n// As respostas do questionário ficam na subcoleção `questionnaires`. Campos de\n// assinatura e treino são gravados apenas pelo backend (Cloud Functions /\n// webhook RevenueCat via Admin SDK, que ignora estas regras).\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function profileValid(data) {\n      return data is map\n        && data.keys().hasAll(['name', 'email'])\n        && data.keys().hasOnly(['name', 'email', 'birthDate', 'photoURL'])\n        && data.name is string\n        && data.name.size() >= 2\n        && data.name.size() <= 50\n        && data.email is string\n        && (!('birthDate' in data)\n             || (data.birthDate is timestamp && data.birthDate <= request.time))\n        && (!('photoURL' in data)\n             || (data.photoURL is string && data.photoURL.size() <= 2048));\n    }\n\n    function preferencesValid(data) {\n      return data is map\n        && data.keys().hasAll(['language', 'units', 'theme'])\n        && data.keys().hasOnly(['language', 'units', 'theme'])\n        && data.language in ['pt-BR']\n        && data.units in ['metric', 'imperial']\n        && data.theme in ['dark', 'light', 'system'];\n    }\n\n    function subscriptionValid(data) {\n      return data is map\n        && data.keys().hasOnly(['status', 'provider', 'trialEndsAt', 'endsAt'])\n        && (!('status' in data)\n             || data.status in ['TRIAL', 'ACTIVE', 'CANCELED', 'BILLING_ISSUE', 'EXPIRED'])\n        && (!('provider' in data) || data.provider == 'REVENUECAT')\n        && (!('trialEndsAt' in data)\n             || data.trialEndsAt == null || data.trialEndsAt is timestamp)\n        && (!('endsAt' in data)\n             || data.endsAt == null || data.endsAt is timestamp);\n    }\n\n    function metadataValid(data) {\n      return data is map\n        && data.keys().hasAll(['role', 'createdAt', 'updatedAt'])\n        && data.keys().hasOnly(['role', 'activeWorkoutId', 'createdAt', 'updatedAt'])\n        && data.role == 'user'\n        && (!('activeWorkoutId' in data) || data.activeWorkoutId is string)\n        && data.createdAt is timestamp\n        && data.updatedAt is timestamp;\n    }\n\n    function nestedUserValid(data) {\n      return data.keys().hasAll(['profile', 'preferences', 'subscription', 'metadata'])\n        && data.keys().hasOnly(['profile', 'preferences', 'subscription', 'metadata'])\n        && profileValid(data.profile)\n        && preferencesValid(data.preferences)\n        && subscriptionValid(data.subscription)\n        && metadataValid(data.metadata);\n    }\n\n    // One-time, complete conversion of the former flat document. Every\n    // backend-owned value must be preserved exactly; after conversion the\n    // regular nested update rule applies and this branch becomes unreachable.\n    function legacyMigrationValid() {\n      let before = resource.data;\n      let after = request.resource.data;\n      return !('profile' in before)\n        && nestedUserValid(after)\n        && before.get('role', 'user') == 'user'\n        && after.profile.name == before.name\n        && after.profile.email == before.email\n        && after.profile.get('birthDate', null) == before.get('birthDate', null)\n        && after.profile.get('photoURL', null) == before.get('photoURL', null)\n        && after.preferences.language == before.get('language', 'pt-BR')\n        && after.preferences.units == 'metric'\n        && after.preferences.theme == 'dark'\n        && after.subscription.get('status', null) == before.get('subscriptionStatus', null)\n        && after.subscription.get('provider', null) == before.get('subscriptionProvider', null)\n        && after.subscription.get('trialEndsAt', null) == before.get('trialEndsAt', null)\n        && after.subscription.get('endsAt', null) == before.get('subscriptionEndsAt', null)\n        && after.metadata.role == before.get('role', 'user')\n        && after.metadata.get('activeWorkoutId', null) == before.get('activeWorkoutId', null)\n        && after.metadata.createdAt == before.createdAt\n        && after.metadata.updatedAt == request.time;\n    }\n\n    // Avaliações físicas (docs/03 §4/§8, docs/15 §10/§11/§18). `source` é um\n    // discriminador: guided exige os campos da calculadora (protocol, sex,\n    // age, folds, bodyFat, calculatorVersion); imported não exige nenhum\n    // deles e pode não ter bodyFat (campo simplesmente ausente — nunca 0).\n    // Campos derivados (bmi, leanMass, fatMass, sumFolds, bodyDensity) e o\n    // rótulo do protocolo nunca são aceitos: são resolvidos em tempo de\n    // leitura no app (src/lib/skinfoldCalculator.ts), nunca persistidos.\n    function assessmentCommonValid() {\n      let d = request.resource.data;\n      return d.source in ['guided', 'imported']\n        && d.measuredAt is timestamp\n        && d.measuredAt <= request.time\n        // `== request.time` (not just `is timestamp`) forces the client to\n        // have actually used serverTimestamp() — a client can't fabricate an\n        // arbitrary createdAt to game the measuredAt/createdAt tie-break sort.\n        && d.createdAt == request.time\n        && d.weight is number && d.weight > 0\n        && d.height is number && d.height > 0\n        && (!('notes' in d) || d.notes is string);\n    }\n\n    function guidedAssessmentValid() {\n      let d = request.resource.data;\n      return d.source == 'guided'\n        && d.keys().hasOnly([\n             'source', 'measuredAt', 'createdAt', 'weight', 'height', 'bodyFat',\n             'calculatorVersion', 'notes', 'protocol', 'sex', 'age', 'folds'\n           ])\n        && d.calculatorVersion == 1\n        && d.protocol in ['jp3', 'jp7']\n        && d.sex in ['m', 'f']\n        && d.age is number && d.age > 0\n        && d.bodyFat is number && d.bodyFat > 0\n        && d.folds is map && d.folds.size() > 0;\n    }\n\n    function importedAssessmentValid() {\n      let d = request.resource.data;\n      return d.source == 'imported'\n        && d.keys().hasOnly([\n             'source', 'measuredAt', 'createdAt', 'weight', 'height', 'bodyFat',\n             'notes', 'bodyWater', 'basalMetabolism', 'visceralFat'\n           ])\n        && (!('bodyFat' in d) || (d.bodyFat is number && d.bodyFat > 0))\n        && (!('bodyWater' in d) || (d.bodyWater is number && d.bodyWater > 0))\n        && (!('basalMetabolism' in d) || (d.basalMetabolism is number && d.basalMetabolism > 0))\n        && (!('visceralFat' in d) || (d.visceralFat is number && d.visceralFat > 0));\n    }\n\n    match /users/{userId} {\n      // Leitura: apenas o dono do documento.\n      allow read: if isOwner(userId);\n\n      // Criação: documento integralmente aninhado, com identidade coerente com\n      // o token e sem campos de assinatura/internos definidos pelo cliente.\n      allow create: if isOwner(userId)\n        && nestedUserValid(request.resource.data)\n        && request.resource.data.profile.email == request.auth.token.email\n        && request.resource.data.subscription.size() == 0\n        && !('activeWorkoutId' in request.resource.data.metadata)\n        && request.resource.data.metadata.createdAt == request.time\n        && request.resource.data.metadata.updatedAt == request.time;\n\n      // Atualização: apenas o dono e somente os campos editáveis do perfil.\n      // `diff().affectedKeys().hasOnly` impede alterações em campos de conta,\n      // assinatura, treino ou privilégios mesmo que novos campos sejam\n      // adicionados ao documento no futuro.\n      allow update: if isOwner(userId) && (\n        legacyMigrationValid()\n        || (\n          nestedUserValid(request.resource.data)\n          && request.resource.data.diff(resource.data).affectedKeys()\n               .hasOnly(['profile', 'metadata'])\n          && request.resource.data.profile.diff(resource.data.profile).affectedKeys()\n               .hasOnly(['name', 'birthDate', 'photoURL'])\n          && request.resource.data.metadata.diff(resource.data.metadata).affectedKeys()\n               .hasOnly(['updatedAt'])\n          && request.resource.data.metadata.updatedAt == request.time\n        )\n      );\n\n      // Exclusão: negada ao cliente (remoção é processo de backend — 90 dias,\n      // docs/12 §10). Somente o Admin SDK pode excluir.\n      allow delete: if false;\n\n      // Questionários do usuário (inicial + reavaliações futuras).\n      // Cada documento é um snapshot imutável.\n      match /questionnaires/{questionnaireId} {\n        // Leitura: apenas o dono do usuário pai.\n        allow read: if isOwner(userId);\n\n        // Criação: apenas o dono, com os campos esperados e válidos.\n        allow create: if isOwner(userId)\n          && request.resource.data.keys().hasOnly(\n               ['answers', 'version', 'createdAt'])\n          && request.resource.data.answers is map\n          && request.resource.data.version is int\n          && request.resource.data.version >= 1\n          && request.resource.data.createdAt is timestamp;\n\n        // Histórico imutável: sem edição nem exclusão pelo cliente.\n        allow update, delete: if false;\n      }\n\n      // Avaliações físicas do usuário (guiadas ou importadas). Cada documento\n      // é um snapshot imutável — nunca sobrescrever ou apagar (docs/15 §11).\n      match /assessments/{assessmentId} {\n        allow read: if isOwner(userId);\n\n        allow create: if isOwner(userId)\n          && assessmentCommonValid()\n          && (guidedAssessmentValid() || importedAssessmentValid());\n\n        allow update, delete: if false;\n      }\n    }\n\n    // Coleções de sistema (exercises, workout_templates, treinos do usuário,\n    // etc.) ainda não têm contrato de regras aprovado — negar por padrão até\n    // definição do Agente de Segurança/Arquiteto.\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-01T20:55:38.220271Z","metadata":{"services":["cloud.firestore"]}}
