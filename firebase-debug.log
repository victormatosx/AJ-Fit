[debug] [2026-08-01T20:55:35.061Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/ajfit-2f321/rulesets {"name":"projects/ajfit-2f321/rulesets/11998c0b-f13b-4f99-89bc-3192a867c49a","source":{"files":[{"content":"rules_version = '2';\n\nservice firebase.storage {\n  match /b/{bucket}/o {\n    match /users/{userId}/profile/avatar {\n      allow read: if request.auth != null && request.auth.uid == userId;\n      allow create, update: if request.auth != null\n        && request.auth.uid == userId\n        && request.resource.size <= 5 * 1024 * 1024\n        && request.resource.contentType.matches('image/.*');\n      allow delete: if request.auth != null && request.auth.uid == userId;\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-08-01T20:55:34.909103Z","metadata":{"services":["firebase.storage"]}}
