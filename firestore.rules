rules_version = '2';

// AJ Fit — Firestore Security Rules (production contract).
//
// Baseado em:
//   - docs/12_seguranca_geral_do_app.md (cliente não é fonte de verdade;
//     acesso apenas aos próprios dados; RevenueCat é dono da assinatura)
//   - docs/04_contratos_de_api.md §5 (contrato do documento users/{userId} —
//     profile/preferences/metadata)
//   - docs/13_assinaturas_e_billing.md §26 (schema de `subscription` —
//     referência única, consolidada na Sprint 3.5; espelhada em
//     functions/src/billing/{types,constants}.ts)
//
// Princípio: o app só escreve profile, language/units e metadata.updatedAt.
// Assinatura e metadados internos têm mapas próprios e validação independente.
// As respostas do questionário ficam na subcoleção `questionnaires`. Campos de
// assinatura é gravada apenas pelo backend. Programas de treino privados são
// snapshots client-authorized, validados e ativados atomicamente pelas regras.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasPasswordIdentity() {
      return isSignedIn()
        && request.auth.token.get('firebase', {})
             .get('identities', {})
             .get('email', []).size() > 0;
    }

    function hasVerifiedEmailForPrivateAccess() {
      return isSignedIn()
        && (!hasPasswordIdentity()
            || request.auth.token.get('email_verified', false) == true);
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && hasVerifiedEmailForPrivateAccess();
    }

    // Não existe checagem de assinatura por ação nestas regras.
    //
    // O AJ Fit é inteiramente pago: o acesso ao app já é condicionado à
    // mensalidade antes de qualquer tela funcional, então todo usuário
    // autenticado que alcança estes documentos é, por definição, assinante.
    // A antiga `hasServerPremium(userId)` (FASE 7) checava
    // `users/{userId}.subscription.entitlementActive` no create/delete de
    // progressPhotos e no create de assessments; virou redundante sob esse
    // modelo de produto e foi removida — junto com a cópia equivalente em
    // storage.rules.
    //
    // O que protege dado continua intacto: `isOwner(userId)` em todas as
    // operações, a imutabilidade dos snapshots (`allow update: if false`) e
    // a proibição do cliente escrever `subscription` em si (`subscription.
    // size() == 0` no create e a ausência de `subscription` do conjunto de
    // chaves permitidas no update) — o espelho segue sendo exclusivamente
    // do servidor, mesmo sem ninguém lendo `entitlementActive` aqui.

    // FASE 5 (docs/25_exclusao_de_conta_arquitetura.md — "Bloqueio imediato
    // da conta"): once `requestAccountDeletion` has durably accepted a
    // deletion, this becomes `false` and every private user-owned path
    // below denies read/write, regardless of the internal workflow status
    // (`REQUESTED`/`PROCESSING`/`RETRY_SCHEDULED`/`COMPLETED`/
    // `FAILED_TERMINAL` all mean "not active" — see
    // `functions/src/accountDeletion/activeAccountGuard.ts`'s doc comment
    // for why status is never inspected, only existence). A stale ID token
    // issued before the lock was created is exactly what this guards
    // against: `admin.auth().revokeRefreshTokens` alone does not invalidate
    // an already-issued ID token before its normal ~1h expiry, so this is
    // the layer that actually stops a client SDK write/read with such a
    // token, independent of any backend callable guard.
    //
    // One extra `exists()` read per rule evaluation. Deliberately checks
    // presence of the LOCK document, not
    // `accountDeletions/{deletionId}`'s `status` field — the lock is a
    // single, tiny, doc-id-keyed read; resolving a full record would need
    // an extra indirection this check does not need.
    //
    // Antes do deploy desta fase, o ruleset publicado foi confirmado byte a
    // byte contra o firestore.rules do HEAD inicial.
    function accountActive(userId) {
      return !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId));
    }

    // O painel autentica com Firebase Auth e o backend promove previamente o
    // documento do operador. Escritas do app nunca podem alterar metadata.role.
    function isAdmin() {
      return hasVerifiedEmailForPrivateAccess()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.metadata.role == 'admin';
    }

    function profileValid(data) {
      return data is map
        && data.keys().hasAll(['name', 'email'])
        && data.keys().hasOnly(['name', 'email', 'birthDate', 'photoURL', 'photoVersion', 'height'])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 50
        && data.email is string
        && (!('birthDate' in data)
             || (data.birthDate is timestamp && data.birthDate <= request.time))
        && (!('photoURL' in data)
             || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('photoVersion' in data) || data.photoVersion is timestamp)
        // Matches PROFILE_MIN_HEIGHT_CM/PROFILE_MAX_HEIGHT_CM in
        // src/lib/userProfileValidation.ts.
        && (!('height' in data)
             || (data.height is number && data.height >= 140 && data.height <= 220));
    }

    function preferencesValid(data) {
      // `hasAll` + `hasOnly` das mesmas 3 chaves impede mapas incompletos e
      // impede escritas do cliente que substituiriam o mapa inteiro por
      // { language } (o padrão perigoso do JS SDK, que apagaria theme/units
      // silenciosamente). O update legítimo usa caminho pontuado —
      // `preferences.language` — e nunca reescreve o mapa.
      //
      // O conjunto de idiomas DEVE bater exatamente com SUPPORTED_LANGUAGES
      // em src/types/language.ts.
      return data is map
        && data.keys().hasAll(['language', 'units', 'theme'])
        && data.keys().hasOnly(['language', 'units', 'theme'])
        && data.language in ['pt-BR', 'en', 'es']
        && data.units in ['system', 'metric', 'imperial']
        && data.theme in ['dark', 'light', 'system'];
    }

    // Shape of `users/{userId}.subscription` — consolidated in Sprint 3.5 to
    // match docs/13_assinaturas_e_billing.md §26 exactly (the sole schema
    // reference; functions/src/billing/{types,constants}.ts mirror the same
    // field list byte-for-byte). Only the backend (Admin SDK, which bypasses
    // these rules) ever writes real values here — this function exists only
    // to keep the CLIENT from ever writing an unexpected shape into this
    // block via `create`/the legacy migration path, per docs §25/§27.
    //
    // `endsAt` (the pre-3.5 field name, still referenced by
    // `legacyMigrationValid()` below for one-time migrations of the old flat
    // document) was renamed to `currentPeriodEndsAt` to match docs §26.
    // `lastEventAt` from the original docs §26 draft was dropped as
    // redundant with `updatedAt` for this project's scale — see
    // functions/src/billing/types.ts's `SubscriptionMirror` comment.
    //
    // Sprint 4.1 robustness fix (see the Sprint 4 audit report): adds
    // `lastEventTimestampMs`, RevenueCat's own event clock (Unix ms,
    // `event_timestamp_ms`), reintroducing the ordering protection that
    // `lastEventAt`'s Sprint 3.5 removal had eliminated. NOT a Firestore
    // `timestamp` type — a plain non-negative integer, matching its wire
    // format. Optional, exactly like every other field here: documents
    // written before this Sprint won't have it, and
    // `applySubscriptionEventAtomically` (functions/src/billing/subscriptionSync.ts)
    // treats that as "first event of the new mechanism" — no backfill
    // required, no rules exception needed for older documents.
    function subscriptionValid(data) {
      return data is map
        && data.keys().hasOnly([
             'status', 'entitlementActive', 'provider', 'productId', 'store',
             'startedAt', 'trialEndsAt', 'currentPeriodEndsAt', 'canceledAt',
             'lastRenewedAt', 'lastEventId', 'lastEventTimestampMs', 'updatedAt'
           ])
        && (!('status' in data)
             || data.status in ['TRIAL', 'ACTIVE', 'CANCELED', 'BILLING_ISSUE', 'EXPIRED'])
        && (!('entitlementActive' in data) || data.entitlementActive is bool)
        && (!('provider' in data) || data.provider == 'REVENUECAT')
        && (!('productId' in data) || data.productId is string)
        && (!('store' in data) || data.store in ['APP_STORE', 'PLAY_STORE'])
        && (!('startedAt' in data) || data.startedAt is timestamp)
        && (!('trialEndsAt' in data)
             || data.trialEndsAt == null || data.trialEndsAt is timestamp)
        && (!('currentPeriodEndsAt' in data)
             || data.currentPeriodEndsAt == null || data.currentPeriodEndsAt is timestamp)
        && (!('canceledAt' in data)
             || data.canceledAt == null || data.canceledAt is timestamp)
        && (!('lastRenewedAt' in data)
             || data.lastRenewedAt == null || data.lastRenewedAt is timestamp)
        && (!('lastEventId' in data) || data.lastEventId is string)
        && (!('lastEventTimestampMs' in data)
             || (data.lastEventTimestampMs is int && data.lastEventTimestampMs >= 0))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // `commercialGateResolvedAt` (initial-Paywall marker — see the
    // `UserProfile.metadata` doc comment in src/services/userProfile.ts):
    // OPTIONAL like `activeWorkoutId`/`attribution` (absent on every
    // document written before this field existed — never reinterpreted as
    // "account is new"). When present it is either `null` (client-written
    // only at account creation — see the `create` rule below) or a
    // `timestamp` (backend-only, via the Admin SDK, which bypasses these
    // Rules entirely — no client write path ever produces a timestamp
    // here, enforced by the `update` rule's `metadata` diff restricted to
    // `updatedAt`).
    function metadataValid(data) {
      return data is map
        && data.keys().hasAll(['role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(
             ['role', 'activeWorkoutId', 'createdAt', 'updatedAt', 'commercialGateResolvedAt'])
        && data.role in ['user', 'admin']
        && (!('activeWorkoutId' in data) || data.activeWorkoutId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('commercialGateResolvedAt' in data)
             || data.commercialGateResolvedAt == null
             || data.commercialGateResolvedAt is timestamp);
    }

    function workoutProgramLimitationValid(questionnaire, data) {
      let conditions = questionnaire.data.answers.get('specialConditions', []);
      let limits = questionnaire.data.answers.get('limits', []);
      return conditions is list
        && limits is list
        && (
          (
            !conditions.hasAny(['musculoskeletal_limitation'])
            && !limits.hasAny([
                 'knee', 'hip', 'back', 'shoulder', 'elbow', 'wrist', 'ankle_foot', 'other'
               ])
          )
          || (
            conditions.hasAny(['musculoskeletal_limitation'])
            && limits.size() >= 1
            && limits.toSet().hasOnly([
                 'knee', 'hip', 'back', 'shoulder', 'elbow', 'wrist', 'ankle_foot'
               ])
            && data.versions.limitationResolver == '1.0.0'
            && data.trace.limitationResolverVersion == 1
            && data.trace.limitationDecisions is list
            && data.trace.limitationDecisions.size() >= data.sessions.size()
            && data.trace.limitationDecisions.size() <= 100
          )
        );
    }

    function workoutProgramCommonValid(userId, programId, data) {
      let template = get(/databases/$(database)/documents/workoutTemplates/$(data.templateId));
      let questionnaire = get(/databases/$(database)/documents/users/$(userId)/questionnaires/$(data.questionnaireId));
      return data is map
        && data.keys().hasAll([
             'programId', 'planId', 'prescriptionId', 'templateId', 'templateVersion',
             'templateSourceVersion', 'templateContentHash', 'questionnaireId',
             'questionnaireVersion', 'status', 'source', 'requestedDays',
             'prescribedStructuredDays', 'population', 'environment',
             'goalFamily', 'split', 'sessions', 'versions', 'trace',
             'createdAt', 'activatedAt', 'updatedAt'
           ])
        && data.keys().hasOnly([
             'programId', 'planId', 'prescriptionId', 'templateId', 'templateVersion',
             'templateSourceVersion', 'templateContentHash', 'questionnaireId',
             'questionnaireVersion', 'status', 'source', 'requestedDays',
             'prescribedStructuredDays', 'population', 'environment',
             'goalFamily', 'split', 'adaptationStage', 'sessions', 'versions',
             'trace', 'limitationDatasetVersion', 'limitationDatasetHash',
             'prescribedTrainingFrequency', 'availability', 'weeklySchedule',
             'createdAt', 'activatedAt', 'updatedAt'
           ])
        && data.programId == programId
        // `planId` is `FinalWorkoutPlan.planId` spread verbatim onto the
        // program doc (`WorkoutProgramSnapshot extends FinalWorkoutPlan`,
        // src/services/workoutPrograms.ts); `prescriptionId` is always set
        // to that same value at persist time — enforced here too so the two
        // can never silently diverge.
        && data.planId is string
        && data.prescriptionId == data.planId
        && data.prescriptionId is string
        && data.templateId is string
        && data.templateId.matches('^T(00[1-9]|0[1-8][0-9]|090)$')
        && template.data.status == 'active'
        && data.templateVersion == template.data.version
        && data.templateSourceVersion == template.data.sourceVersion
        && data.templateContentHash == template.data.contentHash
        && data.questionnaireId is string
        && data.questionnaireVersion is int && data.questionnaireVersion >= 1
        && questionnaire.data.version == data.questionnaireVersion
        && workoutProgramLimitationValid(questionnaire, data)
        && data.status in ['active', 'superseded']
        && data.source in ['onboarding', 'manual_regeneration', 'automatic_progression', 'automatic_reconciliation']
        && data.requestedDays is int && data.requestedDays >= 2 && data.requestedDays <= 7
        && data.prescribedStructuredDays is int
        && data.prescribedStructuredDays >= 2 && data.prescribedStructuredDays <= 7
        && data.sessions is list && data.sessions.size() >= 1 && data.sessions.size() <= 7
        && data.versions is map
        && ((data.versions.templateLibrary == '1.3.0'
              && data.versions.compositionEngine == '2.0.0')
            || (data.versions.templateLibrary == '2.0.0'
              && data.versions.compositionEngine == '2.1.0'))
        && data.versions.selectionEngine in ['1.0.0', '2.0.0']
        && (
          (data.versions.selectionEngine == '1.0.0'
            && !data.keys().hasAny(['prescribedTrainingFrequency', 'availability', 'weeklySchedule']))
          ||
          (data.versions.selectionEngine == '2.0.0'
            && data.keys().hasAll(['prescribedTrainingFrequency', 'availability', 'weeklySchedule'])
            && data.prescribedTrainingFrequency is int
            && data.prescribedTrainingFrequency == data.prescribedStructuredDays
            && data.prescribedTrainingFrequency >= 2
            && data.prescribedTrainingFrequency <= 6
            && data.prescribedTrainingFrequency <= data.requestedDays
            && data.availability is map
            && data.availability.keys().hasAll(['days', 'weekdays'])
            && data.availability.keys().hasOnly(['days', 'weekdays'])
            && data.availability.days == data.requestedDays
            && data.availability.weekdays is list
            && (data.availability.weekdays.size() == 0
              || data.availability.weekdays.size() == data.availability.days)
            && data.weeklySchedule is list
            && (data.weeklySchedule.size() == 0 || data.weeklySchedule.size() == 7))
        )
        && data.versions.safetyRules == '1.0.0'
        && data.versions.modifierRules == '2.0.0'
        && data.trace is map
        && data.trace.safety is map
        && data.trace.safety.status in ['CLEAR', 'ADAPTED']
        && data.trace.unresolvedModifiers is list
        && data.trace.unresolvedModifiers.size() == 0
        && (!('adaptationStage' in data)
            || (data.adaptationStage is int && data.adaptationStage >= 1 && data.adaptationStage <= 3));
    }

    // New program snapshots are cryptographically tied to the exact active
    // clinical dataset. Legacy snapshots remain readable/updateable so an
    // activation transaction can supersede them without rewriting history.
    function workoutProgramLimitationDatasetValid(data) {
      let active = get(/databases/$(database)/documents/limitationDatasetState/active);
      return (
          !data.keys().hasAny(['limitationDatasetVersion', 'limitationDatasetHash'])
        ) || (
          data.keys().hasAll(['limitationDatasetVersion', 'limitationDatasetHash'])
          && data.limitationDatasetVersion is string
          && data.limitationDatasetVersion.size() >= 1
          && data.limitationDatasetVersion.size() <= 120
          && data.limitationDatasetHash is string
          && data.limitationDatasetHash.matches('^[a-f0-9]{64}$')
          && active.data.datasetVersion == data.limitationDatasetVersion
          && active.data.limitationDatasetHash == data.limitationDatasetHash
        );
    }

    // Workout Execution & History V1 (docs/workout-lifecycle/
    // 09_WORKOUT_EXECUTION_AND_HISTORY.md). `exercises` is validated only for
    // shape/bounds here, the same precedent `workoutProgramCommonValid` sets
    // for `sessions` above — deep per-set validation belongs to the app
    // layer, not Rules. Ownership of the referenced program comes from the
    // `get()` itself: it can only ever resolve under this same `userId`'s
    // subtree, so a bogus/foreign `programId` simply fails to exist.
    function workoutExecutionCommonValid(userId, data) {
      let program = get(/databases/$(database)/documents/users/$(userId)/workoutPrograms/$(data.programId));
      return data is map
        && data.keys().hasAll([
             'programId', 'templateId', 'sessionIndex', 'sessionName',
             'scheduledLocalDate', 'status', 'startedAt', 'finishedAt',
             'exercises', 'executionSchemaVersion', 'createdAt', 'updatedAt'
           ])
        && data.keys().hasOnly([
             'programId', 'templateId', 'sessionIndex', 'sessionName',
             'scheduledLocalDate', 'status', 'startedAt', 'finishedAt',
             'exercises', 'executionSchemaVersion', 'createdAt', 'updatedAt'
           ])
        && data.programId is string
        && program.data.programId == data.programId
        && data.templateId is string
        && data.sessionIndex is int && data.sessionIndex >= 0
        && data.sessionName is string
        && data.scheduledLocalDate is string
        && data.scheduledLocalDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status in ['IN_PROGRESS', 'COMPLETED', 'PARTIALLY_COMPLETED', 'ABANDONED']
        && data.startedAt is timestamp
        && (data.finishedAt == null || data.finishedAt is timestamp)
        && data.exercises is list && data.exercises.size() >= 1 && data.exercises.size() <= 20
        && data.executionSchemaVersion == 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Shape of `users/{userId}.attribution` — the read-optimized mirror of
    // a user's promo-code attribution (functions/src/attribution/types.ts's
    // `AttributionSnapshot`; source of truth is `couponRedemptions/{userId}`,
    // written only by the Admin SDK — see the `couponRedemptions` match
    // block below). Only the backend ever writes real values here; this
    // function exists so `nestedUserValid` can tolerate the field's
    // presence (once the backend has written it) without letting the
    // CLIENT ever populate or change it itself — see the `create`/`update`
    // rules on `users/{userId}` for the actual write blocks.
    function attributionValid(data) {
      return data is map
        && data.keys().hasOnly(['couponCode', 'campaignId', 'influencerId', 'appliedAt'])
        && (!('couponCode' in data) || data.couponCode is string)
        && (!('campaignId' in data) || data.campaignId is string)
        && (!('influencerId' in data) || data.influencerId is string)
        && (!('appliedAt' in data) || data.appliedAt is timestamp);
    }

    // `attribution` is OPTIONAL (absent on every document created before
    // this field existed, and on brand-new documents until the backend
    // applies a promo code) — `hasAll` only requires the original four
    // fields; `hasOnly` allows the fifth without forcing every existing
    // caller of this function to know about it.
    function nestedUserValid(data) {
      return data.keys().hasAll(['profile', 'preferences', 'subscription', 'metadata'])
        && data.keys().hasOnly(['profile', 'preferences', 'subscription', 'metadata', 'attribution'])
        && profileValid(data.profile)
        && preferencesValid(data.preferences)
        && subscriptionValid(data.subscription)
        && metadataValid(data.metadata)
        && (!('attribution' in data) || attributionValid(data.attribution));
    }

    function profilePhotoUpdateValid(before, after) {
      let changed = after.diff(before).affectedKeys();
      return (!changed.hasAny(['photoVersion']) || changed.hasAny(['photoURL']))
        && (!changed.hasAny(['photoURL'])
             || (changed.hasAny(['photoVersion']) && after.photoVersion == request.time));
    }

    // One-time, complete conversion of the former flat document. Every
    // backend-owned value must be preserved exactly; after conversion the
    // regular nested update rule applies and this branch becomes unreachable.
    function legacyMigrationValid() {
      let before = resource.data;
      let after = request.resource.data;
      return !('profile' in before)
        && nestedUserValid(after)
        && before.get('role', 'user') == 'user'
        && after.profile.name == before.name
        && after.profile.email == before.email
        && after.profile.get('birthDate', null) == before.get('birthDate', null)
        && after.profile.get('photoURL', null) == before.get('photoURL', null)
        && after.preferences.language == before.get('language', 'pt-BR')
        && after.preferences.units == 'system'
        && after.preferences.theme == 'dark'
        && after.subscription.get('status', null) == before.get('subscriptionStatus', null)
        && after.subscription.get('provider', null) == before.get('subscriptionProvider', null)
        && after.subscription.get('trialEndsAt', null) == before.get('trialEndsAt', null)
        // Campo renomeado `endsAt` → `currentPeriodEndsAt` na Sprint 3.5 para
        // casar com docs/13 §26; o nome plano ANTIGO (`subscriptionEndsAt`)
        // não muda — é uma leitura única do documento legado, não parte do
        // schema novo.
        && after.subscription.get('currentPeriodEndsAt', null) == before.get('subscriptionEndsAt', null)
        && after.metadata.role == before.get('role', 'user')
        && after.metadata.get('activeWorkoutId', null) == before.get('activeWorkoutId', null)
        && after.metadata.createdAt == before.createdAt
        && after.metadata.updatedAt == request.time;
    }

    // Avaliações físicas (docs/03 §4/§8, docs/15 §10/§11/§18). `source` é um
    // discriminador: guided exige os campos da calculadora (protocol, sex,
    // age, folds, bodyFat, calculatorVersion); imported não exige nenhum
    // deles e pode não ter bodyFat (campo simplesmente ausente — nunca 0).
    // Campos derivados (bmi, leanMass, fatMass, sumFolds, bodyDensity) e o
    // rótulo do protocolo nunca são aceitos: são resolvidos em tempo de
    // leitura no app (src/lib/skinfoldCalculator.ts), nunca persistidos.
    function assessmentCommonValid() {
      let d = request.resource.data;
      return d.source in ['guided', 'imported']
        && d.measuredAt is timestamp
        && d.measuredAt <= request.time
        // `== request.time` (not just `is timestamp`) forces the client to
        // have actually used serverTimestamp() — a client can't fabricate an
        // arbitrary createdAt to game the measuredAt/createdAt tie-break sort.
        && d.createdAt == request.time
        && d.weight is number && d.weight > 0
        && d.height is number && d.height > 0
        && (!('notes' in d) || d.notes is string);
    }

    function guidedAssessmentValid() {
      let d = request.resource.data;
      return d.source == 'guided'
        && d.keys().hasOnly([
             'source', 'measuredAt', 'createdAt', 'weight', 'height', 'bodyFat',
             'calculatorVersion', 'notes', 'protocol', 'sex', 'age', 'folds'
           ])
        && d.calculatorVersion == 1
        && d.protocol in ['jp3', 'jp7']
        && d.sex in ['m', 'f']
        && d.age is number && d.age > 0
        && d.bodyFat is number && d.bodyFat > 0
        && d.folds is map && d.folds.size() > 0;
    }

    function importedAssessmentValid() {
      let d = request.resource.data;
      return d.source == 'imported'
        && d.keys().hasOnly([
             'source', 'measuredAt', 'createdAt', 'weight', 'height', 'bodyFat',
             'notes', 'bodyWater', 'basalMetabolism', 'visceralFat'
           ])
        && (!('bodyFat' in d) || (d.bodyFat is number && d.bodyFat > 0))
        && (!('bodyWater' in d) || (d.bodyWater is number && d.bodyWater > 0))
        && (!('basalMetabolism' in d) || (d.basalMetabolism is number && d.basalMetabolism > 0))
        && (!('visceralFat' in d) || (d.visceralFat is number && d.visceralFat > 0));
    }

    // ── Photo Vault (docs/20_backend_functions_photo_vault.md) ────────────
    // Metadados das fotos privadas. A imagem NUNCA é gravada aqui: o binário
    // vive criptografado no Storage e este documento guarda apenas o ponteiro
    // e os parâmetros criptográficos necessários para decifrar. Não existe
    // downloadURL nem signed URL persistida — o caminho é resolvido pelo SDK
    // a partir de `storagePath`, sempre sujeito às Storage Rules.
    function encryptionMetadataValid(e) {
      return e is map
        && e.keys().hasAll(['version', 'algorithm', 'iv', 'vaultKeyVersion'])
        && e.keys().hasOnly(['version', 'algorithm', 'iv', 'vaultKeyVersion'])
        && e.version is int && e.version >= 1
        && e.algorithm == 'AES-256-GCM'
        // IV/nonce em base64. Não é segredo (é público por design no GCM),
        // mas precisa ser único por foto — a unicidade é responsabilidade do
        // cliente, as regras só garantem forma e tamanho plausíveis.
        && e.iv is string && e.iv.size() >= 16 && e.iv.size() <= 32
        && e.vaultKeyVersion is int && e.vaultKeyVersion >= 1;
    }

    // Caminho canônico de um objeto do Vault. `assetKey` identifica o ARQUIVO,
    // que nem sempre é o id do documento — ver as três formas abaixo.
    // Igualdade exata de string (não regex): prende o metadado a um único
    // objeto do Storage, no namespace do próprio dono. Impede apontar para o
    // arquivo de outro uid.
    function vaultAssetPath(userId, assetKey, suffix) {
      return 'users/' + userId + '/progressPhotos/' + assetKey + suffix;
    }

    function thumbnailFieldsValid(userId, assetKey) {
      let d = request.resource.data;
      return d.thumbnailStoragePath == vaultAssetPath(userId, assetKey, '.thumb.enc')
        && d.thumbnailEncryptedSize is int
        && d.thumbnailEncryptedSize > 0
        && d.thumbnailEncryptedSize <= 512 * 1024
        && encryptionMetadataValid(d.thumbnailEncryption)
        // Same Vault Key is intentional; nonce reuse under AES-GCM is not.
        && d.thumbnailEncryption.iv != d.encryption.iv;
    }

    function twoDigits(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }

    // Último dia de calendário que um cliente pode reivindicar.
    //
    // Um dia de folga cobre quem está num fuso à frente do UTC (até +14), já
    // que `dateKey` é o dia LOCAL do usuário e as regras não têm como conhecer
    // esse fuso. Como `YYYY-MM-DD` é zero-padded, a comparação lexicográfica
    // equivale à cronológica.
    //
    // Deliberadamente NÃO existe limite inferior: `takenAt` pode vir do EXIF,
    // então uma foto escolhida da galeria legitimamente pertence a qualquer dia
    // passado. Uma janela simétrica rejeitaria upload legítimo de foto antiga.
    function maxDateKey() {
      let bound = request.time + duration.value(1, 'd');
      return string(bound.year())
        + '-' + twoDigits(bound.month())
        + '-' + twoDigits(bound.day());
    }

    // Mesmo formato de UUID já aplicado pelo backend em
    // functions/src/photoVault/orphanPolicy.ts. As Rules não importam código,
    // então o padrão é espelhado de propósito; manter os dois em sincronia.
    function isVaultUuid(value) {
      return value is string
        && value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function progressPhotoValid(userId, photoId) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'storagePath', 'createdAt', 'takenAt', 'originalMimeType',
          'encryptedSize', 'encryption'
        ])
        // Três formas coexistem e NENHUMA é migrada:
        //
        //   A) legacy  — seis campos, sem thumbnail; documento nomeado pelo
        //                próprio asset;
        //   B) fase 13 — acrescenta os três campos de thumbnail atomicamente;
        //                documento ainda nomeado pelo asset;
        //   C) pose    — acrescenta assetId/dateKey/pose. O documento passa a
        //                se chamar `{dateKey}_{pose}`, de modo que o próprio
        //                Firestore garante no máximo uma foto por pose por dia
        //                (create só dispara em documento inexistente, e update
        //                está proibido). O ARQUIVO continua identificado por
        //                UUID opaco em `assetId`, para não vazar dia/pose nos
        //                nomes de objeto do Storage.
        //
        // As formas são mutuamente exclusivas por construção: cada `hasOnly`
        // rejeita os campos exclusivos das outras. Metadata parcial de
        // thumbnail e campos desconhecidos seguem rejeitados.
        && (
          (
            d.keys().hasOnly([
              'storagePath', 'createdAt', 'takenAt', 'originalMimeType',
              'encryptedSize', 'encryption'
            ])
            && d.storagePath == vaultAssetPath(userId, photoId, '.enc')
          )
          || (
            d.keys().hasAll([
              'thumbnailStoragePath', 'thumbnailEncryptedSize',
              'thumbnailEncryption'
            ])
            && d.keys().hasOnly([
              'storagePath', 'thumbnailStoragePath', 'createdAt', 'takenAt',
              'originalMimeType', 'encryptedSize', 'thumbnailEncryptedSize',
              'encryption', 'thumbnailEncryption'
            ])
            && d.storagePath == vaultAssetPath(userId, photoId, '.enc')
            && thumbnailFieldsValid(userId, photoId)
          )
          || (
            d.keys().hasAll([
              'thumbnailStoragePath', 'thumbnailEncryptedSize',
              'thumbnailEncryption', 'assetId', 'dateKey', 'pose'
            ])
            && d.keys().hasOnly([
              'storagePath', 'thumbnailStoragePath', 'assetId', 'dateKey', 'pose',
              'createdAt', 'takenAt', 'originalMimeType', 'encryptedSize',
              'thumbnailEncryptedSize', 'encryption', 'thumbnailEncryption'
            ])
            && isVaultUuid(d.assetId)
            // Enum fechado. Fotos antigas NÃO recebem pose: a ausência do
            // campo é o que identifica um registro pré-pose, então não existe
            // um quarto valor "unknown" persistido.
            && d.pose in ['front', 'side', 'back']
            && d.dateKey is string
            && d.dateKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && d.dateKey <= maxDateKey()
            // O id do documento É a chave de unicidade (dia + pose).
            && photoId == d.dateKey + '_' + d.pose
            // O arquivo é endereçado pelo assetId, não pelo id do documento.
            && d.storagePath == vaultAssetPath(userId, d.assetId, '.enc')
            && thumbnailFieldsValid(userId, d.assetId)
          )
        )
        // `== request.time` (e não apenas `is timestamp`) força o uso de
        // serverTimestamp() — o cliente não forja a data de criação.
        && d.createdAt == request.time
        // Sem piso: uma foto da galeria pode ser antiga por definição.
        && d.takenAt is timestamp
        && d.takenAt <= request.time
        && d.originalMimeType in ['image/jpeg', 'image/png', 'image/heic', 'image/heif', 'image/webp']
        && d.encryptedSize is int
        && d.encryptedSize > 0
        && d.encryptedSize <= 10 * 1024 * 1024
        && encryptionMetadataValid(d.encryption);
    }

    function supportTicketValid(ticketId) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'id', 'userId', 'userName', 'userEmail', 'type', 'subject', 'status',
          'priority', 'lastMessage', 'createdAt', 'updatedAt', 'appVersion',
          'platform', 'osVersion', 'deviceModel', 'language', 'attachmentsCount'
        ])
        && d.keys().hasOnly([
          'id', 'userId', 'userName', 'userEmail', 'type', 'subject', 'status',
          'priority', 'lastMessage', 'createdAt', 'updatedAt', 'appVersion',
          'platform', 'osVersion', 'deviceModel', 'language', 'attachmentsCount'
        ])
        && d.id == ticketId
        && d.userId == request.auth.uid
        && d.userName is string && d.userName.size() >= 2 && d.userName.size() <= 50
        && d.userEmail is string && d.userEmail.size() <= 254
        && d.type in ['BUG', 'FEEDBACK', 'SUPPORT']
        && d.subject is string && d.subject.size() >= 3 && d.subject.size() <= 100
        && d.status == 'OPEN'
        && d.priority == 'NORMAL'
        && d.lastMessage is string && d.lastMessage.size() >= 10 && d.lastMessage.size() <= 5000
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.appVersion is string && d.platform in ['ios', 'android', 'web', 'windows', 'macos']
        && d.osVersion is string && d.deviceModel is string && d.language is string
        && d.attachmentsCount is int && d.attachmentsCount >= 0 && d.attachmentsCount <= 1;
    }

    function supportMessageValid(ticketId) {
      let d = request.resource.data;
      let ticket = getAfter(/databases/$(database)/documents/supportTickets/$(ticketId));
      return ticket.data.userId == request.auth.uid
        && d.keys().hasAll(['senderType', 'senderId', 'message', 'attachments', 'createdAt', 'readAt'])
        && d.keys().hasOnly(['senderType', 'senderId', 'message', 'attachments', 'createdAt', 'readAt'])
        && d.senderType == 'USER' && d.senderId == request.auth.uid
        && d.message is string && d.message.size() >= 1 && d.message.size() <= 5000
        && d.attachments is list && d.attachments.size() <= 1
        && ticket.data.attachmentsCount == d.attachments.size()
        && (d.attachments.size() == 0 || (
          d.attachments[0] is map
          && d.attachments[0].keys().hasAll(['url', 'path', 'type'])
          && d.attachments[0].keys().hasOnly(['url', 'path', 'type'])
          && d.attachments[0].url is string && d.attachments[0].url.size() <= 2048
          && d.attachments[0].path is string
          && d.attachments[0].path.matches('users/' + request.auth.uid + '/support/' + ticketId + '/attachments/.*')
          && d.attachments[0].type == 'IMAGE'
        ))
        && d.createdAt == request.time && d.readAt == null;
    }

    function adminSupportTicketUpdateValid() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasAll(['updatedAt'])
        && changed.hasOnly([
          'status', 'priority', 'assignedTo', 'lastMessage', 'updatedAt',
          'lastReplyAt', 'closedAt'
        ])
        && after.status in ['OPEN', 'IN_PROGRESS', 'WAITING_USER', 'RESOLVED', 'CLOSED']
        && after.priority in ['LOW', 'NORMAL', 'HIGH', 'CRITICAL']
        && after.updatedAt == request.time
        // O painel atual atribui somente ao próprio operador autenticado.
        && (!changed.hasAny(['assignedTo']) || after.assignedTo == request.auth.uid)
        // Fechar grava o timestamp do servidor; qualquer outro status limpa-o.
        && (!changed.hasAny(['status']) || (
          changed.hasAny(['closedAt'])
          && (after.status == 'CLOSED'
              ? after.closedAt == request.time
              : after.closedAt == null)
        ))
        && (!changed.hasAny(['closedAt']) || changed.hasAny(['status']))
        // Uma resposta atualiza preview e metadados em conjunto.
        && (!changed.hasAny(['lastMessage', 'lastReplyAt']) || (
          changed.hasAll(['lastMessage', 'lastReplyAt'])
          && after.lastMessage is string
          && after.lastMessage.size() >= 1
          && after.lastMessage.size() <= 5000
          && after.lastReplyAt == request.time
        ));
    }

    function adminSupportMessageValid(ticketId) {
      let d = request.resource.data;
      let ticket = getAfter(/databases/$(database)/documents/supportTickets/$(ticketId));
      return d.keys().hasAll([
          'senderType', 'senderId', 'message', 'attachments', 'createdAt', 'readAt'
        ])
        && d.keys().hasOnly([
          'senderType', 'senderId', 'message', 'attachments', 'createdAt', 'readAt'
        ])
        && d.senderType == 'ADMIN'
        && d.senderId == request.auth.uid
        && d.message is string && d.message.size() >= 1 && d.message.size() <= 5000
        && d.attachments is list && d.attachments.size() == 0
        && d.createdAt == request.time && d.readAt == null
        // Mantém mensagem e preview do ticket consistentes no mesmo batch.
        && ticket.data.lastMessage == d.message
        && ticket.data.updatedAt == request.time
        && ticket.data.lastReplyAt == request.time;
    }

    // ── Users, questionnaires and assessments ─────────────────────────────
    match /users/{userId} {
      // Leitura: apenas o dono do documento, e somente com a conta ativa
      // (Fase 5 — ver `accountActive` acima).
      allow read: if isOwner(userId) && accountActive(userId);

      // Criação: documento integralmente aninhado, com identidade coerente com
      // o token e sem campos de assinatura/internos definidos pelo cliente.
      // `attribution` nunca pode ser definido pelo cliente na criação —
      // `nestedUserValid` sozinho não bastaria aqui, porque ele aceita a
      // AUSÊNCIA do campo, não a proíbe: sem esta checagem extra, um cliente
      // malicioso poderia fabricar um `attribution` (com formato válido,
      // porém com um couponCode/influencerId arbitrário) no momento da
      // criação da conta, antes de qualquer validação server-side via
      // `validatePromoCode`.
      // Fase 5: também exige `accountActive(userId)` — sem isso, um token
      // ainda válido poderia RECRIAR o documento depois que
      // FIRESTORE_CLEANUP já o removeu, ressuscitando dados de perfil no
      // meio (ou depois) de uma exclusão em andamento.
      allow create: if isOwner(userId)
        && accountActive(userId)
        && nestedUserValid(request.resource.data)
        && !('attribution' in request.resource.data)
        && request.resource.data.metadata.role == 'user'
        && request.resource.data.profile.email == request.auth.token.email
        && request.resource.data.subscription.size() == 0
        && !('activeWorkoutId' in request.resource.data.metadata)
        && request.resource.data.metadata.createdAt == request.time
        && request.resource.data.metadata.updatedAt == request.time
        // Only `null` (pending) is ever client-writable — a client cannot
        // fabricate an already-resolved timestamp to skip its own initial
        // Paywall. Omitting the key entirely is also rejected here (unlike
        // `metadataValid`'s general tolerance for absence, which exists for
        // documents written before this field existed) — every document
        // `provisionNewUser` creates from now on writes it explicitly.
        && request.resource.data.metadata.commercialGateResolvedAt == null;

      // Atualização: apenas o dono e somente os campos editáveis do perfil.
      // `diff().affectedKeys().hasOnly` impede alterações em campos de conta,
      // assinatura, treino ou privilégios mesmo que novos campos sejam
      // adicionados ao documento no futuro.
      //
      // `preferences` é aceito no conjunto top-level mudável, mas dentro dele
      // apenas `preferences.language` e `preferences.units` podem variar;
      // `theme` segue protegido. Escritas legítimas usam caminhos pontuados,
      // preservando todas as preferências irmãs.
      allow update: if isVerifiedOwner(userId) && accountActive(userId) && (
        legacyMigrationValid()
        || (
          nestedUserValid(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['profile', 'preferences', 'metadata'])
          && request.resource.data.profile.diff(resource.data.profile).affectedKeys()
               .hasOnly(['name', 'birthDate', 'photoURL', 'photoVersion', 'height'])
          && profilePhotoUpdateValid(resource.data.profile, request.resource.data.profile)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['preferences'])
            || request.resource.data.preferences.diff(resource.data.preferences).affectedKeys()
                 .hasOnly(['language', 'units'])
          )
          && request.resource.data.metadata.updatedAt == request.time
          && request.resource.data.metadata.diff(resource.data.metadata).affectedKeys()
               .hasOnly(['updatedAt'])
        )
      );

      // Exclusão: negada ao cliente (remoção é processo de backend — 90 dias,
      // docs/12 §10). Somente o Admin SDK pode excluir.
      allow delete: if false;

      // Questionários do usuário (inicial + reavaliações futuras).
      // Cada documento é um snapshot imutável.
      match /questionnaires/{questionnaireId} {
        // Leitura: apenas o dono do usuário pai, com a conta ativa (Fase 5).
        allow read: if isOwner(userId) && accountActive(userId);

        // Criação: apenas o dono, com os campos esperados e válidos.
        allow create: if isOwner(userId)
          && accountActive(userId)
          && (hasVerifiedEmailForPrivateAccess()
              || (!exists(/databases/$(database)/documents/users/$(userId))
                  && getAfter(/databases/$(database)/documents/users/$(userId)).data.profile.email
                       == request.auth.token.email))
          && request.resource.data.keys().hasOnly(
               ['answers', 'version', 'createdAt'])
          && request.resource.data.answers is map
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.createdAt is timestamp;

        // Histórico imutável: sem edição nem exclusão pelo cliente.
        allow update, delete: if false;
      }

      match /workoutPrograms/{programId} {
        allow read: if isOwner(userId) && accountActive(userId);

        allow create: if isOwner(userId)
          && accountActive(userId)
          && workoutProgramCommonValid(userId, programId, request.resource.data)
          // Transitional rollout compatibility: the already-published app
          // may omit both fields; the new app always sends both, and any
          // supplied identity is required to equal the active dataset.
          && workoutProgramLimitationDatasetValid(request.resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.activatedAt == request.time
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutProgramState/active).data.programId == programId;

        allow update: if isOwner(userId)
          && accountActive(userId)
          && (workoutProgramCommonValid(userId, programId, request.resource.data)
              // A v1.3 snapshot may need to be superseded after the single
              // template document has been upgraded to v2. Its immutable
              // prescription fields are protected by the diff below; do not
              // revalidate them against today's replaced template document.
              || resource.data.versions.templateLibrary == '1.3.0')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'activatedAt', 'updatedAt'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.status == 'active'
              && request.resource.data.activatedAt == request.time
              && getAfter(/databases/$(database)/documents/users/$(userId)/workoutProgramState/active).data.programId == programId)
            ||
            (request.resource.data.status == 'superseded'
              && request.resource.data.activatedAt == resource.data.activatedAt
              && getAfter(/databases/$(database)/documents/users/$(userId)/workoutProgramState/active).data.programId != programId)
          );

        allow delete: if false;

        // Runtime schedule cursor for THIS program only — never carried over
        // to a new program (docs/workout-lifecycle/03_SCHEDULE_ENGINE.md
        // §Troca de programa). Single fixed id 'current', same pattern as
        // workoutProgramState/active above.
        match /scheduleState/{stateId} {
          allow read: if isOwner(userId) && accountActive(userId) && stateId == 'current';
          allow create, update: if isOwner(userId)
            && accountActive(userId)
            && stateId == 'current'
            && request.resource.data.keys().hasAll(
                 ['programId', 'nextSessionIndex', 'cursorDate', 'lastCompletedAt', 'pendingMissDecision', 'updatedAt'])
            && request.resource.data.keys().hasOnly(
                 ['programId', 'nextSessionIndex', 'cursorDate', 'lastCompletedAt', 'pendingMissDecision', 'updatedAt'])
            && request.resource.data.programId == programId
            && request.resource.data.nextSessionIndex is int
            && request.resource.data.nextSessionIndex >= 0
            && request.resource.data.cursorDate is string
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }

        // Immutable schedule ledger (COMPLETED/SKIPPED/MISS_RESOLVED) — never
        // edited or deleted by the client (docs §44 Event ledger, §48
        // Imutabilidade). Client-authorized like the rest of this program:
        // ownership is the path, not a payload field.
        match /scheduleEvents/{eventId} {
          allow read: if isOwner(userId) && accountActive(userId);
          allow create: if isOwner(userId)
            && accountActive(userId)
            && request.resource.data.keys().hasAll(['type', 'sessionIndex', 'scheduledDate', 'occurredAt'])
            && request.resource.data.keys().hasOnly(
                 ['type', 'sessionIndex', 'scheduledDate', 'occurredAt', 'reasonCode', 'decision'])
            && request.resource.data.type in ['COMPLETED', 'SKIPPED', 'MISS_RESOLVED']
            && request.resource.data.sessionIndex is int
            && request.resource.data.sessionIndex >= 0
            && request.resource.data.scheduledDate is string
            && request.resource.data.occurredAt == request.time;
          allow update, delete: if false;
        }

        // Progression Engine V1 (docs/workout-lifecycle/
        // 04_PROGRESSION_ENGINE.md). Immutable audit ledger of transitions
        // AWAY FROM this program — nested under the FROM program so it
        // survives being superseded. `toProgramId` may equal this same
        // `programId` for a NORMAL_ROTATION renewal-in-place (no real
        // template alternative exists — docs §40/§41).
        match /progressionEvents/{eventId} {
          allow read: if isOwner(userId) && accountActive(userId);
          allow create: if isOwner(userId)
            && accountActive(userId)
            && request.resource.data.keys().hasAll(
                 ['type', 'toProgramId', 'fromStage', 'toStage', 'reason', 'occurredAt', 'progressionEngineVersion'])
            && request.resource.data.keys().hasOnly(
                 ['type', 'toProgramId', 'fromStage', 'toStage', 'reason', 'occurredAt', 'progressionEngineVersion'])
            && request.resource.data.type in ['BEGINNER_STAGE_TRANSITION', 'NORMAL_ROTATION']
            && request.resource.data.toProgramId is string
            && (request.resource.data.fromStage == null || request.resource.data.fromStage in [1, 2, 3])
            && (request.resource.data.toStage == null || request.resource.data.toStage in [1, 2, 3])
            && request.resource.data.reason is string
            && request.resource.data.occurredAt == request.time
            && request.resource.data.progressionEngineVersion is int
            && request.resource.data.progressionEngineVersion >= 1;
          allow update, delete: if false;
        }
      }

      // Single fixed-id pointer document; direct lookup, no status query or
      // composite index. It moves atomically with program lifecycle writes.
      // `scheduleConfig` is a second fixed id in this same collection: the
      // Schedule Engine's trainingDays/timezone preference. It is a *user*
      // preference, not program-scoped (docs/workout-lifecycle/
      // 03_SCHEDULE_ENGINE.md §Alteração dos dias) — it survives program
      // regeneration, unlike `scheduleState` below.
      match /workoutProgramState/{stateId} {
        allow read: if isOwner(userId) && accountActive(userId)
          && (stateId == 'active' || stateId == 'scheduleConfig');
        allow create: if isOwner(userId)
          && accountActive(userId)
          && stateId == 'active'
          && request.resource.data.keys().hasAll(['programId', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['programId', 'updatedAt'])
          && request.resource.data.programId is string
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutPrograms/$(request.resource.data.programId)).data.status == 'active';
        allow update: if isOwner(userId)
          && accountActive(userId)
          && stateId == 'active'
          && request.resource.data.keys().hasAll(['programId', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['programId', 'updatedAt'])
          && request.resource.data.programId is string
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutPrograms/$(request.resource.data.programId)).data.status == 'active'
          && (resource.data.programId == request.resource.data.programId
              || getAfter(/databases/$(database)/documents/users/$(userId)/workoutPrograms/$(resource.data.programId)).data.status == 'superseded');
        allow create, update: if isOwner(userId)
          && accountActive(userId)
          && stateId == 'scheduleConfig'
          && request.resource.data.keys().hasAll(['trainingDays', 'timezone', 'scheduleVersion', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['trainingDays', 'timezone', 'scheduleVersion', 'updatedAt'])
          && request.resource.data.trainingDays is list
          && request.resource.data.trainingDays.size() >= 2
          && request.resource.data.trainingDays.size() <= 7
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() > 0
          && request.resource.data.scheduleVersion is int
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // Workout Execution & History V1 (docs/workout-lifecycle/
      // 09_WORKOUT_EXECUTION_AND_HISTORY.md). Top-level per-user collection
      // (not nested under workoutPrograms/{programId}) so history queries
      // ("last N workouts") never require scanning every program a user has
      // ever had, and so account-deletion cleanup can delete it the same
      // one-level way as `workoutPrograms` (docs §47/§48).
      //
      // Mutable only while IN_PROGRESS or ABANDONED (an abandoned attempt can
      // be restarted fresh); once COMPLETED/PARTIALLY_COMPLETED it is
      // immutable history, same as a schedule event (docs §53).
      match /workoutExecutions/{executionId} {
        allow read: if isOwner(userId) && accountActive(userId);

        allow create: if isOwner(userId)
          && accountActive(userId)
          && workoutExecutionCommonValid(userId, request.resource.data)
          && request.resource.data.status == 'IN_PROGRESS'
          && request.resource.data.finishedAt == null
          && request.resource.data.startedAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(userId)
          && accountActive(userId)
          && workoutExecutionCommonValid(userId, request.resource.data)
          && resource.data.status in ['IN_PROGRESS', 'ABANDONED']
          && request.resource.data.programId == resource.data.programId
          && request.resource.data.sessionIndex == resource.data.sessionIndex
          && request.resource.data.scheduledLocalDate == resource.data.scheduledLocalDate
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (
            (request.resource.data.status == 'IN_PROGRESS' && request.resource.data.finishedAt == null)
            || (request.resource.data.status in ['COMPLETED', 'PARTIALLY_COMPLETED', 'ABANDONED']
                && request.resource.data.finishedAt == request.time)
          );

        allow delete: if false;
      }

      // Avaliações físicas do usuário (guiadas ou importadas). Cada documento
      // é um snapshot imutável — nunca sobrescrever ou apagar (docs/15 §11).
      //
      // Autorização é ownership puro: o app inteiro é pago, então não há
      // checagem de assinatura por ação aqui (ver o comentário no topo deste
      // arquivo). UPDATE/DELETE permanecem `if false` para todos.
      match /assessments/{assessmentId} {
        // Fase 5: leitura/criação também exigem accountActive(userId).
        allow read: if isVerifiedOwner(userId) && accountActive(userId);

        allow create: if isVerifiedOwner(userId)
          && accountActive(userId)
          && assessmentCommonValid()
          && (guidedAssessmentValid() || importedAssessmentValid());

        allow update, delete: if false;
      }

      // Metadados das fotos privadas de evolução (Photo Vault). O dono lê,
      // cria e exclui; o documento é imutável após a criação — trocar uma
      // foto significa excluir o par (documento + objeto no Storage) e criar
      // um novo photoId, o que mantém a auditoria simples e sem ambiguidade.
      //
      // Autorização é ownership puro, pelo mesmo motivo das avaliações acima.
      match /progressPhotos/{photoId} {
        // Fase 5: leitura/criação/exclusão também exigem accountActive(userId).
        allow read: if isVerifiedOwner(userId) && accountActive(userId);
        allow create: if isVerifiedOwner(userId) && accountActive(userId) && progressPhotoValid(userId, photoId);
        allow update: if false;
        allow delete: if isVerifiedOwner(userId) && accountActive(userId);
      }

      // Material criptográfico do Photo Vault (wrappedVaultKey e versões).
      // Backend-only: escrito e lido exclusivamente pelo Admin SDK, que
      // ignora estas regras. O cliente nunca precisa da chave embrulhada —
      // ele recebe a Vault Key já desembrulhada pela Function autenticada e
      // a guarda localmente no SecureStore. Negar leitura ao cliente remove
      // a chave embrulhada da superfície de ataque do app por completo.
      //
      // Consequência: o schema deste documento NÃO é validável por estas
      // regras (o Admin SDK as ignora). O contrato fechado e versionado vive
      // em functions/src/photoVault/schema.ts, onde é de fato aplicado.
      match /privateSecurity/{documentId} {
        allow read, write: if false;
      }
    }

    // ── Support tickets and messages ──────────────────────────────────────
    match /supportTickets/{ticketId} {
      allow get, list: if isAdmin()
        || (hasVerifiedEmailForPrivateAccess() && resource.data.userId == request.auth.uid);
      allow create: if hasVerifiedEmailForPrivateAccess() && supportTicketValid(ticketId);
      allow update: if isAdmin() && adminSupportTicketUpdateValid();
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isAdmin()
          || (hasVerifiedEmailForPrivateAccess()
              && get(/databases/$(database)/documents/supportTickets/$(ticketId))
                   .data.userId == request.auth.uid);
        allow create: if (hasVerifiedEmailForPrivateAccess() && supportMessageValid(ticketId))
          || (isAdmin() && adminSupportMessageValid(ticketId));
        allow update, delete: if false;
      }
    }

    // Catálogo de códigos promocionais/influenciadores
    // (functions/src/attribution/{constants,types,promoCodeCatalog}.ts).
    // Nunca lido nem escrito pelo cliente — a validação server-side
    // (`validatePromoCode`, onCall) faz o único `get()` direto por ID
    // normalizado, via Admin SDK, que ignora estas regras. Bloco explícito
    // (redundante com o catch-all abaixo, que já negaria por padrão) para
    // documentar a intenção: nenhuma exceção de leitura deve ser adicionada
    // aqui, nem mesmo para o dono de um documento — não existe "dono" para
    // um código promocional.
    match /promoCodes/{code} {
      allow read, write: if false;
    }

    // Registro server-managed do ciclo de vida da atribuição de um uid a um
    // código promocional (functions/src/attribution/{constants,types,
    // attributionSync}.ts) — `couponRedemptions/{uid}`. Fonte de verdade;
    // `users/{uid}.attribution` é apenas o espelho de leitura. Escrito
    // exclusivamente por `applyPromoCodeAttributionTransactionally` via
    // Admin SDK. Bloco explícito pelo mesmo motivo do `promoCodes` acima.
    match /couponRedemptions/{uid} {
      allow read, write: if false;
    }

    // Immutable financial ledger written only by the verified RevenueCat webhook through Admin SDK.
    match /subscriptionTransactions/{transactionId} {
      allow read, write: if false;
    }

    // Fase 4/5 account-deletion workflow state
    // (functions/src/accountDeletion/{repository,activeAccountGuard}.ts).
    // Backend-only in both directions: the client never creates, reads, or
    // polls its own deletion record/lock through Firestore directly — a
    // future status-check UI would need its OWN minimal, explicit callable
    // contract (not implemented yet), never a direct read of these paths.
    // `accountActive()` above reads `accountDeletionLocks/{userId}` via
    // `exists()`, which does not require (and is unaffected by) an `allow
    // read` rule here — these blocks exist to make the deny explicit and
    // documented, matching `promoCodes`/`couponRedemptions` above, not to
    // enable the `exists()` check.
    match /accountDeletionLocks/{uid} {
      allow read, write: if false;
    }
    match /accountDeletions/{deletionId} {
      allow read, write: if false;

      match /{subcollection=**} {
        allow read, write: if false;
      }
    }

    // ── Biblioteca oficial de exercícios (docs/27_biblioteca_de_exercicios.md) ─
    // Conteúdo administrado: o script `scripts/seedExercises.ts` (Admin SDK,
    // ignora estas regras) e, a partir do painel `ajfit-admin`, um admin
    // autenticado (`isAdmin()` — mesmo mecanismo já usado por
    // `supportTickets` acima: `users/{uid}.metadata.role == 'admin'`).
    // Leitura liberada para qualquer usuário autenticado; a lista em si não
    // é dado sensível e é necessária para exibir/gerar treinos e permitir
    // substituição de exercícios.
    //
    function limitationExerciseIdValid(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 120
        && value.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    // Firestore Rules não possui loops. O limite fechado de 10 mantém a
    // validação integral dos IDs, ordem e unicidade sem extrapolar o tamanho
    // razoável de uma lista de candidatos do protocolo V1.
    function limitationExerciseIdListValid(ids, exerciseId) {
      return ids is list
        && ids.size() <= 10
        && ids.toSet().size() == ids.size()
        && (ids.size() < 1 || (limitationExerciseIdValid(ids[0]) && ids[0] != exerciseId))
        && (ids.size() < 2 || (limitationExerciseIdValid(ids[1]) && ids[1] != exerciseId))
        && (ids.size() < 3 || (limitationExerciseIdValid(ids[2]) && ids[2] != exerciseId))
        && (ids.size() < 4 || (limitationExerciseIdValid(ids[3]) && ids[3] != exerciseId))
        && (ids.size() < 5 || (limitationExerciseIdValid(ids[4]) && ids[4] != exerciseId))
        && (ids.size() < 6 || (limitationExerciseIdValid(ids[5]) && ids[5] != exerciseId))
        && (ids.size() < 7 || (limitationExerciseIdValid(ids[6]) && ids[6] != exerciseId))
        && (ids.size() < 8 || (limitationExerciseIdValid(ids[7]) && ids[7] != exerciseId))
        && (ids.size() < 9 || (limitationExerciseIdValid(ids[8]) && ids[8] != exerciseId))
        && (ids.size() < 10 || (limitationExerciseIdValid(ids[9]) && ids[9] != exerciseId));
    }

    function limitationRuleValid(rule, exerciseId) {
      return rule is map
        && (
          (
            rule.keys().hasOnly(['status'])
            && rule.status in ['compatible', 'not_applicable']
          )
          || (
            rule.keys().hasAll(['status', 'adaptation'])
            && rule.keys().hasOnly(['status', 'adaptation'])
            && rule.status == 'adapt'
            && rule.adaptation is map
            && rule.adaptation.keys().hasAll(['kind', 'exerciseId'])
            && rule.adaptation.keys().hasOnly(['kind', 'exerciseId'])
            && rule.adaptation.kind == 'exercise_variant'
            && limitationExerciseIdValid(rule.adaptation.exerciseId)
            && rule.adaptation.exerciseId != exerciseId
          )
          || (
            rule.keys().hasAll(['status', 'substituteExerciseIds', 'candidateStatus'])
            && rule.keys().hasOnly(['status', 'substituteExerciseIds', 'candidateStatus'])
            && rule.status == 'avoid'
            && limitationExerciseIdListValid(rule.substituteExerciseIds, exerciseId)
            && (
              (rule.substituteExerciseIds.size() == 0
                && rule.candidateStatus == 'missing_exercise_candidate')
              || (rule.substituteExerciseIds.size() > 0
                && rule.candidateStatus == 'ready')
            )
          )
        );
    }

    function limitationRegionsValid(regions, exerciseId) {
      return regions is map
        && regions.keys().hasAll([
             'knee', 'hip', 'back', 'shoulder', 'elbow', 'wrist', 'ankle_foot'
           ])
        && regions.keys().hasOnly([
             'knee', 'hip', 'back', 'shoulder', 'elbow', 'wrist', 'ankle_foot'
           ])
        && limitationRuleValid(regions.knee, exerciseId)
        && limitationRuleValid(regions.hip, exerciseId)
        && limitationRuleValid(regions.back, exerciseId)
        && limitationRuleValid(regions.shoulder, exerciseId)
        && limitationRuleValid(regions.elbow, exerciseId)
        && limitationRuleValid(regions.wrist, exerciseId)
        && limitationRuleValid(regions.ankle_foot, exerciseId);
    }

    function limitationProfileValid(profile, exerciseId) {
      return profile is map
        && profile.schemaVersion == 1
        && profile.protocolVersion == 'musculoskeletal-v1'
        && profile.reviewStatus == 'approved'
        && limitationRegionsValid(profile.regions, exerciseId)
        && (
          (
            profile.keys().hasAll([
              'schemaVersion', 'protocolVersion', 'reviewStatus', 'reviewBasis', 'regions'
            ])
            && profile.keys().hasOnly([
              'schemaVersion', 'protocolVersion', 'reviewStatus', 'reviewBasis', 'regions'
            ])
            && profile.reviewBasis == 'product_policy'
          )
          || (
            profile.keys().hasAll([
              'schemaVersion', 'protocolVersion', 'reviewStatus', 'reviewBasis',
              'regions', 'reviewedAt', 'reviewedBy'
            ])
            && profile.keys().hasOnly([
              'schemaVersion', 'protocolVersion', 'reviewStatus', 'reviewBasis',
              'regions', 'reviewedAt', 'reviewedBy'
            ])
            && profile.reviewBasis == 'professional_review'
            && profile.reviewedAt is timestamp
            && profile.reviewedBy is string
            && profile.reviewedBy.size() >= 1
            && profile.reviewedBy.size() <= 200
          )
        );
    }

    // `exerciseWriteValid` valida identidade (id/slug == id do documento) e
    // os poucos enums baratos de checar (status/difficulty). Não duplica o
    // dicionário inteiro de taxonomia (músculos, padrões de movimento,
    // equipamentos etc. — dezenas de valores em `src/types/exercise.ts`)
    // aqui: o gate real de "quem escreve" já é `isAdmin()`, e a validação
    // completa de taxonomia é feita no formulário do painel
    // (`exerciseValidation.ts`, reaproveitado lá). Duplicar tudo aqui seria
    // alto custo de manutenção por um ganho de segurança marginal, dado que
    // só um admin autenticado chega a este `write` — mesmo trade-off que
    // `supportTicketValid` já adota para campos operacionais.
    function exerciseWriteValid(exerciseId) {
      let d = request.resource.data;
      // Os 79 documentos criados pelo seed histórico usam o document id
      // como identidade e não persistem body.id. Documentos novos do painel
      // podem conter o campo duplicado; quando presente, ele continua preso
      // ao mesmo exerciseId e não pode ser falsificado em updates.
      return d.get('id', exerciseId) == exerciseId
        && d.slug == exerciseId
        && d.status in ['active', 'inactive', 'draft']
        && d.difficulty in ['beginner', 'intermediate', 'advanced']
        && d.name is map
        && d.name.keys().hasAll(['ptBR', 'en', 'es'])
        && d.metadata is map
        && d.metadata.updatedAt == request.time
        && (!('limitationProfile' in d)
            || limitationProfileValid(d.limitationProfile, exerciseId));
    }

    match /exercises/{exerciseId} {
      allow read: if hasVerifiedEmailForPrivateAccess();

      allow create: if isAdmin()
        && exerciseWriteValid(exerciseId)
        && request.resource.data.metadata.createdAt == request.time
        && request.resource.data.metadata.version == 1;

      // `createdAt`/`version` imutáveis a partir da Rule: o cliente nunca
      // reescreve o histórico, e isso também bloqueia por construção uma
      // tentativa de "criar" sobre um id que já existe com dados diferentes
      // (createdAt novo != createdAt armazenado ⇒ rejeitado como update).
      allow update: if isAdmin()
        && exerciseWriteValid(exerciseId)
        && (!('limitationProfile' in resource.data)
            || ('limitationProfile' in request.resource.data))
        && request.resource.data.metadata.createdAt == resource.data.metadata.createdAt
        && request.resource.data.metadata.version == resource.data.metadata.version;

      // Exercícios podem ser referenciados por histórico de treino — sem
      // hard delete nesta fase (docs/27 §8: desativação via status).
      allow delete: if false;
    }

    // Published clinical dataset identity. Clients consume only the active
    // pointer; immutable version snapshots and all writes remain server-only.
    // Contains only a version string + content hash — no clinical/PII data —
    // so it needs no stronger gate than `isSignedIn()`. Every workout program
    // generation reads this (to stamp its dataset identity) regardless of
    // whether the user has any limitations at all; gating it behind email
    // verification blocked first-program generation for every signed-in,
    // not-yet-verified account (`workoutPrograms.ts`'s `prepareWorkoutProgram`
    // maps the resulting permission-denied into `INVALID_CONFIGURATION`).
    match /limitationDatasetState/{stateId} {
      allow read: if stateId == 'active' && isSignedIn();
      allow write: if false;
    }

    match /limitationDatasetVersions/{datasetHash} {
      allow read, write: if false;
    }

    function workoutTemplateValid(templateId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'version', 'sourceVersion', 'libraryId', 'contentHash',
          'status', 'profile', 'split', 'rationale', 'sessions',
          'createdAt', 'updatedAt'
        ])
        && data.id == templateId
        && templateId.matches('^T(00[1-9]|0[1-8][0-9]|090)$')
        && data.version is int && data.version >= 1
        && data.sourceVersion is string
        && data.contentHash is string && data.contentHash.size() == 64
        && data.status == 'active'
        && data.sessions is list && data.sessions.size() >= 1 && data.sessions.size() <= 6
        && data.updatedAt == request.time;
    }

    match /workoutTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && workoutTemplateValid(templateId)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && workoutTemplateValid(templateId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // ── Deny all undocumented collections ─────────────────────────────────
    // Everything not documented above remains denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
