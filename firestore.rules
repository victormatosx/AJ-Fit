rules_version = '2';

// AJ Fit — Firestore Security Rules (SUGESTÃO / pendente de validação humana).
//
// Baseado em:
//   - docs/12_seguranca_geral_do_app.md (cliente não é fonte de verdade;
//     acesso apenas aos próprios dados; RevenueCat é dono da assinatura)
//   - docs/04_contratos_de_api.md §5 (contrato do documento users/{userId} —
//     profile/preferences/metadata)
//   - docs/13_assinaturas_e_billing.md §26 (schema de `subscription` —
//     referência única, consolidada na Sprint 3.5; espelhada em
//     functions/src/billing/{types,constants}.ts)
//
// Princípio: o app só escreve profile e metadata.updatedAt. Preferências,
// assinatura e metadados internos têm mapas próprios e validação independente.
// As respostas do questionário ficam na subcoleção `questionnaires`. Campos de
// assinatura e treino são gravados apenas pelo backend (Cloud Functions /
// webhook RevenueCat via Admin SDK, que ignora estas regras).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function profileValid(data) {
      return data is map
        && data.keys().hasAll(['name', 'email'])
        && data.keys().hasOnly(['name', 'email', 'birthDate', 'photoURL', 'photoVersion'])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 50
        && data.email is string
        && (!('birthDate' in data)
             || (data.birthDate is timestamp && data.birthDate <= request.time))
        && (!('photoURL' in data)
             || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('photoVersion' in data) || data.photoVersion is timestamp);
    }

    function preferencesValid(data) {
      return data is map
        && data.keys().hasAll(['language', 'units', 'theme'])
        && data.keys().hasOnly(['language', 'units', 'theme'])
        && data.language in ['pt-BR']
        && data.units in ['metric', 'imperial']
        && data.theme in ['dark', 'light', 'system'];
    }

    // Shape of `users/{userId}.subscription` — consolidated in Sprint 3.5 to
    // match docs/13_assinaturas_e_billing.md §26 exactly (the sole schema
    // reference; functions/src/billing/{types,constants}.ts mirror the same
    // field list byte-for-byte). Only the backend (Admin SDK, which bypasses
    // these rules) ever writes real values here — this function exists only
    // to keep the CLIENT from ever writing an unexpected shape into this
    // block via `create`/the legacy migration path, per docs §25/§27.
    //
    // `endsAt` (the pre-3.5 field name, still referenced by
    // `legacyMigrationValid()` below for one-time migrations of the old flat
    // document) was renamed to `currentPeriodEndsAt` to match docs §26.
    // `lastEventAt` from the original docs §26 draft was dropped as
    // redundant with `updatedAt` for this project's scale — see
    // functions/src/billing/types.ts's `SubscriptionMirror` comment.
    //
    // Sprint 4.1 robustness fix (see the Sprint 4 audit report): adds
    // `lastEventTimestampMs`, RevenueCat's own event clock (Unix ms,
    // `event_timestamp_ms`), reintroducing the ordering protection that
    // `lastEventAt`'s Sprint 3.5 removal had eliminated. NOT a Firestore
    // `timestamp` type — a plain non-negative integer, matching its wire
    // format. Optional, exactly like every other field here: documents
    // written before this Sprint won't have it, and
    // `applySubscriptionEventAtomically` (functions/src/billing/subscriptionSync.ts)
    // treats that as "first event of the new mechanism" — no backfill
    // required, no rules exception needed for older documents.
    function subscriptionValid(data) {
      return data is map
        && data.keys().hasOnly([
             'status', 'entitlementActive', 'provider', 'productId', 'store',
             'startedAt', 'trialEndsAt', 'currentPeriodEndsAt', 'canceledAt',
             'lastRenewedAt', 'lastEventId', 'lastEventTimestampMs', 'updatedAt'
           ])
        && (!('status' in data)
             || data.status in ['TRIAL', 'ACTIVE', 'CANCELED', 'BILLING_ISSUE', 'EXPIRED'])
        && (!('entitlementActive' in data) || data.entitlementActive is bool)
        && (!('provider' in data) || data.provider == 'REVENUECAT')
        && (!('productId' in data) || data.productId is string)
        && (!('store' in data) || data.store in ['APP_STORE', 'PLAY_STORE'])
        && (!('startedAt' in data) || data.startedAt is timestamp)
        && (!('trialEndsAt' in data)
             || data.trialEndsAt == null || data.trialEndsAt is timestamp)
        && (!('currentPeriodEndsAt' in data)
             || data.currentPeriodEndsAt == null || data.currentPeriodEndsAt is timestamp)
        && (!('canceledAt' in data)
             || data.canceledAt == null || data.canceledAt is timestamp)
        && (!('lastRenewedAt' in data)
             || data.lastRenewedAt == null || data.lastRenewedAt is timestamp)
        && (!('lastEventId' in data) || data.lastEventId is string)
        && (!('lastEventTimestampMs' in data)
             || (data.lastEventTimestampMs is int && data.lastEventTimestampMs >= 0))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function metadataValid(data) {
      return data is map
        && data.keys().hasAll(['role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['role', 'activeWorkoutId', 'createdAt', 'updatedAt'])
        && data.role == 'user'
        && (!('activeWorkoutId' in data) || data.activeWorkoutId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function nestedUserValid(data) {
      return data.keys().hasAll(['profile', 'preferences', 'subscription', 'metadata'])
        && data.keys().hasOnly(['profile', 'preferences', 'subscription', 'metadata'])
        && profileValid(data.profile)
        && preferencesValid(data.preferences)
        && subscriptionValid(data.subscription)
        && metadataValid(data.metadata);
    }

    function profilePhotoUpdateValid(before, after) {
      let changed = after.diff(before).affectedKeys();
      return (!changed.hasAny(['photoVersion']) || changed.hasAny(['photoURL']))
        && (!changed.hasAny(['photoURL'])
             || (changed.hasAny(['photoVersion']) && after.photoVersion == request.time));
    }

    // One-time, complete conversion of the former flat document. Every
    // backend-owned value must be preserved exactly; after conversion the
    // regular nested update rule applies and this branch becomes unreachable.
    function legacyMigrationValid() {
      let before = resource.data;
      let after = request.resource.data;
      return !('profile' in before)
        && nestedUserValid(after)
        && before.get('role', 'user') == 'user'
        && after.profile.name == before.name
        && after.profile.email == before.email
        && after.profile.get('birthDate', null) == before.get('birthDate', null)
        && after.profile.get('photoURL', null) == before.get('photoURL', null)
        && after.preferences.language == before.get('language', 'pt-BR')
        && after.preferences.units == 'metric'
        && after.preferences.theme == 'dark'
        && after.subscription.get('status', null) == before.get('subscriptionStatus', null)
        && after.subscription.get('provider', null) == before.get('subscriptionProvider', null)
        && after.subscription.get('trialEndsAt', null) == before.get('trialEndsAt', null)
        // Field renamed `endsAt` → `currentPeriodEndsAt` in Sprint 3.5 to
        // match docs/13 §26; the OLD flat field name (`subscriptionEndsAt`)
        // is unaffected — it's a one-time read of the legacy document, not
        // part of the new schema.
        && after.subscription.get('currentPeriodEndsAt', null) == before.get('subscriptionEndsAt', null)
        && after.metadata.role == before.get('role', 'user')
        && after.metadata.get('activeWorkoutId', null) == before.get('activeWorkoutId', null)
        && after.metadata.createdAt == before.createdAt
        && after.metadata.updatedAt == request.time;
    }

    // Avaliações físicas (docs/03 §4/§8, docs/15 §10/§11/§18). `source` é um
    // discriminador: guided exige os campos da calculadora (protocol, sex,
    // age, folds, bodyFat, calculatorVersion); imported não exige nenhum
    // deles e pode não ter bodyFat (campo simplesmente ausente — nunca 0).
    // Campos derivados (bmi, leanMass, fatMass, sumFolds, bodyDensity) e o
    // rótulo do protocolo nunca são aceitos: são resolvidos em tempo de
    // leitura no app (src/lib/skinfoldCalculator.ts), nunca persistidos.
    function assessmentCommonValid() {
      let d = request.resource.data;
      return d.source in ['guided', 'imported']
        && d.measuredAt is timestamp
        && d.measuredAt <= request.time
        // `== request.time` (not just `is timestamp`) forces the client to
        // have actually used serverTimestamp() — a client can't fabricate an
        // arbitrary createdAt to game the measuredAt/createdAt tie-break sort.
        && d.createdAt == request.time
        && d.weight is number && d.weight > 0
        && d.height is number && d.height > 0
        && (!('notes' in d) || d.notes is string);
    }

    function guidedAssessmentValid() {
      let d = request.resource.data;
      return d.source == 'guided'
        && d.keys().hasOnly([
             'source', 'measuredAt', 'createdAt', 'weight', 'height', 'bodyFat',
             'calculatorVersion', 'notes', 'protocol', 'sex', 'age', 'folds'
           ])
        && d.calculatorVersion == 1
        && d.protocol in ['jp3', 'jp7']
        && d.sex in ['m', 'f']
        && d.age is number && d.age > 0
        && d.bodyFat is number && d.bodyFat > 0
        && d.folds is map && d.folds.size() > 0;
    }

    function importedAssessmentValid() {
      let d = request.resource.data;
      return d.source == 'imported'
        && d.keys().hasOnly([
             'source', 'measuredAt', 'createdAt', 'weight', 'height', 'bodyFat',
             'notes', 'bodyWater', 'basalMetabolism', 'visceralFat'
           ])
        && (!('bodyFat' in d) || (d.bodyFat is number && d.bodyFat > 0))
        && (!('bodyWater' in d) || (d.bodyWater is number && d.bodyWater > 0))
        && (!('basalMetabolism' in d) || (d.basalMetabolism is number && d.basalMetabolism > 0))
        && (!('visceralFat' in d) || (d.visceralFat is number && d.visceralFat > 0));
    }

    match /users/{userId} {
      // Leitura: apenas o dono do documento.
      allow read: if isOwner(userId);

      // Criação: documento integralmente aninhado, com identidade coerente com
      // o token e sem campos de assinatura/internos definidos pelo cliente.
      allow create: if isOwner(userId)
        && nestedUserValid(request.resource.data)
        && request.resource.data.profile.email == request.auth.token.email
        && request.resource.data.subscription.size() == 0
        && !('activeWorkoutId' in request.resource.data.metadata)
        && request.resource.data.metadata.createdAt == request.time
        && request.resource.data.metadata.updatedAt == request.time;

      // Atualização: apenas o dono e somente os campos editáveis do perfil.
      // `diff().affectedKeys().hasOnly` impede alterações em campos de conta,
      // assinatura, treino ou privilégios mesmo que novos campos sejam
      // adicionados ao documento no futuro.
      allow update: if isOwner(userId) && (
        legacyMigrationValid()
        || (
          nestedUserValid(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['profile', 'metadata'])
          && request.resource.data.profile.diff(resource.data.profile).affectedKeys()
               .hasOnly(['name', 'birthDate', 'photoURL', 'photoVersion'])
          && profilePhotoUpdateValid(resource.data.profile, request.resource.data.profile)
          && request.resource.data.metadata.diff(resource.data.metadata).affectedKeys()
               .hasOnly(['updatedAt'])
          && request.resource.data.metadata.updatedAt == request.time
        )
      );

      // Exclusão: negada ao cliente (remoção é processo de backend — 90 dias,
      // docs/12 §10). Somente o Admin SDK pode excluir.
      allow delete: if false;

      // Questionários do usuário (inicial + reavaliações futuras).
      // Cada documento é um snapshot imutável.
      match /questionnaires/{questionnaireId} {
        // Leitura: apenas o dono do usuário pai.
        allow read: if isOwner(userId);

        // Criação: apenas o dono, com os campos esperados e válidos.
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(
               ['answers', 'version', 'createdAt'])
          && request.resource.data.answers is map
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.createdAt is timestamp;

        // Histórico imutável: sem edição nem exclusão pelo cliente.
        allow update, delete: if false;
      }

      // Avaliações físicas do usuário (guiadas ou importadas). Cada documento
      // é um snapshot imutável — nunca sobrescrever ou apagar (docs/15 §11).
      match /assessments/{assessmentId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && assessmentCommonValid()
          && (guidedAssessmentValid() || importedAssessmentValid());

        allow update, delete: if false;
      }
    }

    // Coleções de sistema (exercises, workout_templates, treinos do usuário,
    // etc.) ainda não têm contrato de regras aprovado — negar por padrão até
    // definição do Agente de Segurança/Arquiteto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
