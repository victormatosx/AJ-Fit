rules_version = '2';

// AJ Fit — Firestore Security Rules (production contract).
//
// Baseado em:
//   - docs/12_seguranca_geral_do_app.md (cliente não é fonte de verdade;
//     acesso apenas aos próprios dados; RevenueCat é dono da assinatura)
//   - docs/04_contratos_de_api.md §5 (contrato do documento users/{userId} —
//     profile/preferences/metadata)
//   - docs/13_assinaturas_e_billing.md §26 (schema de `subscription` —
//     referência única, consolidada na Sprint 3.5; espelhada em
//     functions/src/billing/{types,constants}.ts)
//
// Princípio: o app só escreve profile, language/units e metadata.updatedAt.
// Assinatura e metadados internos têm mapas próprios e validação independente.
// As respostas do questionário ficam na subcoleção `questionnaires`. Campos de
// assinatura é gravada apenas pelo backend. Programas de treino privados são
// snapshots client-authorized, validados e ativados atomicamente pelas regras.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasPasswordIdentity() {
      return isSignedIn()
        && request.auth.token.get('firebase', {})
             .get('identities', {})
             .get('email', []).size() > 0;
    }

    function hasVerifiedEmailForPrivateAccess() {
      return isSignedIn()
        && (!hasPasswordIdentity()
            || request.auth.token.get('email_verified', false) == true);
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && hasVerifiedEmailForPrivateAccess();
    }

    // Não existe checagem de assinatura por ação nestas regras.
    //
    // O AJ Fit é inteiramente pago: o acesso ao app já é condicionado à
    // mensalidade antes de qualquer tela funcional, então todo usuário
    // autenticado que alcança estes documentos é, por definição, assinante.
    // A antiga `hasServerPremium(userId)` (FASE 7) checava
    // `users/{userId}.subscription.entitlementActive` no create/delete de
    // progressPhotos e no create de assessments; virou redundante sob esse
    // modelo de produto e foi removida — junto com a cópia equivalente em
    // storage.rules.
    //
    // O que protege dado continua intacto: `isOwner(userId)` em todas as
    // operações, a imutabilidade dos snapshots (`allow update: if false`) e
    // a proibição do cliente escrever `subscription` em si (`subscription.
    // size() == 0` no create e a ausência de `subscription` do conjunto de
    // chaves permitidas no update) — o espelho segue sendo exclusivamente
    // do servidor, mesmo sem ninguém lendo `entitlementActive` aqui.

    // FASE 5 (docs/25_exclusao_de_conta_arquitetura.md — "Bloqueio imediato
    // da conta"): once `requestAccountDeletion` has durably accepted a
    // deletion, this becomes `false` and every private user-owned path
    // below denies read/write, regardless of the internal workflow status
    // (`REQUESTED`/`PROCESSING`/`RETRY_SCHEDULED`/`COMPLETED`/
    // `FAILED_TERMINAL` all mean "not active" — see
    // `functions/src/accountDeletion/activeAccountGuard.ts`'s doc comment
    // for why status is never inspected, only existence). A stale ID token
    // issued before the lock was created is exactly what this guards
    // against: `admin.auth().revokeRefreshTokens` alone does not invalidate
    // an already-issued ID token before its normal ~1h expiry, so this is
    // the layer that actually stops a client SDK write/read with such a
    // token, independent of any backend callable guard.
    //
    // One extra `exists()` read per rule evaluation. Deliberately checks
    // presence of the LOCK document, not
    // `accountDeletions/{deletionId}`'s `status` field — the lock is a
    // single, tiny, doc-id-keyed read; resolving a full record would need
    // an extra indirection this check does not need.
    //
    // Antes do deploy desta fase, o ruleset publicado foi confirmado byte a
    // byte contra o firestore.rules do HEAD inicial.
    function accountActive(userId) {
      return !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId));
    }

    // O painel autentica com Firebase Auth e o backend promove previamente o
    // documento do operador. Escritas do app nunca podem alterar metadata.role.
    function isAdmin() {
      return hasVerifiedEmailForPrivateAccess()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.metadata.role == 'admin';
    }

    // DEV Workout Lifecycle QA (docs/workout-lifecycle/v2/qa/): same shape
    // as isAdmin() above — only readable, never client-writable (see
    // metadataValid's comment and the users/{userId} update rule, which
    // never lets `metadata` diffs touch this key). `workoutLifecycleQaMode`
    // is single-valued ('ACCELERATED' | 'TRANSITION') — mutually exclusive
    // by construction, never two independent flags. This helper mirrors
    // `functions/src/workoutLifecycle/qaPolicy.ts`'s resolution exactly,
    // including the deprecated legacy-boolean fallback (only consulted when
    // the new field is absent). Only QA_ACCELERATED widens the
    // pendingEvolutions deferral timing tolerance below — QA_TRANSITION
    // uses the real 14-day window like any other account, since deferral
    // timing is real production behavior it deliberately doesn't touch.
    // The real progression thresholds (28/85 days, 70%/85% adherence, 4
    // cycles) and the QA_TRANSITION eligibility bypass are enforced
    // server-side in authorizeMutation.ts reading this exact same field —
    // this Rules helper never grants those on its own.
    function workoutLifecycleQaModeIsAccelerated(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && (
          get(/databases/$(database)/documents/users/$(userId)).data.metadata.get('workoutLifecycleQaMode', null) == 'ACCELERATED'
          || (
            !('workoutLifecycleQaMode' in get(/databases/$(database)/documents/users/$(userId)).data.metadata)
            && get(/databases/$(database)/documents/users/$(userId)).data.metadata.get('workoutLifecycleQaAccelerated', false) == true
          )
        );
    }

    // P0-C — workoutExecutions mutex hardening gate (docs/workout-lifecycle/
    // hardening plan, 2026-09). Global (not per-user) — see the
    // `workoutExecutionProtocolConfig` match block for the doc shape and
    // write-access rationale (Admin-SDK-only). Absence of the config
    // document, or `requireMutexOnCreate` absent/false, means "compatible
    // mode" — the default, safe-for-old-clients state. Consulted by the
    // `workoutExecutions` create rule.
    function workoutExecutionMutexHardeningEnabled() {
      return exists(/databases/$(database)/documents/workoutExecutionProtocolConfig/active)
        && get(/databases/$(database)/documents/workoutExecutionProtocolConfig/active).data.get('requireMutexOnCreate', false) == true;
    }

    function profileValid(data) {
      return data is map
        && data.keys().hasAll(['name', 'email'])
        && data.keys().hasOnly(['name', 'email', 'birthDate', 'photoURL', 'photoVersion', 'height'])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 50
        && data.email is string
        && (!('birthDate' in data)
             || (data.birthDate is timestamp && data.birthDate <= request.time))
        && (!('photoURL' in data)
             || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!('photoVersion' in data) || data.photoVersion is timestamp)
        // Matches PROFILE_MIN_HEIGHT_CM/PROFILE_MAX_HEIGHT_CM in
        // src/lib/userProfileValidation.ts.
        && (!('height' in data)
             || (data.height is number && data.height >= 140 && data.height <= 220));
    }

    function preferencesValid(data) {
      // `hasAll` + `hasOnly` das mesmas 3 chaves impede mapas incompletos e
      // impede escritas do cliente que substituiriam o mapa inteiro por
      // { language } (o padrão perigoso do JS SDK, que apagaria theme/units
      // silenciosamente). O update legítimo usa caminho pontuado —
      // `preferences.language` — e nunca reescreve o mapa.
      //
      // O conjunto de idiomas DEVE bater exatamente com SUPPORTED_LANGUAGES
      // em src/types/language.ts.
      return data is map
        && data.keys().hasAll(['language', 'units', 'theme'])
        && data.keys().hasOnly(['language', 'units', 'theme', 'notificationPreferences'])
        && data.language in ['pt-BR', 'en', 'es']
        && data.units in ['system', 'metric', 'imperial']
        && data.theme in ['dark', 'light', 'system']
        && (!('notificationPreferences' in data)
             || notificationPreferencesValid(data.notificationPreferences));
    }

    function notificationPreferencesValid(data) {
      return data is map
        && data.keys().hasOnly([
             'workoutsAndReminders',
             'evolutionAndAchievements',
             'progress'
           ])
        && (!('workoutsAndReminders' in data) || data.workoutsAndReminders is bool)
        && (!('evolutionAndAchievements' in data) || data.evolutionAndAchievements is bool)
        && (!('progress' in data) || data.progress is bool);
    }

    // Shape of `users/{userId}.subscription` — consolidated in Sprint 3.5 to
    // match docs/13_assinaturas_e_billing.md §26 exactly (the sole schema
    // reference; functions/src/billing/{types,constants}.ts mirror the same
    // field list byte-for-byte). Only the backend (Admin SDK, which bypasses
    // these rules) ever writes real values here — this function exists only
    // to keep the CLIENT from ever writing an unexpected shape into this
    // block via `create`/the legacy migration path, per docs §25/§27.
    //
    // `endsAt` (the pre-3.5 field name, still referenced by
    // `legacyMigrationValid()` below for one-time migrations of the old flat
    // document) was renamed to `currentPeriodEndsAt` to match docs §26.
    // `lastEventAt` from the original docs §26 draft was dropped as
    // redundant with `updatedAt` for this project's scale — see
    // functions/src/billing/types.ts's `SubscriptionMirror` comment.
    //
    // Sprint 4.1 robustness fix (see the Sprint 4 audit report): adds
    // `lastEventTimestampMs`, RevenueCat's own event clock (Unix ms,
    // `event_timestamp_ms`), reintroducing the ordering protection that
    // `lastEventAt`'s Sprint 3.5 removal had eliminated. NOT a Firestore
    // `timestamp` type — a plain non-negative integer, matching its wire
    // format. Optional, exactly like every other field here: documents
    // written before this Sprint won't have it, and
    // `applySubscriptionEventAtomically` (functions/src/billing/subscriptionSync.ts)
    // treats that as "first event of the new mechanism" — no backfill
    // required, no rules exception needed for older documents.
    function subscriptionValid(data) {
      return data is map
        && data.keys().hasOnly([
             'status', 'entitlementActive', 'provider', 'productId', 'store',
             'startedAt', 'trialEndsAt', 'currentPeriodEndsAt', 'canceledAt',
             'lastRenewedAt', 'lastEventId', 'lastEventTimestampMs', 'updatedAt'
           ])
        && (!('status' in data)
             || data.status in ['TRIAL', 'ACTIVE', 'CANCELED', 'BILLING_ISSUE', 'EXPIRED'])
        && (!('entitlementActive' in data) || data.entitlementActive is bool)
        && (!('provider' in data) || data.provider == 'REVENUECAT')
        && (!('productId' in data) || data.productId is string)
        && (!('store' in data) || data.store in ['APP_STORE', 'PLAY_STORE'])
        && (!('startedAt' in data) || data.startedAt is timestamp)
        && (!('trialEndsAt' in data)
             || data.trialEndsAt == null || data.trialEndsAt is timestamp)
        && (!('currentPeriodEndsAt' in data)
             || data.currentPeriodEndsAt == null || data.currentPeriodEndsAt is timestamp)
        && (!('canceledAt' in data)
             || data.canceledAt == null || data.canceledAt is timestamp)
        && (!('lastRenewedAt' in data)
             || data.lastRenewedAt == null || data.lastRenewedAt is timestamp)
        && (!('lastEventId' in data) || data.lastEventId is string)
        && (!('lastEventTimestampMs' in data)
             || (data.lastEventTimestampMs is int && data.lastEventTimestampMs >= 0))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // `commercialGateResolvedAt` (initial-Paywall marker — see the
    // `UserProfile.metadata` doc comment in src/services/userProfile.ts):
    // OPTIONAL like `activeWorkoutId`/`attribution` (absent on every
    // document written before this field existed — never reinterpreted as
    // "account is new"). When present it is either `null` (client-written
    // only at account creation — see the `create` rule below) or a
    // `timestamp` (backend-only, via the Admin SDK, which bypasses these
    // Rules entirely — no client write path ever produces a timestamp
    // here, enforced by the `update` rule's `metadata` diff restricted to
    // `updatedAt`).
    function metadataValid(data) {
      return data is map
        && data.keys().hasAll(['role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(
             ['role', 'activeWorkoutId', 'createdAt', 'updatedAt', 'commercialGateResolvedAt',
              'workoutLifecycleQaMode', 'workoutLifecycleQaAccelerated'])
        && data.role in ['user', 'admin']
        && (!('activeWorkoutId' in data) || data.activeWorkoutId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('commercialGateResolvedAt' in data)
             || data.commercialGateResolvedAt == null
             || data.commercialGateResolvedAt is timestamp)
        // DEV Workout Lifecycle QA (docs/workout-lifecycle/v2/qa/): only the
        // Admin SDK / Firebase Console can ever write these fields — the
        // `users/{userId}` update rule below restricts client-affected keys
        // to `metadata.updatedAt` only, so these presence checks exist
        // purely so a client CAN'T be locked out of its own unrelated
        // profile edits once an admin sets one (`hasOnly` above would
        // otherwise reject the whole doc). `workoutLifecycleQaMode` is
        // single-valued and mutually exclusive by construction. The legacy
        // `workoutLifecycleQaAccelerated` boolean (deprecated) is still
        // accepted for accounts not yet migrated to the new field.
        && (!('workoutLifecycleQaMode' in data)
             || data.workoutLifecycleQaMode in ['ACCELERATED', 'TRANSITION'])
        && (!('workoutLifecycleQaAccelerated' in data)
             || data.workoutLifecycleQaAccelerated is bool);
    }

    function workoutProgramLimitationValid(questionnaire, data) {
      let conditions = questionnaire.data.answers.get('specialConditions', []);
      let limits = questionnaire.data.answers.get('limits', []);
      return conditions is list
        && limits is list
        && (
          (
            !conditions.hasAny(['musculoskeletal_limitation'])
            && !limits.hasAny([
                 'knee', 'hip', 'back', 'shoulder', 'elbow', 'wrist', 'ankle_foot', 'other'
               ])
          )
          || (
            conditions.hasAny(['musculoskeletal_limitation'])
            && limits.size() >= 1
            && limits.toSet().hasOnly([
                 'knee', 'hip', 'back', 'shoulder', 'elbow', 'wrist', 'ankle_foot'
               ])
            && data.versions.limitationResolver == '1.0.0'
            && data.trace.limitationResolverVersion == 1
            && data.trace.limitationDecisions is list
            && data.trace.limitationDecisions.size() >= data.sessions.size()
            && data.trace.limitationDecisions.size() <= 100
          )
        );
    }

    function workoutProgramCommonValid(userId, programId, data) {
      let template = get(/databases/$(database)/documents/workoutTemplates/$(data.templateId));
      let questionnaire = get(/databases/$(database)/documents/users/$(userId)/questionnaires/$(data.questionnaireId));
      return data is map
        && data.keys().hasAll([
             'programId', 'planId', 'prescriptionId', 'templateId', 'templateVersion',
             'templateSourceVersion', 'templateContentHash', 'questionnaireId',
             'questionnaireVersion', 'status', 'source', 'requestedDays',
             'prescribedStructuredDays', 'population', 'environment',
             'goalFamily', 'split', 'sessions', 'versions', 'trace',
             'createdAt', 'activatedAt', 'updatedAt'
           ])
        && data.keys().hasOnly([
             'programId', 'planId', 'prescriptionId', 'templateId', 'templateVersion',
             'templateSourceVersion', 'templateContentHash', 'questionnaireId',
             'questionnaireVersion', 'status', 'source', 'requestedDays',
             'prescribedStructuredDays', 'population', 'environment',
             'goalFamily', 'split', 'adaptationStage', 'sessions', 'versions',
             'trace', 'limitationDatasetVersion', 'limitationDatasetHash',
             'prescribedTrainingFrequency', 'availability', 'weeklySchedule',
             'createdAt', 'activatedAt', 'updatedAt'
           ])
        && data.programId == programId
        // `planId` is `FinalWorkoutPlan.planId` spread verbatim onto the
        // program doc (`WorkoutProgramSnapshot extends FinalWorkoutPlan`,
        // src/services/workoutPrograms.ts); `prescriptionId` is always set
        // to that same value at persist time — enforced here too so the two
        // can never silently diverge.
        && data.planId is string
        && data.prescriptionId == data.planId
        && data.prescriptionId is string
        && data.templateId is string
        && data.templateId.matches('^T(00[1-9]|0[1-8][0-9]|090)$')
        && template.data.status == 'active'
        && data.templateVersion == template.data.version
        && data.templateSourceVersion == template.data.sourceVersion
        && data.templateContentHash == template.data.contentHash
        && data.questionnaireId is string
        && data.questionnaireVersion is int && data.questionnaireVersion >= 1
        && questionnaire.data.version == data.questionnaireVersion
        && workoutProgramLimitationValid(questionnaire, data)
        && data.status in ['active', 'superseded']
        && data.source in ['onboarding', 'manual_regeneration', 'automatic_progression', 'automatic_reconciliation', 'evolution_activation', 'program_adaptation']
        && data.requestedDays is int && data.requestedDays >= 2 && data.requestedDays <= 7
        && data.prescribedStructuredDays is int
        && data.prescribedStructuredDays >= 2 && data.prescribedStructuredDays <= 7
        && data.sessions is list && data.sessions.size() >= 1 && data.sessions.size() <= 7
        && data.versions is map
        && ((data.versions.templateLibrary == '1.3.0'
              && data.versions.compositionEngine == '2.0.0')
            || (data.versions.templateLibrary == '2.0.0'
              && data.versions.compositionEngine == '2.1.0'))
        && data.versions.selectionEngine in ['1.0.0', '2.0.0']
        && (
          (data.versions.selectionEngine == '1.0.0'
            && !data.keys().hasAny(['prescribedTrainingFrequency', 'availability', 'weeklySchedule']))
          ||
          (data.versions.selectionEngine == '2.0.0'
            && data.keys().hasAll(['prescribedTrainingFrequency', 'availability', 'weeklySchedule'])
            && data.prescribedTrainingFrequency is int
            && data.prescribedTrainingFrequency == data.prescribedStructuredDays
            && data.prescribedTrainingFrequency >= 2
            && data.prescribedTrainingFrequency <= 6
            && data.prescribedTrainingFrequency <= data.requestedDays
            && data.availability is map
            && data.availability.keys().hasAll(['days', 'weekdays'])
            && data.availability.keys().hasOnly(['days', 'weekdays'])
            && data.availability.days == data.requestedDays
            && data.availability.weekdays is list
            && (data.availability.weekdays.size() == 0
              || data.availability.weekdays.size() == data.availability.days)
            && data.weeklySchedule is list
            && (data.weeklySchedule.size() == 0 || data.weeklySchedule.size() == 7))
        )
        && data.versions.safetyRules == '1.0.0'
        && data.versions.modifierRules == '2.0.0'
        && data.trace is map
        && data.trace.safety is map
        && data.trace.safety.status in ['CLEAR', 'ADAPTED']
        && data.trace.unresolvedModifiers is list
        && data.trace.unresolvedModifiers.size() == 0
        && (!('adaptationStage' in data)
            || (data.adaptationStage is int && data.adaptationStage >= 1 && data.adaptationStage <= 3));
    }

    // New program snapshots are cryptographically tied to the exact active
    // clinical dataset. Legacy snapshots remain readable/updateable so an
    // activation transaction can supersede them without rewriting history.
    function workoutProgramLimitationDatasetValid(data) {
      let active = get(/databases/$(database)/documents/limitationDatasetState/active);
      return (
          !data.keys().hasAny(['limitationDatasetVersion', 'limitationDatasetHash'])
        ) || (
          data.keys().hasAll(['limitationDatasetVersion', 'limitationDatasetHash'])
          && data.limitationDatasetVersion is string
          && data.limitationDatasetVersion.size() >= 1
          && data.limitationDatasetVersion.size() <= 120
          && data.limitationDatasetHash is string
          && data.limitationDatasetHash.matches('^[a-f0-9]{64}$')
          && active.data.datasetVersion == data.limitationDatasetVersion
          && active.data.limitationDatasetHash == data.limitationDatasetHash
        );
    }

    // Phase 10E (P3, docs/workout-lifecycle/v2/architecture/
    // 26_FINAL_INDEPENDENT_ADVERSARIAL_AUDIT_2.md §51): `exercises.size()`
    // was bounded (<=20) but each exercise's own `sets` array was not,
    // capped only by Firestore's 1MB document limit. Real prescriptions cap
    // sets at 1-10 per exercise (`assertPlanSafe`,
    // functions/src/workoutLifecycle/authorizeMutation.ts:428) — 15 gives a
    // safe margin without constraining any real prescribed or logged
    // session. Firestore Rules has no loop/recursion construct, so this is
    // unrolled to the same 20-exercise cap `workoutExecutionCommonValid`
    // already enforces. Write-size hygiene only — session-qualification
    // (`isValidProgressionSessionAgainstPrescription`) already requires an
    // exact set-count match against the real prescription, so an oversized
    // array here was never able to earn progression credit; this only
    // closes the ability to write one at all.
    function executionExerciseSetsWithinBound(exercises) {
      return (exercises.size() <= 0 || !('sets' in exercises[0]) || (exercises[0].sets is list && exercises[0].sets.size() <= 15))
        && (exercises.size() <= 1 || !('sets' in exercises[1]) || (exercises[1].sets is list && exercises[1].sets.size() <= 15))
        && (exercises.size() <= 2 || !('sets' in exercises[2]) || (exercises[2].sets is list && exercises[2].sets.size() <= 15))
        && (exercises.size() <= 3 || !('sets' in exercises[3]) || (exercises[3].sets is list && exercises[3].sets.size() <= 15))
        && (exercises.size() <= 4 || !('sets' in exercises[4]) || (exercises[4].sets is list && exercises[4].sets.size() <= 15))
        && (exercises.size() <= 5 || !('sets' in exercises[5]) || (exercises[5].sets is list && exercises[5].sets.size() <= 15))
        && (exercises.size() <= 6 || !('sets' in exercises[6]) || (exercises[6].sets is list && exercises[6].sets.size() <= 15))
        && (exercises.size() <= 7 || !('sets' in exercises[7]) || (exercises[7].sets is list && exercises[7].sets.size() <= 15))
        && (exercises.size() <= 8 || !('sets' in exercises[8]) || (exercises[8].sets is list && exercises[8].sets.size() <= 15))
        && (exercises.size() <= 9 || !('sets' in exercises[9]) || (exercises[9].sets is list && exercises[9].sets.size() <= 15))
        && (exercises.size() <= 10 || !('sets' in exercises[10]) || (exercises[10].sets is list && exercises[10].sets.size() <= 15))
        && (exercises.size() <= 11 || !('sets' in exercises[11]) || (exercises[11].sets is list && exercises[11].sets.size() <= 15))
        && (exercises.size() <= 12 || !('sets' in exercises[12]) || (exercises[12].sets is list && exercises[12].sets.size() <= 15))
        && (exercises.size() <= 13 || !('sets' in exercises[13]) || (exercises[13].sets is list && exercises[13].sets.size() <= 15))
        && (exercises.size() <= 14 || !('sets' in exercises[14]) || (exercises[14].sets is list && exercises[14].sets.size() <= 15))
        && (exercises.size() <= 15 || !('sets' in exercises[15]) || (exercises[15].sets is list && exercises[15].sets.size() <= 15))
        && (exercises.size() <= 16 || !('sets' in exercises[16]) || (exercises[16].sets is list && exercises[16].sets.size() <= 15))
        && (exercises.size() <= 17 || !('sets' in exercises[17]) || (exercises[17].sets is list && exercises[17].sets.size() <= 15))
        && (exercises.size() <= 18 || !('sets' in exercises[18]) || (exercises[18].sets is list && exercises[18].sets.size() <= 15))
        && (exercises.size() <= 19 || !('sets' in exercises[19]) || (exercises[19].sets is list && exercises[19].sets.size() <= 15));
    }

    // Exercise-substitution architecture audit, Fase 7 (security hardening),
    // Fase 8 hotfix (2026-09 production regression — see the incident note
    // below): `exerciseId`/`prescribedExerciseId`/`substitution` identify
    // WHICH exercise a slot's sets belong to — a client that could rewrite
    // these on an ordinary update would be able to silently redirect the
    // identity of an in-progress slot's history without ever going through
    // `applyExerciseSubstitution` (the only trusted, fully-revalidating
    // path — Admin SDK, bypasses these Rules entirely, so this restriction
    // has zero effect on it). `record/skip/finish` never touch these three
    // fields — only `sets[]`/`status`/`finishedAt` — so this never blocks a
    // legitimate mutation.
    //
    // Do not use whole-map equality or `diff()` here. Both deeply inspect the
    // nested `sets` arrays before discovering that a record/skip/finish only
    // changed set facts; on a real seven-exercise V2 session that exceeded
    // Firestore's hard 1000-expression ceiling once authority and mutex
    // checks were added. Compare only the slot/clinical identity fields this
    // guard exists to freeze. The execution envelope and set bounds remain
    // independently validated by `workoutExecutionCommonValid` and
    // `executionExerciseSetsWithinBound`.
    function exerciseIdentityUnchanged(before, after) {
      return after.sets is list
        && after.sets.size() <= 15
        && before.exerciseIndex == after.exerciseIndex
        && before.exerciseId == after.exerciseId
        && before.get('prescribedExerciseId', null) == after.get('prescribedExerciseId', null)
        && before.get('substitution', null) == after.get('substitution', null);
    }

    // Unrolled to the same 20-exercise cap `executionExerciseSetsWithinBound`
    // already uses — no `get()`/`getAfter()` cross-document read here (only
    // local array indexing/diffing).
    function exerciseIdentityFieldsImmutable(before, after) {
      return (before.size() <= 0 || after.size() <= 0 || exerciseIdentityUnchanged(before[0], after[0]))
        && (before.size() <= 1 || after.size() <= 1 || exerciseIdentityUnchanged(before[1], after[1]))
        && (before.size() <= 2 || after.size() <= 2 || exerciseIdentityUnchanged(before[2], after[2]))
        && (before.size() <= 3 || after.size() <= 3 || exerciseIdentityUnchanged(before[3], after[3]))
        && (before.size() <= 4 || after.size() <= 4 || exerciseIdentityUnchanged(before[4], after[4]))
        && (before.size() <= 5 || after.size() <= 5 || exerciseIdentityUnchanged(before[5], after[5]))
        && (before.size() <= 6 || after.size() <= 6 || exerciseIdentityUnchanged(before[6], after[6]))
        && (before.size() <= 7 || after.size() <= 7 || exerciseIdentityUnchanged(before[7], after[7]))
        && (before.size() <= 8 || after.size() <= 8 || exerciseIdentityUnchanged(before[8], after[8]))
        && (before.size() <= 9 || after.size() <= 9 || exerciseIdentityUnchanged(before[9], after[9]))
        && (before.size() <= 10 || after.size() <= 10 || exerciseIdentityUnchanged(before[10], after[10]))
        && (before.size() <= 11 || after.size() <= 11 || exerciseIdentityUnchanged(before[11], after[11]))
        && (before.size() <= 12 || after.size() <= 12 || exerciseIdentityUnchanged(before[12], after[12]))
        && (before.size() <= 13 || after.size() <= 13 || exerciseIdentityUnchanged(before[13], after[13]))
        && (before.size() <= 14 || after.size() <= 14 || exerciseIdentityUnchanged(before[14], after[14]))
        && (before.size() <= 15 || after.size() <= 15 || exerciseIdentityUnchanged(before[15], after[15]))
        && (before.size() <= 16 || after.size() <= 16 || exerciseIdentityUnchanged(before[16], after[16]))
        && (before.size() <= 17 || after.size() <= 17 || exerciseIdentityUnchanged(before[17], after[17]))
        && (before.size() <= 18 || after.size() <= 18 || exerciseIdentityUnchanged(before[18], after[18]))
        && (before.size() <= 19 || after.size() <= 19 || exerciseIdentityUnchanged(before[19], after[19]));
    }

    // Workout Execution & History V1 (docs/workout-lifecycle/
    // 09_WORKOUT_EXECUTION_AND_HISTORY.md). `exercises` is validated only for
    // shape/bounds here, the same precedent `workoutProgramCommonValid` sets
    // for `sessions` above — deep per-set validation belongs to the app
    // layer, not Rules. Ownership of the referenced program comes from the
    // `get()` itself: it can only ever resolve under this same `userId`'s
    // subtree, so a bogus/foreign `programId` simply fails to exist.
    function workoutExecutionCommonValid(userId, data) {
      let program = get(/databases/$(database)/documents/users/$(userId)/workoutPrograms/$(data.programId));
      return data is map
        && data.keys().hasAll([
             'programId', 'templateId', 'sessionIndex', 'sessionName',
             'scheduledLocalDate', 'status', 'startedAt', 'finishedAt',
             'exercises', 'executionSchemaVersion', 'createdAt', 'updatedAt'
           ])
        && data.keys().hasOnly([
             'programId', 'templateId', 'sessionIndex', 'sessionName',
             'scheduledLocalDate', 'status', 'startedAt', 'finishedAt',
             'exercises', 'executionSchemaVersion', 'createdAt', 'updatedAt',
             'programInstanceId', 'mutexProtocolVersion', 'cardio'
           ])
        // P0-C protocol marker (docs/workout-lifecycle/ hardening plan) —
        // optional so a pre-hardening client omitting it is still valid;
        // once present it must be the real, current value. See
        // `WORKOUT_EXECUTION_MUTEX_PROTOCOL_VERSION` (src/workoutExecution/types.ts).
        && (!('mutexProtocolVersion' in data) || data.mutexProtocolVersion == 1)
        && data.programId is string
        && program.data.programId == data.programId
        && data.templateId is string
        && data.sessionIndex is int && data.sessionIndex >= 0
        && data.sessionName is string
        && data.scheduledLocalDate is string
        && data.scheduledLocalDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status in ['IN_PROGRESS', 'COMPLETED', 'PARTIALLY_COMPLETED', 'ABANDONED']
        && data.startedAt is timestamp
        && (data.finishedAt == null || data.finishedAt is timestamp)
        && data.exercises is list && data.exercises.size() >= 1 && data.exercises.size() <= 20
        && data.executionSchemaVersion in [1, 2]
        && (
          (data.executionSchemaVersion == 1 && !('programInstanceId' in data))
          || (data.executionSchemaVersion == 2
              && data.programInstanceId is string
              && get(/databases/$(database)/documents/users/$(userId)/programInstances/$(data.programInstanceId)).data.contentIdentity == data.programId)
        )
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Shape of `users/{userId}.attribution` — the read-optimized mirror of
    // a user's promo-code attribution (functions/src/attribution/types.ts's
    // `AttributionSnapshot`; source of truth is `couponRedemptions/{userId}`,
    // written only by the Admin SDK — see the `couponRedemptions` match
    // block below). Only the backend ever writes real values here; this
    // function exists so `nestedUserValid` can tolerate the field's
    // presence (once the backend has written it) without letting the
    // CLIENT ever populate or change it itself — see the `create`/`update`
    // rules on `users/{userId}` for the actual write blocks.
    function attributionValid(data) {
      return data is map
        && data.keys().hasOnly(['couponCode', 'campaignId', 'influencerId', 'appliedAt'])
        && (!('couponCode' in data) || data.couponCode is string)
        && (!('campaignId' in data) || data.campaignId is string)
        && (!('influencerId' in data) || data.influencerId is string)
        && (!('appliedAt' in data) || data.appliedAt is timestamp);
    }

    // `attribution` is OPTIONAL (absent on every document created before
    // this field existed, and on brand-new documents until the backend
    // applies a promo code) — `hasAll` only requires the original four
    // fields; `hasOnly` allows the fifth without forcing every existing
    // caller of this function to know about it.
    function nestedUserValid(data) {
      return data.keys().hasAll(['profile', 'preferences', 'subscription', 'metadata'])
        && data.keys().hasOnly(['profile', 'preferences', 'subscription', 'metadata', 'attribution'])
        && profileValid(data.profile)
        && preferencesValid(data.preferences)
        && subscriptionValid(data.subscription)
        && metadataValid(data.metadata)
        && (!('attribution' in data) || attributionValid(data.attribution));
    }

    function profilePhotoUpdateValid(before, after) {
      let changed = after.diff(before).affectedKeys();
      return (!changed.hasAny(['photoVersion']) || changed.hasAny(['photoURL']))
        && (!changed.hasAny(['photoURL'])
             || (changed.hasAny(['photoVersion']) && after.photoVersion == request.time));
    }

    // One-time, complete conversion of the former flat document. Every
    // backend-owned value must be preserved exactly; after conversion the
    // regular nested update rule applies and this branch becomes unreachable.
    function legacyMigrationValid() {
      let before = resource.data;
      let after = request.resource.data;
      return !('profile' in before)
        && nestedUserValid(after)
        && before.get('role', 'user') == 'user'
        && after.profile.name == before.name
        && after.profile.email == before.email
        && after.profile.get('birthDate', null) == before.get('birthDate', null)
        && after.profile.get('photoURL', null) == before.get('photoURL', null)
        && after.preferences.language == before.get('language', 'pt-BR')
        && after.preferences.units == 'system'
        && after.preferences.theme == 'dark'
        && after.subscription.get('status', null) == before.get('subscriptionStatus', null)
        && after.subscription.get('provider', null) == before.get('subscriptionProvider', null)
        && after.subscription.get('trialEndsAt', null) == before.get('trialEndsAt', null)
        // Campo renomeado `endsAt` → `currentPeriodEndsAt` na Sprint 3.5 para
        // casar com docs/13 §26; o nome plano ANTIGO (`subscriptionEndsAt`)
        // não muda — é uma leitura única do documento legado, não parte do
        // schema novo.
        && after.subscription.get('currentPeriodEndsAt', null) == before.get('subscriptionEndsAt', null)
        && after.metadata.role == before.get('role', 'user')
        && after.metadata.get('activeWorkoutId', null) == before.get('activeWorkoutId', null)
        && after.metadata.createdAt == before.createdAt
        && after.metadata.updatedAt == request.time;
    }

    // Avaliações físicas (docs/03 §4/§8, docs/15 §10/§11/§18). `source` é um
    // discriminador: guided exige os campos da calculadora (protocol, sex,
    // age, folds, bodyFat, calculatorVersion); imported não exige nenhum
    // deles e pode não ter bodyFat (campo simplesmente ausente — nunca 0).
    // Campos derivados (bmi, leanMass, fatMass, sumFolds, bodyDensity) e o
    // rótulo do protocolo nunca são aceitos: são resolvidos em tempo de
    // leitura no app (src/lib/skinfoldCalculator.ts), nunca persistidos.
    function assessmentCommonValid() {
      let d = request.resource.data;
      return d.source in ['guided', 'imported']
        && d.measuredAt is timestamp
        && d.measuredAt <= request.time
        // `== request.time` (not just `is timestamp`) forces the client to
        // have actually used serverTimestamp() — a client can't fabricate an
        // arbitrary createdAt to game the measuredAt/createdAt tie-break sort.
        && d.createdAt == request.time
        && d.weight is number && d.weight > 0
        && d.height is number && d.height > 0
        && (!('notes' in d) || d.notes is string);
    }

    function guidedAssessmentValid() {
      let d = request.resource.data;
      return d.source == 'guided'
        && d.keys().hasOnly([
             'source', 'measuredAt', 'createdAt', 'weight', 'height', 'bodyFat',
             'calculatorVersion', 'notes', 'protocol', 'sex', 'age', 'folds'
           ])
        && d.calculatorVersion == 1
        && d.protocol in ['jp3', 'jp7']
        && d.sex in ['m', 'f']
        && d.age is number && d.age > 0
        && d.bodyFat is number && d.bodyFat > 0
        && d.folds is map && d.folds.size() > 0;
    }

    function importedAssessmentValid() {
      let d = request.resource.data;
      return d.source == 'imported'
        && d.keys().hasOnly([
             'source', 'measuredAt', 'createdAt', 'weight', 'height', 'bodyFat',
             'notes', 'bodyWater', 'basalMetabolism', 'visceralFat'
           ])
        && (!('bodyFat' in d) || (d.bodyFat is number && d.bodyFat > 0))
        && (!('bodyWater' in d) || (d.bodyWater is number && d.bodyWater > 0))
        && (!('basalMetabolism' in d) || (d.basalMetabolism is number && d.basalMetabolism > 0))
        && (!('visceralFat' in d) || (d.visceralFat is number && d.visceralFat > 0));
    }

    // ── Photo Vault (docs/20_backend_functions_photo_vault.md) ────────────
    // Metadados das fotos privadas. A imagem NUNCA é gravada aqui: o binário
    // vive criptografado no Storage e este documento guarda apenas o ponteiro
    // e os parâmetros criptográficos necessários para decifrar. Não existe
    // downloadURL nem signed URL persistida — o caminho é resolvido pelo SDK
    // a partir de `storagePath`, sempre sujeito às Storage Rules.
    function encryptionMetadataValid(e) {
      return e is map
        && e.keys().hasAll(['version', 'algorithm', 'iv', 'vaultKeyVersion'])
        && e.keys().hasOnly(['version', 'algorithm', 'iv', 'vaultKeyVersion'])
        && e.version is int && e.version >= 1
        && e.algorithm == 'AES-256-GCM'
        // IV/nonce em base64. Não é segredo (é público por design no GCM),
        // mas precisa ser único por foto — a unicidade é responsabilidade do
        // cliente, as regras só garantem forma e tamanho plausíveis.
        && e.iv is string && e.iv.size() >= 16 && e.iv.size() <= 32
        && e.vaultKeyVersion is int && e.vaultKeyVersion >= 1;
    }

    // Caminho canônico de um objeto do Vault. `assetKey` identifica o ARQUIVO,
    // que nem sempre é o id do documento — ver as três formas abaixo.
    // Igualdade exata de string (não regex): prende o metadado a um único
    // objeto do Storage, no namespace do próprio dono. Impede apontar para o
    // arquivo de outro uid.
    function vaultAssetPath(userId, assetKey, suffix) {
      return 'users/' + userId + '/progressPhotos/' + assetKey + suffix;
    }

    function thumbnailFieldsValid(userId, assetKey) {
      let d = request.resource.data;
      return d.thumbnailStoragePath == vaultAssetPath(userId, assetKey, '.thumb.enc')
        && d.thumbnailEncryptedSize is int
        && d.thumbnailEncryptedSize > 0
        && d.thumbnailEncryptedSize <= 512 * 1024
        && encryptionMetadataValid(d.thumbnailEncryption)
        // Same Vault Key is intentional; nonce reuse under AES-GCM is not.
        && d.thumbnailEncryption.iv != d.encryption.iv;
    }

    function twoDigits(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }

    // Último dia de calendário que um cliente pode reivindicar.
    //
    // Um dia de folga cobre quem está num fuso à frente do UTC (até +14), já
    // que `dateKey` é o dia LOCAL do usuário e as regras não têm como conhecer
    // esse fuso. Como `YYYY-MM-DD` é zero-padded, a comparação lexicográfica
    // equivale à cronológica.
    //
    // Deliberadamente NÃO existe limite inferior: `takenAt` pode vir do EXIF,
    // então uma foto escolhida da galeria legitimamente pertence a qualquer dia
    // passado. Uma janela simétrica rejeitaria upload legítimo de foto antiga.
    function maxDateKey() {
      let bound = request.time + duration.value(1, 'd');
      return string(bound.year())
        + '-' + twoDigits(bound.month())
        + '-' + twoDigits(bound.day());
    }

    // Mesmo formato de UUID já aplicado pelo backend em
    // functions/src/photoVault/orphanPolicy.ts. As Rules não importam código,
    // então o padrão é espelhado de propósito; manter os dois em sincronia.
    function isVaultUuid(value) {
      return value is string
        && value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function progressPhotoValid(userId, photoId) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'storagePath', 'createdAt', 'takenAt', 'originalMimeType',
          'encryptedSize', 'encryption'
        ])
        // Três formas coexistem e NENHUMA é migrada:
        //
        //   A) legacy  — seis campos, sem thumbnail; documento nomeado pelo
        //                próprio asset;
        //   B) fase 13 — acrescenta os três campos de thumbnail atomicamente;
        //                documento ainda nomeado pelo asset;
        //   C) pose    — acrescenta assetId/dateKey/pose. O documento passa a
        //                se chamar `{dateKey}_{pose}`, de modo que o próprio
        //                Firestore garante no máximo uma foto por pose por dia
        //                (create só dispara em documento inexistente, e update
        //                está proibido). O ARQUIVO continua identificado por
        //                UUID opaco em `assetId`, para não vazar dia/pose nos
        //                nomes de objeto do Storage.
        //
        // As formas são mutuamente exclusivas por construção: cada `hasOnly`
        // rejeita os campos exclusivos das outras. Metadata parcial de
        // thumbnail e campos desconhecidos seguem rejeitados.
        && (
          (
            d.keys().hasOnly([
              'storagePath', 'createdAt', 'takenAt', 'originalMimeType',
              'encryptedSize', 'encryption'
            ])
            && d.storagePath == vaultAssetPath(userId, photoId, '.enc')
          )
          || (
            d.keys().hasAll([
              'thumbnailStoragePath', 'thumbnailEncryptedSize',
              'thumbnailEncryption'
            ])
            && d.keys().hasOnly([
              'storagePath', 'thumbnailStoragePath', 'createdAt', 'takenAt',
              'originalMimeType', 'encryptedSize', 'thumbnailEncryptedSize',
              'encryption', 'thumbnailEncryption'
            ])
            && d.storagePath == vaultAssetPath(userId, photoId, '.enc')
            && thumbnailFieldsValid(userId, photoId)
          )
          || (
            d.keys().hasAll([
              'thumbnailStoragePath', 'thumbnailEncryptedSize',
              'thumbnailEncryption', 'assetId', 'dateKey', 'pose'
            ])
            && d.keys().hasOnly([
              'storagePath', 'thumbnailStoragePath', 'assetId', 'dateKey', 'pose',
              'createdAt', 'takenAt', 'originalMimeType', 'encryptedSize',
              'thumbnailEncryptedSize', 'encryption', 'thumbnailEncryption'
            ])
            && isVaultUuid(d.assetId)
            // Enum fechado. Fotos antigas NÃO recebem pose: a ausência do
            // campo é o que identifica um registro pré-pose, então não existe
            // um quarto valor "unknown" persistido.
            && d.pose in ['front', 'side', 'back']
            && d.dateKey is string
            && d.dateKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && d.dateKey <= maxDateKey()
            // O id do documento É a chave de unicidade (dia + pose).
            && photoId == d.dateKey + '_' + d.pose
            // O arquivo é endereçado pelo assetId, não pelo id do documento.
            && d.storagePath == vaultAssetPath(userId, d.assetId, '.enc')
            && thumbnailFieldsValid(userId, d.assetId)
          )
        )
        // `== request.time` (e não apenas `is timestamp`) força o uso de
        // serverTimestamp() — o cliente não forja a data de criação.
        && d.createdAt == request.time
        // Sem piso: uma foto da galeria pode ser antiga por definição.
        && d.takenAt is timestamp
        && d.takenAt <= request.time
        && d.originalMimeType in ['image/jpeg', 'image/png', 'image/heic', 'image/heif', 'image/webp']
        && d.encryptedSize is int
        && d.encryptedSize > 0
        && d.encryptedSize <= 10 * 1024 * 1024
        && encryptionMetadataValid(d.encryption);
    }

    function supportTicketValid(ticketId) {
      let d = request.resource.data;
      return d.keys().hasAll([
          'id', 'userId', 'userName', 'userEmail', 'type', 'subject', 'status',
          'priority', 'lastMessage', 'createdAt', 'updatedAt', 'appVersion',
          'platform', 'osVersion', 'deviceModel', 'language', 'attachmentsCount'
        ])
        && d.keys().hasOnly([
          'id', 'userId', 'userName', 'userEmail', 'type', 'subject', 'status',
          'priority', 'lastMessage', 'createdAt', 'updatedAt', 'appVersion',
          'platform', 'osVersion', 'deviceModel', 'language', 'attachmentsCount'
        ])
        && d.id == ticketId
        && d.userId == request.auth.uid
        && d.userName is string && d.userName.size() >= 2 && d.userName.size() <= 50
        && d.userEmail is string && d.userEmail.size() <= 254
        && d.type in ['BUG', 'FEEDBACK', 'SUPPORT']
        && d.subject is string && d.subject.size() >= 3 && d.subject.size() <= 100
        && d.status == 'OPEN'
        && d.priority == 'NORMAL'
        && d.lastMessage is string && d.lastMessage.size() >= 10 && d.lastMessage.size() <= 5000
        && d.createdAt == request.time && d.updatedAt == request.time
        && d.appVersion is string && d.platform in ['ios', 'android', 'web', 'windows', 'macos']
        && d.osVersion is string && d.deviceModel is string && d.language is string
        && d.attachmentsCount is int && d.attachmentsCount >= 0 && d.attachmentsCount <= 1;
    }

    function supportMessageValid(ticketId) {
      let d = request.resource.data;
      let ticket = getAfter(/databases/$(database)/documents/supportTickets/$(ticketId));
      return ticket.data.userId == request.auth.uid
        && d.keys().hasAll(['senderType', 'senderId', 'message', 'attachments', 'createdAt', 'readAt'])
        && d.keys().hasOnly(['senderType', 'senderId', 'message', 'attachments', 'createdAt', 'readAt'])
        && d.senderType == 'USER' && d.senderId == request.auth.uid
        && d.message is string && d.message.size() >= 1 && d.message.size() <= 5000
        && d.attachments is list && d.attachments.size() <= 1
        && ticket.data.attachmentsCount == d.attachments.size()
        && (d.attachments.size() == 0 || (
          d.attachments[0] is map
          && d.attachments[0].keys().hasAll(['url', 'path', 'type'])
          && d.attachments[0].keys().hasOnly(['url', 'path', 'type'])
          && d.attachments[0].url is string && d.attachments[0].url.size() <= 2048
          && d.attachments[0].path is string
          && d.attachments[0].path.matches('users/' + request.auth.uid + '/support/' + ticketId + '/attachments/.*')
          && d.attachments[0].type == 'IMAGE'
        ))
        && d.createdAt == request.time && d.readAt == null;
    }

    function adminSupportTicketUpdateValid() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasAll(['updatedAt'])
        && changed.hasOnly([
          'status', 'priority', 'assignedTo', 'lastMessage', 'updatedAt',
          'lastReplyAt', 'closedAt'
        ])
        && after.status in ['OPEN', 'IN_PROGRESS', 'WAITING_USER', 'RESOLVED', 'CLOSED']
        && after.priority in ['LOW', 'NORMAL', 'HIGH', 'CRITICAL']
        && after.updatedAt == request.time
        // O painel atual atribui somente ao próprio operador autenticado.
        && (!changed.hasAny(['assignedTo']) || after.assignedTo == request.auth.uid)
        // Fechar grava o timestamp do servidor; qualquer outro status limpa-o.
        && (!changed.hasAny(['status']) || (
          changed.hasAny(['closedAt'])
          && (after.status == 'CLOSED'
              ? after.closedAt == request.time
              : after.closedAt == null)
        ))
        && (!changed.hasAny(['closedAt']) || changed.hasAny(['status']))
        // Uma resposta atualiza preview e metadados em conjunto.
        && (!changed.hasAny(['lastMessage', 'lastReplyAt']) || (
          changed.hasAll(['lastMessage', 'lastReplyAt'])
          && after.lastMessage is string
          && after.lastMessage.size() >= 1
          && after.lastMessage.size() <= 5000
          && after.lastReplyAt == request.time
        ));
    }

    function adminSupportMessageValid(ticketId) {
      let d = request.resource.data;
      let ticket = getAfter(/databases/$(database)/documents/supportTickets/$(ticketId));
      return d.keys().hasAll([
          'senderType', 'senderId', 'message', 'attachments', 'createdAt', 'readAt'
        ])
        && d.keys().hasOnly([
          'senderType', 'senderId', 'message', 'attachments', 'createdAt', 'readAt'
        ])
        && d.senderType == 'ADMIN'
        && d.senderId == request.auth.uid
        && d.message is string && d.message.size() >= 1 && d.message.size() <= 5000
        && d.attachments is list && d.attachments.size() == 0
        && d.createdAt == request.time && d.readAt == null
        // Mantém mensagem e preview do ticket consistentes no mesmo batch.
        && ticket.data.lastMessage == d.message
        && ticket.data.updatedAt == request.time
        && ticket.data.lastReplyAt == request.time;
    }

    // ── Users, questionnaires and assessments ─────────────────────────────
    match /users/{userId} {
      // Leitura: apenas o dono do documento, e somente com a conta ativa
      // (Fase 5 — ver `accountActive` acima).
      allow read: if isOwner(userId) && accountActive(userId);

      // Criação: documento integralmente aninhado, com identidade coerente com
      // o token e sem campos de assinatura/internos definidos pelo cliente.
      // `attribution` nunca pode ser definido pelo cliente na criação —
      // `nestedUserValid` sozinho não bastaria aqui, porque ele aceita a
      // AUSÊNCIA do campo, não a proíbe: sem esta checagem extra, um cliente
      // malicioso poderia fabricar um `attribution` (com formato válido,
      // porém com um couponCode/influencerId arbitrário) no momento da
      // criação da conta, antes de qualquer validação server-side via
      // `validatePromoCode`.
      // Fase 5: também exige `accountActive(userId)` — sem isso, um token
      // ainda válido poderia RECRIAR o documento depois que
      // FIRESTORE_CLEANUP já o removeu, ressuscitando dados de perfil no
      // meio (ou depois) de uma exclusão em andamento.
      allow create: if isOwner(userId)
        && accountActive(userId)
        && nestedUserValid(request.resource.data)
        && !('attribution' in request.resource.data)
        && request.resource.data.metadata.role == 'user'
        && request.resource.data.profile.email == request.auth.token.email
        && request.resource.data.subscription.size() == 0
        && !('activeWorkoutId' in request.resource.data.metadata)
        && request.resource.data.metadata.createdAt == request.time
        && request.resource.data.metadata.updatedAt == request.time
        // Only `null` (pending) is ever client-writable — a client cannot
        // fabricate an already-resolved timestamp to skip its own initial
        // Paywall. Omitting the key entirely is also rejected here (unlike
        // `metadataValid`'s general tolerance for absence, which exists for
        // documents written before this field existed) — every document
        // `provisionNewUser` creates from now on writes it explicitly.
        && request.resource.data.metadata.commercialGateResolvedAt == null;

      // Atualização: apenas o dono e somente os campos editáveis do perfil.
      // `diff().affectedKeys().hasOnly` impede alterações em campos de conta,
      // assinatura, treino ou privilégios mesmo que novos campos sejam
      // adicionados ao documento no futuro.
      //
      // `preferences` é aceito no conjunto top-level mudável, mas dentro dele
      // apenas `preferences.language`, `preferences.units` e o mapa validado
      // `notificationPreferences` podem variar; `theme` segue protegido.
      // Escritas legítimas usam caminhos pontuados, preservando todas as
      // preferências irmãs.
      allow update: if isVerifiedOwner(userId) && accountActive(userId) && (
        legacyMigrationValid()
        || (
          nestedUserValid(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['profile', 'preferences', 'metadata'])
          && request.resource.data.profile.diff(resource.data.profile).affectedKeys()
               .hasOnly(['name', 'birthDate', 'photoURL', 'photoVersion', 'height'])
          && profilePhotoUpdateValid(resource.data.profile, request.resource.data.profile)
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['preferences'])
            || request.resource.data.preferences.diff(resource.data.preferences).affectedKeys()
                 .hasOnly(['language', 'units', 'notificationPreferences'])
          )
          && request.resource.data.metadata.updatedAt == request.time
          && request.resource.data.metadata.diff(resource.data.metadata).affectedKeys()
               .hasOnly(['updatedAt'])
        )
      );

      // Exclusão: negada ao cliente (remoção é processo de backend — 90 dias,
      // docs/12 §10). Somente o Admin SDK pode excluir.
      allow delete: if false;

      // Backend-maintained projection. It contains no raw token, but is
      // intentionally not a client API: sync/release happen only through
      // authenticated, App-Check-enforced callables.
      match /devices/{installationId} {
        allow read, write: if false;
      }

      // Questionários do usuário (inicial + reavaliações futuras).
      // Cada documento é um snapshot imutável.
      match /questionnaires/{questionnaireId} {
        // Leitura: apenas o dono do usuário pai, com a conta ativa (Fase 5).
        allow read: if isOwner(userId) && accountActive(userId);

        // Criação: apenas o dono, com os campos esperados e válidos.
        allow create: if isOwner(userId)
          && accountActive(userId)
          && (hasVerifiedEmailForPrivateAccess()
              || (!exists(/databases/$(database)/documents/users/$(userId))
                  && getAfter(/databases/$(database)/documents/users/$(userId)).data.profile.email
                       == request.auth.token.email))
          && request.resource.data.keys().hasOnly(
               ['answers', 'version', 'createdAt'])
          && request.resource.data.answers is map
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.createdAt is timestamp;

        // Histórico imutável: sem edição nem exclusão pelo cliente.
        allow update, delete: if false;
      }

      match /workoutPrograms/{programId} {
        allow read: if isOwner(userId) && accountActive(userId);

        // V2 (lifecycle-managed) content is backend-authoritative: a client
        // can only make this identity "live" by presenting the one-time
        // grant `authorizeWorkoutLifecycleMutation` already issued for THIS
        // exact contentIdentity, after the backend independently validated
        // it (assertPlanSafe) — never by satisfying structural shape alone
        // (docs/workout-lifecycle/v2/decisions/
        // ADR-016_BACKEND_AUTHORITATIVE_PRESCRIPTION.md). Legacy V1 (never
        // had a `workoutLifecycleState/current` document) is unaffected.
        //
        // The escape hatch below is gated on `existsAfter(workoutLifecycleState/
        // current)` — NOT on whether `workoutProgramState/active` happens to
        // carry a `programInstanceId` (Phase 10D fix: that was client-choosable
        // per write and let ANY user, not just genuine pre-V2 accounts, skip
        // the grant requirement simply by omitting an optional field —
        // docs/workout-lifecycle/v2/architecture/
        // 22_POST_PHASE_10C_FINAL_ADVERSARIAL_AUDIT.md Finding FS-RULES-BYPASS-01).
        // `workoutLifecycleState/current` can only ever be created under a
        // real authority grant (see its own `create` rule) and can never be
        // deleted (`allow delete: if false` below) — its existence is a
        // backend-controlled fact, not something a client can toggle per write.
        allow create: if isOwner(userId)
          && accountActive(userId)
          && workoutProgramCommonValid(userId, programId, request.resource.data)
          // Transitional rollout compatibility: the already-published app
          // may omit both fields; the new app always sends both, and any
          // supplied identity is required to equal the active dataset.
          && workoutProgramLimitationDatasetValid(request.resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.activatedAt == request.time
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutProgramState/active).data.programId == programId
          && (
               !existsAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current)
               || (consumesLifecycleAuthorityGrant(userId, ['INITIALIZE', 'MIGRATE', 'ACTIVATE', 'ADAPT', 'RECOVER'])
                   && lifecycleAuthorityGrant(userId).targetContentIdentity == programId)
             );

        // Phase 10E fix: `create` was hardened in Phase 10D (existsAfter-gated
        // grant requirement above), but `update` — the path a reactivation of
        // a previously-superseded, content-addressed `workoutPrograms` doc
        // takes (`transaction.update` in `saveAndActivateWorkoutProgram` when
        // `targetSnapshot.exists()`) — had NO grant requirement at all. A V2
        // owner could flip a stale doc's `status` back to `active` and
        // repoint `workoutProgramState/active` at it with zero authorization
        // (docs/workout-lifecycle/v2/architecture/
        // 26_FINAL_INDEPENDENT_ADVERSARIAL_AUDIT_2.md §48). Bounded impact —
        // `workoutLifecycleState/current` remained the real authority, so
        // progression/adherence/execution were never affected — but this
        // closes the display/content-drift gap structurally, the same way
        // the `create` fix did: gated on `existsAfter(workoutLifecycleState/
        // current)`, never on a client-omittable field.
        allow update: if isOwner(userId)
          && accountActive(userId)
          && (workoutProgramCommonValid(userId, programId, request.resource.data)
              // A v1.3 snapshot may need to be superseded after the single
              // template document has been upgraded to v2. Its immutable
              // prescription fields are protected by the diff below; do not
              // revalidate them against today's replaced template document.
              || resource.data.versions.templateLibrary == '1.3.0')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'activatedAt', 'updatedAt'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && (
               !existsAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current)
               || consumesLifecycleAuthorityGrant(userId, ['INITIALIZE', 'MIGRATE', 'ACTIVATE', 'ADAPT', 'RECOVER'])
             )
          && (
            (request.resource.data.status == 'active'
              && (request.resource.data.activatedAt == request.time
                  || request.resource.data.activatedAt == resource.data.activatedAt)
              && getAfter(/databases/$(database)/documents/users/$(userId)/workoutProgramState/active).data.programId == programId
              && (
                   !existsAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current)
                   || lifecycleAuthorityGrant(userId).targetContentIdentity == programId
                 ))
            ||
            (request.resource.data.status == 'superseded'
              && request.resource.data.activatedAt == resource.data.activatedAt
              && getAfter(/databases/$(database)/documents/users/$(userId)/workoutProgramState/active).data.programId != programId)
          );

        allow delete: if false;

        // Runtime schedule cursor for THIS program only — never carried over
        // to a new program (docs/workout-lifecycle/03_SCHEDULE_ENGINE.md
        // §Troca de programa). Single fixed id 'current', same pattern as
        // workoutProgramState/active above.
        match /scheduleState/{stateId} {
          allow read: if isOwner(userId)
            && accountActive(userId)
            && (stateId == 'current'
                || get(/databases/$(database)/documents/users/$(userId)/programInstances/$(stateId)).data.contentIdentity == programId);
          // Phase 10E fix: `programInstanceId` presence used to be optional
          // (`!('programInstanceId' in data) || (...)`) — the same shape that
          // caused FS-RULES-BYPASS-01. Omitting the field let a client target
          // the dead-for-V2 `scheduleState/current` doc-id with no identity
          // check at all. For any V2 account the field is now MANDATORY and
          // must match `stateId`, gated on the backend-controlled fact
          // `existsAfter(workoutLifecycleState/current)` — never on whether
          // the client chose to send the field (docs/workout-lifecycle/v2/
          // architecture/26_FINAL_INDEPENDENT_ADVERSARIAL_AUDIT_2.md §49).
          // Bootstrap create still needs no grant (fresh rotation state, no
          // position to protect yet — see the update rule's own comment for
          // why that remains safe), but it can no longer skip the identity
          // check by omitting the field.
          allow create: if isOwner(userId)
            && accountActive(userId)
            && (stateId == 'current' || stateId == request.resource.data.get('programInstanceId', ''))
            && request.resource.data.keys().hasAll(
                 ['programId', 'nextSessionIndex', 'cursorDate', 'lastCompletedAt', 'pendingMissDecision', 'updatedAt'])
            && request.resource.data.keys().hasOnly(
                 ['programId', 'programInstanceId', 'nextSessionIndex', 'cursorDate', 'lastCompletedAt', 'pendingMissDecision', 'updatedAt'])
            && request.resource.data.programId == programId
            && (
                 !existsAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current)
                 || (
                      'programInstanceId' in request.resource.data
                      && request.resource.data.programInstanceId == stateId
                      && get(/databases/$(database)/documents/users/$(userId)/programInstances/$(stateId)).data.contentIdentity == programId
                    )
               )
            && request.resource.data.nextSessionIndex is int
            && request.resource.data.nextSessionIndex >= 0
            && request.resource.data.cursorDate is string
            && request.resource.data.updatedAt == request.time;

          // Update: a write that keeps the rotation position (nextSessionIndex
          // + cursorDate) unchanged is bookkeeping only (e.g. recording a
          // newly-detected miss's pendingMissDecision) and stays ungated. A
          // write that actually ADVANCES the rotation for a V2 program must
          // be exactly the target the backend already computed and bound to
          // a one-time grant (docs §Scheduled Opportunity Integrity) — the
          // client can no longer self-select a favorable next session, and
          // (Phase 10E) can no longer skip this requirement by omitting
          // `programInstanceId` for a V2 account.
          allow update: if isOwner(userId)
            && accountActive(userId)
            && (stateId == 'current' || stateId == request.resource.data.get('programInstanceId', ''))
            && request.resource.data.keys().hasAll(
                 ['programId', 'nextSessionIndex', 'cursorDate', 'lastCompletedAt', 'pendingMissDecision', 'updatedAt'])
            && request.resource.data.keys().hasOnly(
                 ['programId', 'programInstanceId', 'nextSessionIndex', 'cursorDate', 'lastCompletedAt', 'pendingMissDecision', 'updatedAt'])
            && request.resource.data.programId == programId
            && (
                 !existsAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current)
                 || (
                      'programInstanceId' in request.resource.data
                      && request.resource.data.programInstanceId == stateId
                      && get(/databases/$(database)/documents/users/$(userId)/programInstances/$(stateId)).data.contentIdentity == programId
                    )
               )
            && request.resource.data.nextSessionIndex is int
            && request.resource.data.nextSessionIndex >= 0
            && request.resource.data.cursorDate is string
            && request.resource.data.updatedAt == request.time
            // Legacy V1 has no grant system at all — its rotation legitimately
            // advances via a direct, ungated write (`src/services/
            // workoutSchedule.ts`, no `programInstanceId`/grant involved).
            // That path is preserved by the same backend-controlled
            // `!existsAfter(workoutLifecycleState/current)` boundary used
            // above and everywhere else in this phase's fix — never by a
            // client-omittable field. For V2, only a same-position bookkeeping
            // write or a real grant-bound advance is allowed.
            && (
                 !existsAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current)
                 || (request.resource.data.nextSessionIndex == resource.data.nextSessionIndex
                     && request.resource.data.cursorDate == resource.data.cursorDate)
                 || (consumesLifecycleAuthorityGrant(userId, ['COMPLETE_SCHEDULE', 'RESOLVE_MISSED_SESSION'])
                     && lifecycleAuthorityGrant(userId).sourceProgramInstanceId == request.resource.data.programInstanceId
                     && lifecycleAuthorityGrant(userId).targetNextSessionIndex == request.resource.data.nextSessionIndex
                     && lifecycleAuthorityGrant(userId).targetCursorDate == request.resource.data.cursorDate)
               );
          allow delete: if false;
        }

        // Immutable schedule ledger (COMPLETED/SKIPPED/MISS_RESOLVED) — never
        // edited or deleted by the client (docs §44 Event ledger, §48
        // Imutabilidade). Client-authorized like the rest of this program:
        // ownership is the path, not a payload field.
        match /scheduleEvents/{eventId} {
          allow read: if isOwner(userId) && accountActive(userId);
          // Phase 10E fix: the grant requirement used to be skipped entirely
          // whenever the client omitted `programInstanceId` from the payload
          // (`!request.resource.data.keys().hasAny(['programInstanceId'])`) —
          // the same FS-RULES-BYPASS-01 shape, letting a V2 owner write a
          // grant-free COMPLETED/SKIPPED/MISS_RESOLVED ledger entry (docs/
          // workout-lifecycle/v2/architecture/
          // 26_FINAL_INDEPENDENT_ADVERSARIAL_AUDIT_2.md §49). Traced this
          // pass to a conclusive NON_EXPLOITABLE-for-progression verdict
          // (see 27_PHASE_10E_FINAL_STAGED_ROLLOUT_CLOSURE.md §9): the
          // backend's `authoritativeEarnedFact` only ever reads `COMPLETED`
          // events filtered by exact `programInstanceId` equality — an
          // omitted (`undefined`) field can never match a real instance id —
          // and SKIPPED/MISS_RESOLVED events are never read by the backend
          // authority at all. Still fixed structurally regardless, per this
          // phase's explicit instruction not to leave security depending on
          // an optional field: legacy V1 (no `workoutLifecycleState/current`)
          // keeps its ungated write; V2 now always requires the matching
          // grant.
          allow create: if isOwner(userId)
            && accountActive(userId)
            && request.resource.data.keys().hasAll(['type', 'sessionIndex', 'scheduledDate', 'occurredAt'])
            && request.resource.data.keys().hasOnly(
                 ['type', 'sessionIndex', 'scheduledDate', 'occurredAt', 'reasonCode', 'decision', 'programInstanceId'])
            && request.resource.data.type in ['COMPLETED', 'SKIPPED', 'MISS_RESOLVED']
            && (
                 !existsAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current)
                 || (request.resource.data.type == 'COMPLETED'
                   && consumesLifecycleAuthorityGrant(userId, ['COMPLETE_SCHEDULE'])
                   && lifecycleAuthorityGrant(userId).sourceProgramInstanceId == request.resource.data.programInstanceId
                   && lifecycleAuthorityGrant(userId).sessionIndex == request.resource.data.sessionIndex
                   && lifecycleAuthorityGrant(userId).scheduledLocalDate == request.resource.data.scheduledDate)
                 || (request.resource.data.type in ['SKIPPED', 'MISS_RESOLVED']
                   && consumesLifecycleAuthorityGrant(userId, ['RESOLVE_MISSED_SESSION'])
                   && lifecycleAuthorityGrant(userId).sourceProgramInstanceId == request.resource.data.programInstanceId
                   && lifecycleAuthorityGrant(userId).targetScheduleEvents.hasAny([{
                        'type': request.resource.data.type,
                        'sessionIndex': request.resource.data.sessionIndex,
                        'scheduledDate': request.resource.data.scheduledDate,
                      }]))
               )
            && request.resource.data.sessionIndex is int
            && request.resource.data.sessionIndex >= 0
            && request.resource.data.scheduledDate is string
            && (!('programInstanceId' in request.resource.data)
                || get(/databases/$(database)/documents/users/$(userId)/programInstances/$(request.resource.data.programInstanceId)).data.contentIdentity == programId)
            && request.resource.data.occurredAt == request.time;
          allow update, delete: if false;
        }

        // Progression Engine V1 (docs/workout-lifecycle/
        // 04_PROGRESSION_ENGINE.md). Immutable audit ledger of transitions
        // AWAY FROM this program — nested under the FROM program so it
        // survives being superseded. `toProgramId` may equal this same
        // `programId` for a NORMAL_ROTATION renewal-in-place (no real
        // template alternative exists — docs §40/§41).
        match /progressionEvents/{eventId} {
          allow read: if isOwner(userId) && accountActive(userId);
          allow create: if isOwner(userId)
            && accountActive(userId)
            && request.resource.data.keys().hasAll(
                 ['type', 'toProgramId', 'fromStage', 'toStage', 'reason', 'occurredAt', 'progressionEngineVersion'])
            && request.resource.data.keys().hasOnly(
                 ['type', 'toProgramId', 'fromStage', 'toStage', 'reason', 'occurredAt', 'progressionEngineVersion'])
            && request.resource.data.type in ['BEGINNER_STAGE_TRANSITION', 'NORMAL_ROTATION']
            && request.resource.data.toProgramId is string
            && (request.resource.data.fromStage == null || request.resource.data.fromStage in [1, 2, 3])
            && (request.resource.data.toStage == null || request.resource.data.toStage in [1, 2, 3])
            && request.resource.data.reason is string
            && request.resource.data.occurredAt == request.time
            && request.resource.data.progressionEngineVersion is int
            && request.resource.data.progressionEngineVersion >= 1;
          allow update, delete: if false;
        }
      }

      // Single fixed-id pointer document; direct lookup, no status query or
      // composite index. It moves atomically with program lifecycle writes.
      // `scheduleConfig` is a second fixed id in this same collection: the
      // Schedule Engine's trainingDays/timezone preference. It is a *user*
      // preference, not program-scoped (docs/workout-lifecycle/
      // 03_SCHEDULE_ENGINE.md §Alteração dos dias) — it survives program
      // regeneration, unlike `scheduleState` below.
      match /workoutProgramState/{stateId} {
        allow read: if isOwner(userId) && accountActive(userId)
          && (stateId == 'active' || stateId == 'scheduleConfig');
        allow create: if isOwner(userId)
          && accountActive(userId)
          && stateId == 'active'
          && request.resource.data.keys().hasAll(['programId', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['programId', 'programInstanceId', 'updatedAt'])
          && request.resource.data.programId is string
          && request.resource.data.updatedAt == request.time
          && (!('programInstanceId' in request.resource.data)
              || getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.activeProgramInstanceId == request.resource.data.programInstanceId)
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutPrograms/$(request.resource.data.programId)).data.status == 'active';
        allow update: if isOwner(userId)
          && accountActive(userId)
          && stateId == 'active'
          && request.resource.data.keys().hasAll(['programId', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['programId', 'programInstanceId', 'updatedAt'])
          && request.resource.data.programId is string
          && request.resource.data.updatedAt == request.time
          && (!('programInstanceId' in request.resource.data)
              || getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.activeProgramInstanceId == request.resource.data.programInstanceId)
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutPrograms/$(request.resource.data.programId)).data.status == 'active'
          && (resource.data.programId == request.resource.data.programId
              || getAfter(/databases/$(database)/documents/users/$(userId)/workoutPrograms/$(resource.data.programId)).data.status == 'superseded');
        allow create, update: if isOwner(userId)
          && accountActive(userId)
          && stateId == 'scheduleConfig'
          && request.resource.data.keys().hasAll(['trainingDays', 'timezone', 'scheduleVersion', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['trainingDays', 'timezone', 'scheduleVersion', 'updatedAt'])
          && request.resource.data.trainingDays is list
          && request.resource.data.trainingDays.size() >= 2
          && request.resource.data.trainingDays.size() <= 7
          && request.resource.data.timezone is string
          && request.resource.data.timezone.size() > 0
          && request.resource.data.scheduleVersion is int
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // Workout Lifecycle V2 authoritative current state. The original
      // questionnaire is immutable and never becomes the mutable level
      // source of truth.
      function prescriptionInputSnapshotValid(snapshot) {
        return snapshot is map
          && snapshot.keys().hasAll(['snapshotId', 'schemaVersion', 'source', 'inputs'])
          && snapshot.keys().hasOnly(['snapshotId', 'schemaVersion', 'source', 'inputs'])
          && snapshot.snapshotId is string
          && snapshot.schemaVersion == 1
          && snapshot.source in [
               'QUESTIONNAIRE_BASELINE', 'PROGRAM_ADAPTATION',
               'LEVEL_PROMOTION', 'CYCLE_EVOLUTION', 'MOTIVATIONAL_RENEWAL']
          && snapshot.inputs is map
          && snapshot.inputs.keys().hasAll([
               'sex', 'goal', 'level', 'limits', 'duration', 'days',
               'trainingDays', 'place', 'primaryPlace', 'equipment', 'style',
               'muscleFocus', 'specialConditions', 'pregnancyScreening',
               'postpartumScreening', 'functionalScreening',
               'lipedemaScreening', 'dizzinessScreening',
               'postSurgicalScreening', 'medicalRestrictionScreening'])
          && snapshot.inputs.keys().hasOnly([
               'sex', 'goal', 'level', 'limits', 'duration', 'days',
               'trainingDays', 'place', 'primaryPlace', 'equipment', 'style',
               'muscleFocus', 'specialConditions', 'pregnancyScreening',
               'postpartumScreening', 'functionalScreening',
               'lipedemaScreening', 'dizzinessScreening',
               'postSurgicalScreening', 'medicalRestrictionScreening'])
          && snapshot.inputs.level in ['beginner', 'intermediate', 'advanced']
          && snapshot.inputs.limits is list
          && snapshot.inputs.equipment is list
          && snapshot.inputs.style is list
          && snapshot.inputs.muscleFocus is list
          && snapshot.inputs.specialConditions is list
          && (snapshot.inputs.trainingDays == null || snapshot.inputs.trainingDays is list);
      }

      function lifecycleLevelTransitionValid(from, to) {
        return from == to
          || (from == 'BEGINNER' && to == 'INTERMEDIATE')
          || (from == 'INTERMEDIATE' && to == 'ADVANCED');
      }

      function lifecycleAuthorityGrantPath(userId) {
        return /databases/$(database)/documents/users/$(userId)/workoutLifecycleAuthorityGrants/current;
      }

      function lifecycleAuthorityGrant(userId) {
        return get(lifecycleAuthorityGrantPath(userId)).data;
      }

      function consumesLifecycleAuthorityGrant(userId, operations) {
        return exists(lifecycleAuthorityGrantPath(userId))
          && lifecycleAuthorityGrant(userId).uid == userId
          && lifecycleAuthorityGrant(userId).schemaVersion == 1
          && lifecycleAuthorityGrant(userId).operation in operations
          && lifecycleAuthorityGrant(userId).expiresAt is timestamp
          && lifecycleAuthorityGrant(userId).expiresAt >= request.time
          && !existsAfter(lifecycleAuthorityGrantPath(userId));
      }

      // Hot path for WorkoutExecution V2 terminalization. The generic helper
      // above intentionally supports several operations and its callers then
      // perform their own target checks. A finish validates only one operation
      // and one execution id, so bind the path/document once and perform the
      // complete replay-safe check here. This is semantically identical but
      // stays below Firestore's expression ceiling when combined with a real
      // multi-exercise execution update and mutex deletion.
      function consumesFinishExecutionAuthorityGrant(userId, executionId) {
        let grantPath = lifecycleAuthorityGrantPath(userId);
        let grant = get(grantPath).data;
        return exists(grantPath)
          && grant.uid == userId
          && grant.schemaVersion == 1
          && grant.operation == 'FINISH_EXECUTION'
          && grant.executionId == executionId
          && grant.expiresAt is timestamp
          && grant.expiresAt >= request.time
          && !existsAfter(grantPath);
      }

      function grantSourceMatches(userId, cycleId, programInstanceId) {
        return lifecycleAuthorityGrant(userId).sourceCycleId == cycleId
          && lifecycleAuthorityGrant(userId).sourceProgramInstanceId == programInstanceId;
      }

      function grantTargetMatches(userId, cycleId, programInstanceId) {
        return lifecycleAuthorityGrant(userId).targetCycleId == cycleId
          && lifecycleAuthorityGrant(userId).targetProgramInstanceId == programInstanceId;
      }

      function questionnaireLevelMatches(userId, programInstanceId, level) {
        let instance = getAfter(/databases/$(database)/documents/users/$(userId)/programInstances/$(programInstanceId)).data;
        let questionnaire = getAfter(/databases/$(database)/documents/users/$(userId)/questionnaires/$(instance.questionnaireId)).data;
        return (level == 'BEGINNER' && questionnaire.answers.level in ['never_or_starting', 'beginner', 'beg'])
          || (level == 'INTERMEDIATE' && questionnaire.answers.level in ['intermediate', 'int'])
          || (level == 'ADVANCED' && questionnaire.answers.level in ['advanced', 'adv', 'elite']);
      }

      // This is deliberately a bounded structural/relationship boundary,
      // not a second prescription engine. It prevents an owner from storing
      // an arbitrary map while the application remains responsible for the
      // deep exercise/safety semantics.
      function pendingPlanValid(data) {
        let plan = data.plan;
        return plan is map
          && plan.keys().hasAll([
               'planId', 'templateId', 'requestedDays', 'prescribedStructuredDays',
               'population', 'environment', 'goalFamily', 'split',
               'limitationDatasetVersion', 'limitationDatasetHash', 'sessions',
               'versions', 'trace'])
          && plan.keys().hasOnly([
               'planId', 'templateId', 'requestedDays', 'prescribedStructuredDays',
               'prescribedTrainingFrequency', 'availability', 'weeklySchedule',
               'population', 'environment', 'goalFamily', 'split', 'adaptationStage',
               'limitationDatasetVersion', 'limitationDatasetHash', 'sessions',
               'versions', 'trace'])
          && plan.planId == data.targetPrescriptionIdentity
          && plan.templateId == data.targetTemplateId
          && plan.requestedDays is int && plan.requestedDays >= 1 && plan.requestedDays <= 7
          && plan.prescribedStructuredDays is int
          && plan.prescribedStructuredDays >= 1 && plan.prescribedStructuredDays <= 7
          && plan.sessions is list && plan.sessions.size() >= 1 && plan.sessions.size() <= 7
          && plan.versions is map && plan.trace is map
          && plan.limitationDatasetVersion is string
          && plan.limitationDatasetHash is string && plan.limitationDatasetHash.size() == 64;
      }

      function lifecycleEventPayloadValid(data) {
        let payload = data.payload;
        return payload is map && (
          (data.type == 'PROGRAM_STARTED'
            && ((payload.keys().hasOnly(['activationReason']) && payload.activationReason is string)
              || (payload.keys().hasOnly(['source']) && payload.source is string)))
          || (data.type == 'PROGRAM_ADAPTED'
            && payload.keys().hasOnly(['source', 'reason'])
            && payload.source == 'program_adaptation'
            && payload.reason in ['AVAILABILITY', 'GOAL', 'ENVIRONMENT', 'LIMITATION', 'PREFERENCE'])
          || (data.type in ['EVOLUTION_EARNED', 'MOTIVATIONAL_RENEWAL_OFFERED']
            && payload.keys().hasOnly([
                 'evolutionType', 'quality', 'fromLevel', 'toLevel',
                 'sessionsCompletedAtEarn', 'adherenceAtEarnBp'])
            && payload.evolutionType in ['CYCLE_EVOLUTION', 'LEVEL_PROMOTION', 'MOTIVATIONAL_RENEWAL']
            && payload.quality in ['BELOW_TARGET', 'GOOD', 'HIGH']
            && payload.fromLevel in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED']
            && payload.toLevel in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED']
            && lifecycleLevelTransitionValid(payload.fromLevel, payload.toLevel)
            && payload.sessionsCompletedAtEarn is int && payload.sessionsCompletedAtEarn >= 0
            && payload.adherenceAtEarnBp is int
            && payload.adherenceAtEarnBp >= 0 && payload.adherenceAtEarnBp <= 10000)
          || (data.type == 'EVOLUTION_DEFERRED'
            && payload.keys().hasOnly(['deferralCount', 'nextPromptAtMs', 'autoActivateAtMs'])
            && payload.deferralCount in [1, 2]
            && (payload.nextPromptAtMs == null || payload.nextPromptAtMs is int)
            && (payload.autoActivateAtMs == null || payload.autoActivateAtMs is int))
          || (data.type in ['EVOLUTION_ACTIVATED', 'LEVEL_PROMOTED', 'MOTIVATIONAL_RENEWAL_ACTIVATED']
            && payload.keys().hasOnly(['source', 'evolutionType', 'quality', 'trigger'])
            && payload.source == 'evolution_activation'
            && payload.evolutionType in ['CYCLE_EVOLUTION', 'LEVEL_PROMOTION', 'MOTIVATIONAL_RENEWAL']
            && payload.quality in ['BELOW_TARGET', 'GOOD', 'HIGH']
            && payload.trigger in ['MANUAL', 'AUTO']
            && (data.type != 'LEVEL_PROMOTED' || payload.evolutionType == 'LEVEL_PROMOTION')
            && (data.type != 'MOTIVATIONAL_RENEWAL_ACTIVATED' || payload.evolutionType == 'MOTIVATIONAL_RENEWAL'))
          || (data.type in ['CYCLE_STARTED', 'CYCLE_ELIGIBLE', 'CYCLE_COMPLETED', 'EVOLUTION_ELIGIBLE']
            && payload.keys().size() == 0)
        );
      }

      match /workoutLifecycleState/{stateId} {
        allow read: if isOwner(userId) && accountActive(userId) && stateId == 'current';
        allow create: if isOwner(userId)
          && accountActive(userId)
          && consumesLifecycleAuthorityGrant(userId, ['INITIALIZE', 'MIGRATE', 'RECOVER'])
          && grantTargetMatches(userId, request.resource.data.currentCycleId, request.resource.data.activeProgramInstanceId)
          && stateId == 'current'
          && request.resource.data.keys().hasAll([
               'startingLevel', 'currentTrainingLevel', 'currentCycleId',
               'currentCycleNumber', 'activeProgramInstanceId',
               'activeContentIdentity', 'activePrescriptionIdentity',
               'initializationOrigin', 'historyCompleteFrom', 'schemaVersion',
               'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
               'startingLevel', 'currentTrainingLevel', 'currentCycleId',
               'currentCycleNumber', 'activeProgramInstanceId',
               'activeContentIdentity', 'activePrescriptionIdentity',
               'initializationOrigin', 'historyCompleteFrom', 'schemaVersion',
               'createdAt', 'updatedAt'])
          && request.resource.data.startingLevel in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED']
          && request.resource.data.currentTrainingLevel in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED']
          && request.resource.data.currentCycleNumber is int
          && request.resource.data.currentCycleNumber >= 1
          && request.resource.data.initializationOrigin in ['V2_NATIVE', 'V1_MIGRATION_BASELINE']
          && request.resource.data.schemaVersion == 2
          // Structural recovery may recreate only the missing pointer while
          // preserving the already-persisted V2 history boundary. Never allow
          // a future boundary; `createdAt`/`updatedAt` still prove this is the
          // current recovery write.
          && request.resource.data.historyCompleteFrom is timestamp
          && request.resource.data.historyCompleteFrom <= request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && questionnaireLevelMatches(userId, request.resource.data.activeProgramInstanceId, request.resource.data.startingLevel)
          && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.currentCycleId)).data.status == 'ACTIVE'
          && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.currentCycleId)).data.level == request.resource.data.currentTrainingLevel
          && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.currentCycleId)).data.cycleNumber == request.resource.data.currentCycleNumber
          && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.currentCycleId)).data.programInstanceId == request.resource.data.activeProgramInstanceId
          && getAfter(/databases/$(database)/documents/users/$(userId)/programInstances/$(request.resource.data.activeProgramInstanceId)).data.contentIdentity == request.resource.data.activeContentIdentity
          && getAfter(/databases/$(database)/documents/users/$(userId)/programInstances/$(request.resource.data.activeProgramInstanceId)).data.prescriptionIdentity == request.resource.data.activePrescriptionIdentity;
        allow update: if isOwner(userId)
          && accountActive(userId)
          && consumesLifecycleAuthorityGrant(userId, ['ADAPT', 'ACTIVATE', 'RECOVER'])
          && grantSourceMatches(userId, resource.data.currentCycleId, resource.data.activeProgramInstanceId)
          && lifecycleAuthorityGrant(userId).targetProgramInstanceId == request.resource.data.activeProgramInstanceId
          && lifecycleAuthorityGrant(userId).targetTrainingLevel == request.resource.data.currentTrainingLevel
          && lifecycleAuthorityGrant(userId).targetCycleNumber == request.resource.data.currentCycleNumber
          && stateId == 'current'
          && request.resource.data.keys() == resource.data.keys()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'currentTrainingLevel', 'currentCycleId', 'currentCycleNumber',
               'activeProgramInstanceId', 'activeContentIdentity',
               'activePrescriptionIdentity', 'updatedAt'])
          && request.resource.data.startingLevel == resource.data.startingLevel
          && request.resource.data.initializationOrigin == resource.data.initializationOrigin
          && request.resource.data.historyCompleteFrom == resource.data.historyCompleteFrom
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.currentTrainingLevel in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED']
          && lifecycleLevelTransitionValid(resource.data.currentTrainingLevel, request.resource.data.currentTrainingLevel)
          && ((request.resource.data.currentTrainingLevel == resource.data.currentTrainingLevel)
              || request.resource.data.currentCycleId != resource.data.currentCycleId)
          && lifecycleAuthorityGrant(userId).targetTrainingLevel == request.resource.data.currentTrainingLevel
          && lifecycleAuthorityGrant(userId).targetCycleNumber == request.resource.data.currentCycleNumber
          && ((request.resource.data.currentCycleId == resource.data.currentCycleId
                && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(resource.data.currentCycleId)).data.status == 'ACTIVE')
              || (request.resource.data.currentCycleId != resource.data.currentCycleId
                && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(resource.data.currentCycleId)).data.status == 'COMPLETED'))
          && ((request.resource.data.activeProgramInstanceId == resource.data.activeProgramInstanceId)
              || getAfter(/databases/$(database)/documents/users/$(userId)/programInstances/$(resource.data.activeProgramInstanceId)).data.supersededAt == request.time)
          && request.resource.data.currentCycleNumber is int
          && request.resource.data.currentCycleNumber >= 1
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.currentCycleId)).data.status == 'ACTIVE'
          && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.currentCycleId)).data.level == request.resource.data.currentTrainingLevel
          && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.currentCycleId)).data.cycleNumber == request.resource.data.currentCycleNumber
          && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.currentCycleId)).data.programInstanceId == request.resource.data.activeProgramInstanceId
          && getAfter(/databases/$(database)/documents/users/$(userId)/programInstances/$(request.resource.data.activeProgramInstanceId)).data.contentIdentity == request.resource.data.activeContentIdentity
          && getAfter(/databases/$(database)/documents/users/$(userId)/programInstances/$(request.resource.data.activeProgramInstanceId)).data.prescriptionIdentity == request.resource.data.activePrescriptionIdentity;
        allow delete: if false;
      }

      match /trainingCycles/{cycleId} {
        allow read: if isOwner(userId) && accountActive(userId);
        allow create: if isOwner(userId)
          && accountActive(userId)
          && consumesLifecycleAuthorityGrant(userId, ['INITIALIZE', 'MIGRATE', 'ACTIVATE', 'RECOVER'])
          && lifecycleAuthorityGrant(userId).targetCycleId == cycleId
          && lifecycleAuthorityGrant(userId).targetProgramInstanceId == request.resource.data.programInstanceId
          && request.resource.data.keys().hasAll([
               'cycleId', 'level', 'cycleNumber', 'status', 'origin',
               'programInstanceId', 'previousProgramInstanceId', 'startedAt',
               'eligibleAt', 'completedAt', 'completionReason', 'progressionReason', 'schemaVersion',
               'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
               'cycleId', 'level', 'cycleNumber', 'status', 'origin',
               'programInstanceId', 'previousProgramInstanceId', 'startedAt',
               'eligibleAt', 'completedAt', 'completionReason', 'progressionReason', 'schemaVersion',
               'createdAt', 'updatedAt'])
          && request.resource.data.cycleId == cycleId
          && request.resource.data.level in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED']
          && request.resource.data.level == lifecycleAuthorityGrant(userId).targetTrainingLevel
          && request.resource.data.cycleNumber is int && request.resource.data.cycleNumber >= 1
          && request.resource.data.cycleNumber == lifecycleAuthorityGrant(userId).targetCycleNumber
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.origin in ['V2_NATIVE', 'V1_MIGRATION_BASELINE']
          && request.resource.data.programInstanceId is string
          && (request.resource.data.previousProgramInstanceId == null || request.resource.data.previousProgramInstanceId is string)
          && request.resource.data.startedAt is timestamp
          && request.resource.data.eligibleAt == null
          && request.resource.data.completedAt == null
          && request.resource.data.completionReason == null
          && request.resource.data.progressionReason is string
          && request.resource.data.schemaVersion == 2
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.currentCycleId == cycleId
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.currentCycleNumber == request.resource.data.cycleNumber
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.activeProgramInstanceId == request.resource.data.programInstanceId;
        allow update: if isOwner(userId)
          && accountActive(userId)
          && consumesLifecycleAuthorityGrant(userId, ['ADAPT', 'ACTIVATE', 'RECOVER'])
          && lifecycleAuthorityGrant(userId).sourceCycleId == cycleId
          && lifecycleAuthorityGrant(userId).sourceProgramInstanceId == resource.data.programInstanceId
          && request.resource.data.keys().hasAll([
               'cycleId', 'level', 'cycleNumber', 'status', 'origin',
               'programInstanceId', 'previousProgramInstanceId', 'startedAt',
               'eligibleAt', 'completedAt', 'progressionReason', 'schemaVersion',
               'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
               'cycleId', 'level', 'cycleNumber', 'status', 'origin',
               'programInstanceId', 'previousProgramInstanceId', 'startedAt',
               'eligibleAt', 'completedAt', 'completionReason', 'progressionReason',
               'schemaVersion', 'createdAt', 'updatedAt'])
          && (!resource.data.keys().hasAny(['completionReason']) || request.resource.data.keys().hasAny(['completionReason']))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'programInstanceId', 'previousProgramInstanceId',
               'eligibleAt', 'completedAt', 'completionReason', 'progressionReason', 'updatedAt'])
          && request.resource.data.cycleId == resource.data.cycleId
          && request.resource.data.level == resource.data.level
          && request.resource.data.cycleNumber == resource.data.cycleNumber
          && request.resource.data.origin == resource.data.origin
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.createdAt == resource.data.createdAt
          && resource.data.status == 'ACTIVE'
          && request.resource.data.status in ['ACTIVE', 'COMPLETED']
          && request.resource.data.get('completionReason', null) in [null, 'EARNED_EVOLUTION']
          && ((request.resource.data.status == 'ACTIVE'
                && request.resource.data.completedAt == null
                && request.resource.data.get('completionReason', null) == null)
              || (request.resource.data.status == 'COMPLETED'
                && request.resource.data.completedAt == request.time
                && request.resource.data.get('completionReason', null) == 'EARNED_EVOLUTION'
                && getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.currentCycleId != cycleId))
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /programInstances/{programInstanceId} {
        allow read: if isOwner(userId) && accountActive(userId);
        allow create: if isOwner(userId)
          && accountActive(userId)
          && consumesLifecycleAuthorityGrant(userId, ['INITIALIZE', 'MIGRATE', 'ADAPT', 'ACTIVATE', 'RECOVER'])
          && (lifecycleAuthorityGrant(userId).targetProgramInstanceId == programInstanceId
              || (lifecycleAuthorityGrant(userId).operation == 'MIGRATE'
                && lifecycleAuthorityGrant(userId).baselineProgramInstanceId == programInstanceId
                && lifecycleAuthorityGrant(userId).baselineContentIdentity == request.resource.data.contentIdentity))
          && lifecycleAuthorityGrant(userId).targetCycleId == request.resource.data.cycleId
          && ((lifecycleAuthorityGrant(userId).targetProgramInstanceId == programInstanceId
                && lifecycleAuthorityGrant(userId).targetContentIdentity == request.resource.data.contentIdentity
                && lifecycleAuthorityGrant(userId).targetPrescriptionIdentity == request.resource.data.prescriptionIdentity)
              || (lifecycleAuthorityGrant(userId).operation == 'MIGRATE'
                && lifecycleAuthorityGrant(userId).baselineProgramInstanceId == programInstanceId
                && lifecycleAuthorityGrant(userId).baselineContentIdentity == request.resource.data.contentIdentity
                && lifecycleAuthorityGrant(userId).baselinePrescriptionIdentity == request.resource.data.prescriptionIdentity))
          && (!request.resource.data.keys().hasAny(['prescriptionInputSnapshot'])
              || request.resource.data.prescriptionInputSnapshot == lifecycleAuthorityGrant(userId).targetPrescriptionInputSnapshot)
          && request.resource.data.keys().hasAll([
               'programInstanceId', 'cycleId', 'contentIdentity',
               'prescriptionIdentity', 'questionnaireId', 'activatedAt',
               'supersededAt', 'previousProgramInstanceId', 'activationReason',
               'schemaVersion', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
               'programInstanceId', 'cycleId', 'contentIdentity',
               'prescriptionIdentity', 'questionnaireId', 'prescriptionInputSnapshot', 'activatedAt',
               'supersededAt', 'previousProgramInstanceId', 'activationReason',
               'schemaVersion', 'createdAt', 'updatedAt'])
          && request.resource.data.programInstanceId == programInstanceId
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutPrograms/$(request.resource.data.contentIdentity)).data.prescriptionId == request.resource.data.prescriptionIdentity
          && existsAfter(/databases/$(database)/documents/users/$(userId)/questionnaires/$(request.resource.data.questionnaireId))
          && (
               (request.resource.data.keys().hasAny(['prescriptionInputSnapshot'])
                 && prescriptionInputSnapshotValid(request.resource.data.prescriptionInputSnapshot))
               || request.resource.data.activationReason in [
                    'V1_MIGRATION_BASELINE', 'V1_AUTOMATIC_PROGRESSION'])
          && request.resource.data.activatedAt is timestamp
          && (request.resource.data.supersededAt == null
              || (request.resource.data.activationReason == 'V1_MIGRATION_BASELINE'
                && request.resource.data.supersededAt == request.time))
          && (request.resource.data.previousProgramInstanceId == null || request.resource.data.previousProgramInstanceId is string)
          && request.resource.data.activationReason in [
               'INITIAL_PROGRAM', 'V1_MIGRATION_BASELINE',
               'V1_AUTOMATIC_PROGRESSION', 'MANUAL_REGENERATION',
               'AUTOMATIC_RECONCILIATION', 'EVOLUTION_ACTIVATION',
               'PROGRAM_ADAPTATION']
          && request.resource.data.schemaVersion == 2
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.supersededAt != null
              || (getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.activeProgramInstanceId == programInstanceId
                && getAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.cycleId)).data.programInstanceId == programInstanceId));
        allow update: if isOwner(userId)
          && accountActive(userId)
          && consumesLifecycleAuthorityGrant(userId, ['ADAPT', 'ACTIVATE', 'RECOVER'])
          && lifecycleAuthorityGrant(userId).sourceProgramInstanceId == programInstanceId
          && request.resource.data.keys() == resource.data.keys()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supersededAt', 'updatedAt'])
          && resource.data.supersededAt == null
          && request.resource.data.supersededAt == request.time
          && request.resource.data.updatedAt == request.time
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.activeProgramInstanceId != programInstanceId;
        allow delete: if false;
      }

      match /workoutLifecycleEvents/{eventId} {
        allow read: if isOwner(userId) && accountActive(userId);
        allow create: if isOwner(userId)
          && accountActive(userId)
          && consumesLifecycleAuthorityGrant(userId, ['INITIALIZE', 'MIGRATE', 'RECOVER', 'EARN', 'DEFER', 'ACTIVATE', 'ADAPT'])
          && lifecycleAuthorityGrant(userId).keys().hasAll(['eventId', 'eventType', 'idempotencyKey'])
          && lifecycleAuthorityGrant(userId).eventId == eventId
          && lifecycleAuthorityGrant(userId).eventType == request.resource.data.type
          && lifecycleAuthorityGrant(userId).idempotencyKey == request.resource.data.idempotencyKey
          && (!(request.resource.data.type in ['EVOLUTION_EARNED', 'MOTIVATIONAL_RENEWAL_OFFERED'])
              || (lifecycleAuthorityGrant(userId).operation == 'EARN'
                && request.resource.data.payload.evolutionType == lifecycleAuthorityGrant(userId).authoritativeEarnedFact.type
                && request.resource.data.payload.fromLevel == lifecycleAuthorityGrant(userId).authoritativeEarnedFact.fromLevel
                && request.resource.data.payload.toLevel == lifecycleAuthorityGrant(userId).authoritativeEarnedFact.toLevel
                && request.resource.data.payload.quality == lifecycleAuthorityGrant(userId).authoritativeEarnedFact.quality
                && request.resource.data.payload.sessionsCompletedAtEarn == lifecycleAuthorityGrant(userId).authoritativeEarnedFact.sessionsCompletedAtEarn
                && request.resource.data.payload.adherenceAtEarnBp == lifecycleAuthorityGrant(userId).authoritativeEarnedFact.adherenceAtEarnBp))
          && request.resource.data.keys().hasAll([
               'eventId', 'type', 'occurredAt', 'cycleId', 'programInstanceId',
               'idempotencyKey', 'payload', 'schemaVersion'])
          && request.resource.data.keys().hasOnly([
               'eventId', 'type', 'occurredAt', 'cycleId', 'programInstanceId',
               'idempotencyKey', 'payload', 'schemaVersion'])
          && request.resource.data.eventId == eventId
          && request.resource.data.type in [
               'CYCLE_STARTED', 'CYCLE_ELIGIBLE', 'CYCLE_COMPLETED',
               'EVOLUTION_ELIGIBLE', 'EVOLUTION_EARNED', 'EVOLUTION_DEFERRED',
               'EVOLUTION_ACTIVATED', 'MOTIVATIONAL_RENEWAL_OFFERED',
               'MOTIVATIONAL_RENEWAL_ACTIVATED', 'LEVEL_PROMOTED',
               'PROGRAM_STARTED', 'PROGRAM_ADAPTED']
          && request.resource.data.occurredAt == request.time
          && request.resource.data.cycleId is string
          && request.resource.data.programInstanceId is string
          && request.resource.data.idempotencyKey is string
          && lifecycleEventPayloadValid(request.resource.data)
          && request.resource.data.schemaVersion == 2
          && existsAfter(/databases/$(database)/documents/users/$(userId)/trainingCycles/$(request.resource.data.cycleId))
          && existsAfter(/databases/$(database)/documents/users/$(userId)/programInstances/$(request.resource.data.programInstanceId))
          && (request.resource.data.type != 'LEVEL_PROMOTED'
              || (getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.currentCycleId == request.resource.data.cycleId
                && getAfter(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.activeProgramInstanceId == request.resource.data.programInstanceId));
        allow update, delete: if false;
      }

      // Fase 4 — an earned-but-not-yet-active transition (docs §11: PREPARED
      // != ACTIVE). Single fixed id 'current': at most one pending evolution
      // can exist per user at a time, guaranteed structurally rather than by
      // an extra invariant check. `plan` carries the next prescription's
      // full content (a `FinalWorkoutPlan`) — deliberately validated only as
      // `is map` here, not deep-structurally: it was already produced and
      // validated by the trusted Prescription Evolution/Engine pipeline, and
      // is re-validated again at activation time when it becomes the real
      // `workoutPrograms/{contentIdentity}` document (which IS fully
      // schema-validated by the existing `workoutProgramCommonValid` rule).
      match /pendingEvolutions/{pendingId} {
        allow read: if isOwner(userId) && accountActive(userId) && pendingId == 'current';
        allow create: if isOwner(userId)
          && accountActive(userId)
          && consumesLifecycleAuthorityGrant(userId, ['PREPARE'])
          && lifecycleAuthorityGrant(userId).pendingEvolutionId == request.resource.data.pendingEvolutionId
          && lifecycleAuthorityGrant(userId).targetProgramInstanceId == request.resource.data.targetProgramInstanceId
          && lifecycleAuthorityGrant(userId).targetContentIdentity == request.resource.data.targetContentIdentity
          && lifecycleAuthorityGrant(userId).targetPrescriptionIdentity == request.resource.data.targetPrescriptionIdentity
          && request.resource.data.plan == lifecycleAuthorityGrant(userId).targetPlan
          && request.resource.data.targetPrescriptionInputSnapshot == lifecycleAuthorityGrant(userId).targetPrescriptionInputSnapshot
          && pendingId == 'current'
          && request.resource.data.keys().hasAll([
               'pendingEvolutionId', 'type', 'status', 'sourceCycleId',
               'sourceProgramInstanceId', 'sourcePrescriptionInputSnapshotId', 'fromLevel', 'toLevel', 'quality',
               'sessionsCompletedAtEarn', 'adherenceAtEarnBp',
               'plan', 'targetContentIdentity', 'targetPrescriptionIdentity',
               'targetProgramInstanceId', 'targetQuestionnaireId',
               'targetQuestionnaireVersion', 'targetPrescriptionInputSnapshot', 'targetTemplateId',
               'targetTemplateVersion', 'targetTemplateSourceVersion',
               'targetTemplateContentHash', 'earnedAt', 'deferralCount',
               'nextPromptAt', 'autoActivateAt', 'idempotencyKey',
               'schemaVersion', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly([
               'pendingEvolutionId', 'type', 'status', 'sourceCycleId',
               'sourceProgramInstanceId', 'sourcePrescriptionInputSnapshotId', 'fromLevel', 'toLevel', 'quality',
               'sessionsCompletedAtEarn', 'adherenceAtEarnBp',
               'plan', 'targetContentIdentity', 'targetPrescriptionIdentity',
               'targetProgramInstanceId', 'targetQuestionnaireId',
               'targetQuestionnaireVersion', 'targetPrescriptionInputSnapshot', 'targetTemplateId',
               'targetTemplateVersion', 'targetTemplateSourceVersion',
               'targetTemplateContentHash', 'earnedAt', 'deferralCount',
               'nextPromptAt', 'autoActivateAt', 'idempotencyKey',
               'schemaVersion', 'createdAt', 'updatedAt'])
          && request.resource.data.type in ['CYCLE_EVOLUTION', 'LEVEL_PROMOTION', 'MOTIVATIONAL_RENEWAL']
          && request.resource.data.status in ['READY', 'DEFERRED']
          && request.resource.data.sourceCycleId
               == get(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.currentCycleId
          && request.resource.data.sourceProgramInstanceId
               == get(/databases/$(database)/documents/users/$(userId)/workoutLifecycleState/current).data.activeProgramInstanceId
          && request.resource.data.sourcePrescriptionInputSnapshotId is string
          && ((get(/databases/$(database)/documents/users/$(userId)/programInstances/$(request.resource.data.sourceProgramInstanceId)).data.keys().hasAny(['prescriptionInputSnapshot'])
                && request.resource.data.sourcePrescriptionInputSnapshotId
                  == get(/databases/$(database)/documents/users/$(userId)/programInstances/$(request.resource.data.sourceProgramInstanceId)).data.prescriptionInputSnapshot.snapshotId)
              || (!get(/databases/$(database)/documents/users/$(userId)/programInstances/$(request.resource.data.sourceProgramInstanceId)).data.keys().hasAny(['prescriptionInputSnapshot'])
                && request.resource.data.sourcePrescriptionInputSnapshotId
                  == 'legacy:' + request.resource.data.sourceProgramInstanceId))
          && request.resource.data.fromLevel in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED']
          && request.resource.data.toLevel in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED']
          && request.resource.data.quality in ['BELOW_TARGET', 'GOOD', 'HIGH']
          && request.resource.data.sessionsCompletedAtEarn is int && request.resource.data.sessionsCompletedAtEarn >= 0
          && request.resource.data.adherenceAtEarnBp is int
          && request.resource.data.adherenceAtEarnBp >= 0 && request.resource.data.adherenceAtEarnBp <= 10000
          && request.resource.data.targetContentIdentity is string
          && request.resource.data.targetPrescriptionIdentity is string
          && request.resource.data.targetProgramInstanceId is string
          && request.resource.data.targetProgramInstanceId != request.resource.data.sourceProgramInstanceId
          && request.resource.data.targetQuestionnaireVersion is int
          && request.resource.data.targetTemplateVersion is int
          && request.resource.data.earnedAt is timestamp
          && request.resource.data.earnedAt <= request.time
          && request.resource.data.deferralCount in [0, 1, 2]
          && ((request.resource.data.deferralCount == 0
                && request.resource.data.status == 'READY'
                && request.resource.data.nextPromptAt == null
                && request.resource.data.autoActivateAt == null)
              || (request.resource.data.deferralCount == 1
                && request.resource.data.status == 'DEFERRED'
                && request.resource.data.nextPromptAt is timestamp
                && request.resource.data.autoActivateAt == null)
              || (request.resource.data.deferralCount == 2
                && request.resource.data.status == 'DEFERRED'
                && request.resource.data.nextPromptAt == null
                && request.resource.data.autoActivateAt is timestamp))
          && request.resource.data.idempotencyKey is string
          && request.resource.data.schemaVersion == 2
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId)
          && accountActive(userId)
          && consumesLifecycleAuthorityGrant(userId, ['DEFER'])
          && lifecycleAuthorityGrant(userId).pendingEvolutionId == resource.data.pendingEvolutionId
          && pendingId == 'current'
          && request.resource.data.keys() == resource.data.keys()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'deferralCount', 'nextPromptAt', 'autoActivateAt', 'updatedAt'])
          && request.resource.data.pendingEvolutionId == resource.data.pendingEvolutionId
          && request.resource.data.status == 'DEFERRED'
          && request.resource.data.deferralCount == resource.data.deferralCount + 1
          && request.resource.data.deferralCount in [1, 2]
          // DEV Accelerated Lifecycle QA: the NORMAL tolerance band is
          // 13-15 days (centered on the real 14-day window in
          // src/workoutLifecycle/deferral.ts, +/-1 day for client/server
          // clock skew). QA-authorized accounts (see
          // workoutLifecycleQaAccelerated() above) get an 8-12 minute band
          // instead (centered on DEFERRAL_CONFIG_QA_ACCELERATED's 10
          // minutes) — this ONLY widens how fast a deferral's own re-prompt/
          // auto-activation window may legitimately elapse; it never touches
          // the 28/85-day progression gates, which stay fully backend-
          // authoritative in authorizeMutation.ts regardless of this flag.
          && ((request.resource.data.deferralCount == 1
                && request.resource.data.nextPromptAt is timestamp
                && request.resource.data.nextPromptAt >= request.time + (
                     workoutLifecycleQaModeIsAccelerated(userId) ? duration.value(8, 'm') : duration.value(13, 'd'))
                && request.resource.data.nextPromptAt <= request.time + (
                     workoutLifecycleQaModeIsAccelerated(userId) ? duration.value(12, 'm') : duration.value(15, 'd'))
                && request.resource.data.autoActivateAt == null)
              || (request.resource.data.deferralCount == 2
                && request.resource.data.nextPromptAt == null
                && request.resource.data.autoActivateAt is timestamp
                && resource.data.nextPromptAt is timestamp
                && request.resource.data.autoActivateAt >= resource.data.nextPromptAt + (
                     workoutLifecycleQaModeIsAccelerated(userId) ? duration.value(8, 'm') : duration.value(13, 'd'))
                && request.resource.data.autoActivateAt <= resource.data.nextPromptAt + (
                     workoutLifecycleQaModeIsAccelerated(userId) ? duration.value(12, 'm') : duration.value(15, 'd'))))
          && request.resource.data.updatedAt == request.time;
        // Cleared as part of the same client transaction that writes the
        // activation's other documents (programInstances/trainingCycles/
        // workoutLifecycleState) — each of those is independently
        // Rules-validated; this delete only needs ownership.
        allow delete: if isOwner(userId)
          && accountActive(userId)
          && pendingId == 'current'
          && consumesLifecycleAuthorityGrant(userId, ['ADAPT', 'ACTIVATE', 'RECOVER']);
      }

      match /workoutLifecycleAuthorityGrants/{grantId} {
        allow read: if isOwner(userId) && accountActive(userId) && grantId == 'current';
        allow delete: if isOwner(userId) && grantId == 'current';
        allow create, update: if false;
      }

      // Workout Execution & History V1 (docs/workout-lifecycle/
      // 09_WORKOUT_EXECUTION_AND_HISTORY.md). Top-level per-user collection
      // (not nested under workoutPrograms/{programId}) so history queries
      // ("last N workouts") never require scanning every program a user has
      // ever had, and so account-deletion cleanup can delete it the same
      // one-level way as `workoutPrograms` (docs §47/§48).
      //
      // Mutable only while IN_PROGRESS or ABANDONED (an abandoned attempt can
      // be restarted fresh); once COMPLETED/PARTIALLY_COMPLETED it is
      // immutable history, same as a schedule event (docs §53).
      match /workoutExecutions/{executionId} {
        allow read: if isOwner(userId) && accountActive(userId);

        // P0 integrity fix (2026-09, docs/workout-lifecycle/ — production
        // incident: two same-user IN_PROGRESS executions for the same
        // session on different `scheduledLocalDate`s, one abandoned by the
        // other without ever being terminalized). `workoutExecutionState/
        // current` (see the match block below) is a single fixed-id mutex —
        // Firestore itself can only ever hold one document at that path, so
        // "at most one active execution" is guaranteed by construction FOR
        // A CLIENT THAT WRITES BOTH DOCUMENTS TOGETHER.
        //
        // P0-C hardening (2026-09, docs/workout-lifecycle/ hardening plan):
        // that assumption doesn't hold for a pre-P0 client, which can still
        // create `workoutExecutions` directly with no knowledge of `current`
        // at all — reproduced empirically against this exact ruleset. The
        // fix is this last `create` clause: once
        // `workoutExecutionMutexHardeningEnabled()` is on (an
        // Admin-SDK-only, client-readable flag — see the
        // `workoutExecutionProtocolConfig` match block above), a brand-new
        // IN_PROGRESS execution must (a) declare
        // `mutexProtocolVersion` (proves the WRITER knows this protocol
        // exists at all — a pre-P0-C client literally cannot produce this
        // field) and (b) land in the SAME transaction as a `current` write
        // pointing at exactly this `executionId`, checked via `getAfter()`
        // (this transaction's OWN pending write, not just already-committed
        // state). Before the flag is on, this clause is skipped entirely —
        // a pre-P0-C client keeps working exactly as it does today, which is
        // the whole point of gating this behind a flag instead of shipping
        // it directly (see docs §10 rollout phases).
        //
        // This check does NOT extend to the update path (restart-after-
        // abandon, `status: ABANDONED -> IN_PROGRESS`) — pairing `getAfter()`
        // with THAT particular update rule (already expensive: grant-
        // consumption checks, bounds-checked exercises) was proven, in this
        // exact Rules Emulator, to exceed its "maximum expressions"
        // evaluation cap. That transition remains an open gap even once
        // hardening is on — see the hardening plan's rollout report for the
        // options considered and why none were applied yet without further
        // work.
        allow create: if isOwner(userId)
          && accountActive(userId)
          && workoutExecutionCommonValid(userId, request.resource.data)
          && executionExerciseSetsWithinBound(request.resource.data.exercises)
          && request.resource.data.status == 'IN_PROGRESS'
          && request.resource.data.finishedAt == null
          && request.resource.data.startedAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          // Cardio Finisher Completion Recovery hardening, Architecture B
          // (2026-09 security audit): a client-created execution must always
          // be born with `cardio` absent/null — never already COMPLETED.
          // Only the `completeWorkoutCardio` callable (Admin SDK, bypasses
          // Rules entirely) may ever write a non-null `cardio`.
          && request.resource.data.get('cardio', null) == null
          && (
            !workoutExecutionMutexHardeningEnabled()
            || (
              request.resource.data.get('mutexProtocolVersion', 0) == 1
              && getAfter(/databases/$(database)/documents/users/$(userId)/workoutExecutionState/current).data.executionId == executionId
            )
          );

        // Terminalization is the hottest V2 update path: besides this
        // document it atomically deletes both the active-execution mutex and
        // the one-shot lifecycle grant. Re-running the full create-oriented
        // validator here (including two program lookups) pushed a legitimate
        // seven-exercise finish beyond Firestore's 1000-expression ceiling.
        //
        // A terminal update may change only sets plus the three terminal
        // fields. Every other top-level identity/schema field is compared to
        // the already-valid existing execution, exercise identities and set
        // bounds are checked shallowly, and V2 still consumes the exact
        // execution-scoped grant. This is a cheaper equivalent validation,
        // not an authority bypass.
        function workoutExecutionTerminalUpdateValid(userId, executionId, before, after) {
          return before.status == 'IN_PROGRESS'
            && after.status in ['COMPLETED', 'PARTIALLY_COMPLETED']
            && after.finishedAt == request.time
            && after.updatedAt == request.time
            && after.keys().hasAll([
                 'programId', 'templateId', 'sessionIndex', 'sessionName',
                 'scheduledLocalDate', 'status', 'startedAt', 'finishedAt',
                 'exercises', 'executionSchemaVersion', 'createdAt', 'updatedAt'
               ])
            && after.keys().hasOnly([
                 'programId', 'templateId', 'sessionIndex', 'sessionName',
                 'scheduledLocalDate', 'status', 'startedAt', 'finishedAt',
                 'exercises', 'executionSchemaVersion', 'createdAt', 'updatedAt',
                 'programInstanceId', 'mutexProtocolVersion', 'cardio'
               ])
            && after.programId == before.programId
            && after.templateId == before.templateId
            && after.sessionIndex == before.sessionIndex
            && after.sessionName == before.sessionName
            && after.scheduledLocalDate == before.scheduledLocalDate
            && after.startedAt == before.startedAt
            && after.createdAt == before.createdAt
            && after.executionSchemaVersion == before.executionSchemaVersion
            && ('programInstanceId' in after) == ('programInstanceId' in before)
            && ('mutexProtocolVersion' in after) == ('mutexProtocolVersion' in before)
            && ('cardio' in after) == ('cardio' in before)
            && after.get('programInstanceId', null) == before.get('programInstanceId', null)
            && after.get('mutexProtocolVersion', null) == before.get('mutexProtocolVersion', null)
            && after.get('cardio', null) == before.get('cardio', null)
            && after.exercises is list
            && after.exercises.size() == before.exercises.size()
            && after.exercises.size() >= 1
            && after.exercises.size() <= 20
            && exerciseIdentityFieldsImmutable(before.exercises, after.exercises)
            && (after.executionSchemaVersion == 1
                || consumesFinishExecutionAuthorityGrant(userId, executionId));
        }

        allow update: if isOwner(userId)
          && accountActive(userId)
          && (
            (
              request.resource.data.status in ['IN_PROGRESS', 'ABANDONED']
              && workoutExecutionCommonValid(userId, request.resource.data)
              && resource.data.status in ['IN_PROGRESS', 'ABANDONED']
              && request.resource.data.programId == resource.data.programId
              && request.resource.data.sessionIndex == resource.data.sessionIndex
              && request.resource.data.scheduledLocalDate == resource.data.scheduledLocalDate
          // Fase 7 security hardening: a client update may never change which
          // exercise a slot identifies as (`exerciseId`/`prescribedExerciseId`/
          // `substitution`) — record/skip/finish never do. EXCEPT
          // restart-after-abandon, which legitimately re-materializes the
          // whole `exercises` array fresh (same trust model as `create`,
          // just via `update` because the doc id is reused) — gated the same
          // way the `startedAt` renewal exception right below already is.
          //
          // `abandon` never touches exercises, so it short-circuits the
          // per-slot checks entirely. Every operation that can write the
          // exercises array uses the bounded, shallow envelope comparison
          // above. Do NOT add a whole-list equality fast path here: for a
          // record/skip/finish that really changes sets, Firestore must deeply
          // compare the entire nested list before discovering inequality;
          // that wasted work was enough to push real V2 executions over the
          // 1000-expression ceiling before the shallow checks even ran.
              && ((resource.data.status == 'ABANDONED'
                && executionExerciseSetsWithinBound(request.resource.data.exercises))
                || (request.resource.data.status == 'ABANDONED'
                  && resource.data.exercises == request.resource.data.exercises)
                || exerciseIdentityFieldsImmutable(resource.data.exercises, request.resource.data.exercises))
          // P0 fix (2026-09, docs §13): `startedAt` must stay fixed for every
          // update EXCEPT a restart-after-abandon (ABANDONED -> IN_PROGRESS)
          // — that transition is semantically a NEW attempt, and the session
          // timer (`elapsed = Date.now() - startedAt`) must not keep showing
          // the abandoned attempt's stale duration. Every other transition
          // (recordSet/skipSet/finish/abandon) still can't touch it.
              && (request.resource.data.startedAt == resource.data.startedAt
              || (resource.data.status == 'ABANDONED' && request.resource.data.status == 'IN_PROGRESS'
                  && request.resource.data.startedAt == request.time))
          // Cardio Finisher Completion Recovery hardening, Architecture B
          // (2026-09 security audit — supersedes the original "shape only"
          // version of this check, which a characterization test suite
          // proved let the client forge an arbitrary completion/duration/
          // timestamp directly, bypassing `completeCardioExecution`
          // entirely). The client can NEVER change `cardio` via a direct
          // Firestore write, full stop — a single field-equality, cheaper
          // than the `startedAt` immutability check right above (no `.get()`,
          // no `.diff()`, no branching on `status`). Only the
          // `completeWorkoutCardio` callable (Admin SDK, bypasses Rules
          // entirely) may ever move it away from whatever it already is —
          // see that callable's own idempotent transaction
          // (`functions/src/workoutLifecycle/completeWorkoutCardio.ts`) for
          // the real integrity guarantee (ownership + IN_PROGRESS + the
          // session actually prescribing a cardio finisher, all re-verified
          // server-side, never trusted from the request payload). The ONE
          // exception mirrors `startedAt`/`exercises` right above: a
          // restart-after-abandon is semantically a new attempt, so the
          // client legitimately resets a stale COMPLETED record back to
          // null then too (`services/workoutExecutions.ts`'s `base` object
          // always sends `cardio: null` on that path) — it can never smuggle
          // a non-null value back in through this exception.
              && (request.resource.data.get('cardio', null) == resource.data.get('cardio', null)
              || (resource.data.status == 'ABANDONED' && request.resource.data.status == 'IN_PROGRESS'
                  && request.resource.data.get('cardio', null) == null))
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.updatedAt == request.time
              && (
                (request.resource.data.status == 'IN_PROGRESS'
                  && request.resource.data.finishedAt == null)
                || (request.resource.data.status == 'ABANDONED'
                  && request.resource.data.finishedAt == request.time)
              )
            )
            || workoutExecutionTerminalUpdateValid(
              userId, executionId, resource.data, request.resource.data
            )
          );

        allow delete: if false;
      }

      // Exercise-substitution architecture audit: "todos os próximos
      // treinos" preferences. Written EXCLUSIVELY by `applyExerciseSubstitution`
      // (Admin SDK, bypasses these Rules entirely) — the client only ever
      // reads its own preferences (to materialize them into a new execution,
      // `services/workoutExecutions.ts`'s `resolveExercisesForNewExecution`).
      // No client create/update/delete path exists for this feature, so none
      // is granted here.
      match /exerciseSubstitutionPreferences/{prescribedExerciseId} {
        allow read: if isOwner(userId) && accountActive(userId);
        allow write: if false;
      }

      // P0 integrity fix (2026-09): the persistent mutex/pointer for "which
      // WorkoutExecution, if any, is legitimately IN_PROGRESS right now" —
      // see the doc comment on `WorkoutExecutionStatePointer`
      // (src/workoutExecution/types.ts). Existence of this fixed-id ('current')
      // document IS the authority; there is deliberately no other value this
      // collection can hold.
      //
      // This validates only the pointer's OWN shape/ownership. The
      // real P0 mutex guarantee never depended on cross-referencing
      // `workoutExecutions` here — `current`'s fixed doc id plus
      // `startOrResumeWorkoutExecution` always writing both documents in one
      // transaction is what serializes two devices/a double tap/a retry
      // (Firestore's transaction protocol, not Rules).
      //
      // P0-C hardening (2026-09, docs/workout-lifecycle/ hardening plan):
      // `workoutExecutionStatePointsAtRealExecution()` below is the
      // cross-check — gated behind `workoutExecutionMutexHardeningEnabled()`
      // in the `create` rule, same flag as the `workoutExecutions` create
      // rule. It's a SEPARATE function (not folded into
      // `workoutExecutionStateValid`) specifically so it can be gated
      // independently — pairing it unconditionally with the
      // restart-after-abandon transaction (which updates `workoutExecutions`,
      // an already-expensive rule, in the SAME transaction as this create)
      // was verified to risk exceeding the Rules Emulator's expression cap,
      // same as the `workoutExecutions` side (see that match block's
      // comment). Gating it keeps compatible-mode's cost profile unchanged.
      function workoutExecutionStateValid(userId, data) {
        return data is map
          && data.keys().hasAll([
               'executionId', 'programId', 'programInstanceId', 'sessionIndex',
               'scheduledLocalDate', 'status', 'schemaVersion', 'createdAt', 'updatedAt'
             ])
          && data.keys().hasOnly([
               'executionId', 'programId', 'programInstanceId', 'sessionIndex',
               'scheduledLocalDate', 'status', 'schemaVersion', 'createdAt', 'updatedAt'
             ])
          && data.executionId is string
          && data.programId is string
          && (data.programInstanceId == null || data.programInstanceId is string)
          && data.sessionIndex is int && data.sessionIndex >= 0
          && data.scheduledLocalDate is string
          && data.scheduledLocalDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.status == 'IN_PROGRESS'
          && data.schemaVersion == 1
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      function workoutExecutionStatePointsAtRealExecution(userId, data) {
        let execution = getAfter(/databases/$(database)/documents/users/$(userId)/workoutExecutions/$(data.executionId));
        return execution.data.status == 'IN_PROGRESS'
          && execution.data.programId == data.programId
          && execution.data.sessionIndex == data.sessionIndex
          && execution.data.scheduledLocalDate == data.scheduledLocalDate
          && ((data.programInstanceId == null && !('programInstanceId' in execution.data))
              || execution.data.programInstanceId == data.programInstanceId);
      }

      match /workoutExecutionState/{stateId} {
        allow read: if isOwner(userId) && accountActive(userId);

        allow create: if isOwner(userId)
          && accountActive(userId)
          && stateId == 'current'
          && workoutExecutionStateValid(userId, request.resource.data)
          && (
            !workoutExecutionMutexHardeningEnabled()
            || workoutExecutionStatePointsAtRealExecution(userId, request.resource.data)
          );

        // Never updated in place — only created (while absent) or deleted
        // (once the tracked execution becomes terminal). A client wanting to
        // point the mutex at a different execution must go through a delete
        // + create pair, each independently validated above/below.
        allow update: if false;

        // Deleting the mutex is only valid in the SAME transaction that
        // actually terminalizes the execution it was tracking — a client
        // can never "release" the mutex while the tracked execution is
        // still IN_PROGRESS.
        allow delete: if isOwner(userId)
          && accountActive(userId)
          && stateId == 'current'
          && getAfter(/databases/$(database)/documents/users/$(userId)/workoutExecutions/$(resource.data.executionId)).data.status != 'IN_PROGRESS';
      }

      // Avaliações físicas do usuário (guiadas ou importadas). Cada documento
      // é um snapshot imutável — nunca sobrescrever ou apagar (docs/15 §11).
      //
      // Autorização é ownership puro: o app inteiro é pago, então não há
      // checagem de assinatura por ação aqui (ver o comentário no topo deste
      // arquivo). UPDATE/DELETE permanecem `if false` para todos.
      match /assessments/{assessmentId} {
        // Fase 5: leitura/criação também exigem accountActive(userId).
        allow read: if isVerifiedOwner(userId) && accountActive(userId);

        allow create: if isVerifiedOwner(userId)
          && accountActive(userId)
          && assessmentCommonValid()
          && (guidedAssessmentValid() || importedAssessmentValid());

        allow update, delete: if false;
      }

      // Metadados das fotos privadas de evolução (Photo Vault). O dono lê,
      // cria e exclui; o documento é imutável após a criação — trocar uma
      // foto significa excluir o par (documento + objeto no Storage) e criar
      // um novo photoId, o que mantém a auditoria simples e sem ambiguidade.
      //
      // Autorização é ownership puro, pelo mesmo motivo das avaliações acima.
      match /progressPhotos/{photoId} {
        // Fase 5: leitura/criação/exclusão também exigem accountActive(userId).
        allow read: if isVerifiedOwner(userId) && accountActive(userId);
        allow create: if isVerifiedOwner(userId) && accountActive(userId) && progressPhotoValid(userId, photoId);
        allow update: if false;
        allow delete: if isVerifiedOwner(userId) && accountActive(userId);
      }

      // Material criptográfico do Photo Vault (wrappedVaultKey e versões).
      // Backend-only: escrito e lido exclusivamente pelo Admin SDK, que
      // ignora estas regras. O cliente nunca precisa da chave embrulhada —
      // ele recebe a Vault Key já desembrulhada pela Function autenticada e
      // a guarda localmente no SecureStore. Negar leitura ao cliente remove
      // a chave embrulhada da superfície de ataque do app por completo.
      //
      // Consequência: o schema deste documento NÃO é validável por estas
      // regras (o Admin SDK as ignora). O contrato fechado e versionado vive
      // em functions/src/photoVault/schema.ts, onde é de fato aplicado.
      match /privateSecurity/{documentId} {
        allow read, write: if false;
      }
    }

    // ── Support tickets and messages ──────────────────────────────────────
    match /supportTickets/{ticketId} {
      allow get, list: if isAdmin()
        || (hasVerifiedEmailForPrivateAccess() && resource.data.userId == request.auth.uid);
      allow create: if hasVerifiedEmailForPrivateAccess() && supportTicketValid(ticketId);
      allow update: if isAdmin() && adminSupportTicketUpdateValid();
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isAdmin()
          || (hasVerifiedEmailForPrivateAccess()
              && get(/databases/$(database)/documents/supportTickets/$(ticketId))
                   .data.userId == request.auth.uid);
        allow create: if (hasVerifiedEmailForPrivateAccess() && supportMessageValid(ticketId))
          || (isAdmin() && adminSupportMessageValid(ticketId));
        allow update, delete: if false;
      }
    }

    // Catálogo de códigos promocionais/influenciadores
    // (functions/src/attribution/{constants,types,promoCodeCatalog}.ts).
    // Nunca lido nem escrito pelo cliente — a validação server-side
    // (`validatePromoCode`, onCall) faz o único `get()` direto por ID
    // normalizado, via Admin SDK, que ignora estas regras. Bloco explícito
    // (redundante com o catch-all abaixo, que já negaria por padrão) para
    // documentar a intenção: nenhuma exceção de leitura deve ser adicionada
    // aqui, nem mesmo para o dono de um documento — não existe "dono" para
    // um código promocional.
    match /promoCodes/{code} {
      allow read, write: if false;
    }

    // Registro server-managed do ciclo de vida da atribuição de um uid a um
    // código promocional (functions/src/attribution/{constants,types,
    // attributionSync}.ts) — `couponRedemptions/{uid}`. Fonte de verdade;
    // `users/{uid}.attribution` é apenas o espelho de leitura. Escrito
    // exclusivamente por `applyPromoCodeAttributionTransactionally` via
    // Admin SDK. Bloco explícito pelo mesmo motivo do `promoCodes` acima.
    match /couponRedemptions/{uid} {
      allow read, write: if false;
    }

    // Immutable financial ledger written only by the verified RevenueCat webhook through Admin SDK.
    match /subscriptionTransactions/{transactionId} {
      allow read, write: if false;
    }

    // Administrative "free Premium access" audit trail
    // (functions/src/adminUsers/adminFreeAccess.ts) — current grant/revoke
    // state per uid plus its full event history in the `events`
    // subcollection. Written EXCLUSIVELY by `adminGrantFreeAccessHandler`/
    // `adminRevokeFreeAccessHandler` via the Admin SDK, which bypasses these
    // rules by design (see `promoCodes` above for the same pattern). This
    // collection is NEVER the source of truth for Premium access — the
    // mobile app never reads it and must keep using
    // `customerInfo.entitlements.active['premium']` exclusively. It exists
    // only so `ajfit-admin` can display and audit administrative grants.
    // `allow read, write: if false` for every client, including the target
    // user themselves and admins reading through the client SDK — the panel
    // only ever sees this data through the `adminGetUser` callable.
    match /adminAccessGrants/{uid} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // Minimal, non-sensitive realtime invalidation signal for the
    // administrative free-access feature
    // (functions/src/adminUsers/adminFreeAccess.ts's `touchEntitlementSignal`
    // — the ONLY writer, via Admin SDK). Contains nothing but a timestamp —
    // no grant state, no admin uid, no reason, no history (all of that stays
    // in `adminAccessGrants` above, which the client can never read). The
    // mobile client is allowed to read ONLY its own uid's document so
    // `SubscriptionContext` can react to an administrative grant/revoke by
    // invalidating its RevenueCat cache and re-fetching CustomerInfo — it
    // never reads any field here to decide Premium access; RevenueCat's
    // `entitlements.active['premium']` remains the only authority. Write
    // stays backend-only in every case, matching every other collection in
    // this file.
    match /entitlementSignals/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Fase 4/5 account-deletion workflow state
    // (functions/src/accountDeletion/{repository,activeAccountGuard}.ts).
    // Backend-only in both directions: the client never creates, reads, or
    // polls its own deletion record/lock through Firestore directly — a
    // future status-check UI would need its OWN minimal, explicit callable
    // contract (not implemented yet), never a direct read of these paths.
    // `accountActive()` above reads `accountDeletionLocks/{userId}` via
    // `exists()`, which does not require (and is unaffected by) an `allow
    // read` rule here — these blocks exist to make the deny explicit and
    // documented, matching `promoCodes`/`couponRedemptions` above, not to
    // enable the `exists()` check.
    match /accountDeletionLocks/{uid} {
      allow read, write: if false;
    }
    match /accountDeletions/{deletionId} {
      allow read, write: if false;

      match /{subcollection=**} {
        allow read, write: if false;
      }
    }

    // ── Biblioteca oficial de exercícios (docs/27_biblioteca_de_exercicios.md) ─
    // Conteúdo administrado: o script `scripts/seedExercises.ts` (Admin SDK,
    // ignora estas regras) e, a partir do painel `ajfit-admin`, um admin
    // autenticado (`isAdmin()` — mesmo mecanismo já usado por
    // `supportTickets` acima: `users/{uid}.metadata.role == 'admin'`).
    // Leitura liberada para qualquer usuário autenticado; a lista em si não
    // é dado sensível e é necessária para exibir/gerar treinos e permitir
    // substituição de exercícios.
    //
    function limitationExerciseIdValid(value) {
      return value is string
        && value.size() >= 1
        && value.size() <= 120
        && value.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    // Firestore Rules não possui loops. O limite fechado de 10 mantém a
    // validação integral dos IDs, ordem e unicidade sem extrapolar o tamanho
    // razoável de uma lista de candidatos do protocolo V1.
    function limitationExerciseIdListValid(ids, exerciseId) {
      return ids is list
        && ids.size() <= 10
        && ids.toSet().size() == ids.size()
        && (ids.size() < 1 || (limitationExerciseIdValid(ids[0]) && ids[0] != exerciseId))
        && (ids.size() < 2 || (limitationExerciseIdValid(ids[1]) && ids[1] != exerciseId))
        && (ids.size() < 3 || (limitationExerciseIdValid(ids[2]) && ids[2] != exerciseId))
        && (ids.size() < 4 || (limitationExerciseIdValid(ids[3]) && ids[3] != exerciseId))
        && (ids.size() < 5 || (limitationExerciseIdValid(ids[4]) && ids[4] != exerciseId))
        && (ids.size() < 6 || (limitationExerciseIdValid(ids[5]) && ids[5] != exerciseId))
        && (ids.size() < 7 || (limitationExerciseIdValid(ids[6]) && ids[6] != exerciseId))
        && (ids.size() < 8 || (limitationExerciseIdValid(ids[7]) && ids[7] != exerciseId))
        && (ids.size() < 9 || (limitationExerciseIdValid(ids[8]) && ids[8] != exerciseId))
        && (ids.size() < 10 || (limitationExerciseIdValid(ids[9]) && ids[9] != exerciseId));
    }

    function limitationRuleValid(rule, exerciseId) {
      return rule is map
        && (
          (
            rule.keys().hasOnly(['status'])
            && rule.status in ['compatible', 'not_applicable']
          )
          || (
            rule.keys().hasAll(['status', 'adaptation'])
            && rule.keys().hasOnly(['status', 'adaptation'])
            && rule.status == 'adapt'
            && rule.adaptation is map
            && rule.adaptation.keys().hasAll(['kind', 'exerciseId'])
            && rule.adaptation.keys().hasOnly(['kind', 'exerciseId'])
            && rule.adaptation.kind == 'exercise_variant'
            && limitationExerciseIdValid(rule.adaptation.exerciseId)
            && rule.adaptation.exerciseId != exerciseId
          )
          || (
            rule.keys().hasAll(['status', 'substituteExerciseIds', 'candidateStatus'])
            && rule.keys().hasOnly(['status', 'substituteExerciseIds', 'candidateStatus'])
            && rule.status == 'avoid'
            && limitationExerciseIdListValid(rule.substituteExerciseIds, exerciseId)
            && (
              (rule.substituteExerciseIds.size() == 0
                && rule.candidateStatus == 'missing_exercise_candidate')
              || (rule.substituteExerciseIds.size() > 0
                && rule.candidateStatus == 'ready')
            )
          )
        );
    }

    function limitationRegionsValid(regions, exerciseId) {
      return regions is map
        && regions.keys().hasAll([
             'knee', 'hip', 'back', 'shoulder', 'elbow', 'wrist', 'ankle_foot'
           ])
        && regions.keys().hasOnly([
             'knee', 'hip', 'back', 'shoulder', 'elbow', 'wrist', 'ankle_foot'
           ])
        && limitationRuleValid(regions.knee, exerciseId)
        && limitationRuleValid(regions.hip, exerciseId)
        && limitationRuleValid(regions.back, exerciseId)
        && limitationRuleValid(regions.shoulder, exerciseId)
        && limitationRuleValid(regions.elbow, exerciseId)
        && limitationRuleValid(regions.wrist, exerciseId)
        && limitationRuleValid(regions.ankle_foot, exerciseId);
    }

    function limitationProfileValid(profile, exerciseId) {
      return profile is map
        && profile.schemaVersion == 1
        && profile.protocolVersion == 'musculoskeletal-v1'
        && profile.reviewStatus == 'approved'
        && limitationRegionsValid(profile.regions, exerciseId)
        && (
          (
            profile.keys().hasAll([
              'schemaVersion', 'protocolVersion', 'reviewStatus', 'reviewBasis', 'regions'
            ])
            && profile.keys().hasOnly([
              'schemaVersion', 'protocolVersion', 'reviewStatus', 'reviewBasis', 'regions'
            ])
            && profile.reviewBasis == 'product_policy'
          )
          || (
            profile.keys().hasAll([
              'schemaVersion', 'protocolVersion', 'reviewStatus', 'reviewBasis',
              'regions', 'reviewedAt', 'reviewedBy'
            ])
            && profile.keys().hasOnly([
              'schemaVersion', 'protocolVersion', 'reviewStatus', 'reviewBasis',
              'regions', 'reviewedAt', 'reviewedBy'
            ])
            && profile.reviewBasis == 'professional_review'
            && profile.reviewedAt is timestamp
            && profile.reviewedBy is string
            && profile.reviewedBy.size() >= 1
            && profile.reviewedBy.size() <= 200
          )
        );
    }

    // `exerciseWriteValid` valida identidade (id/slug == id do documento) e
    // os poucos enums baratos de checar (status/difficulty). Não duplica o
    // dicionário inteiro de taxonomia (músculos, padrões de movimento,
    // equipamentos etc. — dezenas de valores em `src/types/exercise.ts`)
    // aqui: o gate real de "quem escreve" já é `isAdmin()`, e a validação
    // completa de taxonomia é feita no formulário do painel
    // (`exerciseValidation.ts`, reaproveitado lá). Duplicar tudo aqui seria
    // alto custo de manutenção por um ganho de segurança marginal, dado que
    // só um admin autenticado chega a este `write` — mesmo trade-off que
    // `supportTicketValid` já adota para campos operacionais.
    function exerciseWriteValid(exerciseId) {
      let d = request.resource.data;
      // Os 79 documentos criados pelo seed histórico usam o document id
      // como identidade e não persistem body.id. Documentos novos do painel
      // podem conter o campo duplicado; quando presente, ele continua preso
      // ao mesmo exerciseId e não pode ser falsificado em updates.
      return d.get('id', exerciseId) == exerciseId
        && d.slug == exerciseId
        && d.status in ['active', 'inactive', 'draft']
        && d.difficulty in ['beginner', 'intermediate', 'advanced']
        && d.name is map
        && d.name.keys().hasAll(['ptBR', 'en', 'es'])
        && d.metadata is map
        && d.metadata.updatedAt == request.time
        && (!('limitationProfile' in d)
            || limitationProfileValid(d.limitationProfile, exerciseId));
    }

    match /exercises/{exerciseId} {
      allow read: if hasVerifiedEmailForPrivateAccess();

      allow create: if isAdmin()
        && exerciseWriteValid(exerciseId)
        && request.resource.data.metadata.createdAt == request.time
        && request.resource.data.metadata.version == 1;

      // `createdAt`/`version` imutáveis a partir da Rule: o cliente nunca
      // reescreve o histórico, e isso também bloqueia por construção uma
      // tentativa de "criar" sobre um id que já existe com dados diferentes
      // (createdAt novo != createdAt armazenado ⇒ rejeitado como update).
      allow update: if isAdmin()
        && exerciseWriteValid(exerciseId)
        && (!('limitationProfile' in resource.data)
            || ('limitationProfile' in request.resource.data))
        && request.resource.data.metadata.createdAt == resource.data.metadata.createdAt
        && request.resource.data.metadata.version == resource.data.metadata.version;

      // Exercícios podem ser referenciados por histórico de treino — sem
      // hard delete nesta fase (docs/27 §8: desativação via status).
      allow delete: if false;
    }

    // Published clinical dataset identity. Clients consume only the active
    // pointer; immutable version snapshots and all writes remain server-only.
    // Contains only a version string + content hash — no clinical/PII data —
    // so it needs no stronger gate than `isSignedIn()`. Every workout program
    // generation reads this (to stamp its dataset identity) regardless of
    // whether the user has any limitations at all; gating it behind email
    // verification blocked first-program generation for every signed-in,
    // not-yet-verified account (`workoutPrograms.ts`'s `prepareWorkoutProgram`
    // maps the resulting permission-denied into `INVALID_CONFIGURATION`).
    match /limitationDatasetState/{stateId} {
      allow read: if stateId == 'active' && isSignedIn();
      allow write: if false;
    }

    // Fase 6 — ops-controlled rollout gate for NEW Workout Lifecycle V2
    // migrations (architecture/12_PHASE_6_IMPLEMENTATION.md "Rollout").
    // Admin-SDK-write-only, same pattern as limitationDatasetState above:
    // the client can never edit its own rollout eligibility.
    match /workoutLifecycleRolloutConfig/{configId} {
      allow read: if configId == 'active' && isSignedIn();
      allow write: if false;
    }

    // P0-C — workoutExecutions mutex hardening gate (docs/workout-lifecycle/
    // hardening plan, 2026-09). Same pattern as `workoutLifecycleRolloutConfig`
    // above: Admin-SDK-write-only (see `scripts/toggleWorkoutExecutionMutexHardening.ts`,
    // not executed as part of this change), client-readable so the app can
    // show accurate copy/telemetry, never client-writable. Turning
    // `requireMutexOnCreate` on is what makes `workoutExecutionMutexHardeningEnabled()`
    // (below) start requiring every new IN_PROGRESS `workoutExecutions` create
    // to arrive paired with a matching `workoutExecutionState/current` write —
    // see the `workoutExecutions` match block's create rule.
    match /workoutExecutionProtocolConfig/{configId} {
      allow read: if configId == 'active' && isSignedIn();
      allow write: if false;
    }

    // Phase 10E — ops-controlled circuit breaker for ALREADY-migrated V2
    // accounts (docs/workout-lifecycle/v2/architecture/
    // 26_FINAL_INDEPENDENT_ADVERSARIAL_AUDIT_2.md §50). Deliberately
    // separate from `workoutLifecycleRolloutConfig` above — rollout decides
    // who enters V2, this decides whether an already-migrated account's
    // mutation may proceed right now. Admin-SDK-write-only; enforcement
    // itself happens in `authorizeWorkoutLifecycleMutationHandler`
    // (functions/src/workoutLifecycle/circuitBreaker.ts), not in Rules — no
    // client read is even needed for that, so none is granted.
    match /workoutLifecycleCircuitBreaker/{configId} {
      allow read, write: if false;
    }

    match /limitationDatasetVersions/{datasetHash} {
      allow read, write: if false;
    }

    function workoutTemplateValid(templateId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'id', 'version', 'sourceVersion', 'libraryId', 'contentHash',
          'status', 'profile', 'split', 'rationale', 'sessions',
          'createdAt', 'updatedAt'
        ])
        && data.id == templateId
        && templateId.matches('^T(00[1-9]|0[1-8][0-9]|090)$')
        && data.version is int && data.version >= 1
        && data.sourceVersion is string
        && data.contentHash is string && data.contentHash.size() == 64
        && data.status == 'active'
        && data.sessions is list && data.sessions.size() >= 1 && data.sessions.size() <= 6
        && data.updatedAt == request.time;
    }

    match /workoutTemplates/{templateId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && workoutTemplateValid(templateId)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && workoutTemplateValid(templateId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // Push registries, raw tokens, dispatches and deliveries are exclusively
    // backend-controlled. App clients use App-Check-enforced callables and
    // never read or write these collections directly.
    match /pushInstallations/{installationId} {
      allow read, write: if false;
    }

    match /pushTokenOwners/{tokenHash} {
      allow read, write: if false;
    }

    match /notificationDispatches/{dispatchId} {
      allow read, write: if false;
      match /deliveries/{deliveryId} {
        allow read, write: if false;
      }
    }

    // ── Deny all undocumented collections ─────────────────────────────────
    // Everything not documented above remains denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
