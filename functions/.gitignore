# Build output — never commit compiled Functions code, only source.
# Anchored with a leading slash so it matches only functions/lib (tsc's
# outDir) and never functions/src/lib, which is real source code.
/lib/

node_modules/
firestore-debug.log
*.local
.env
.env.*
!.env.example
*.tsbuildinfo

# Generated by scripts/syncScheduleEngineToFunctions.cjs — src/scheduleEngine/ is the
# single source of truth. weekday.ts is a hand-written, checked-in shim, not generated.
src/workoutLifecycle/scheduleEngine/calendar.ts
src/workoutLifecycle/scheduleEngine/resolver.ts
src/workoutLifecycle/scheduleEngine/types.ts
src/workoutLifecycle/scheduleEngine/localDate.ts
src/workoutLifecycle/scheduleEngine/identities.ts

# Generated by scripts/syncPrescriptionEngineToFunctions.cjs — src/workoutPrescription/,
# src/prescriptionEvolution/, and the docs/ catalogs are the single source of truth. Every
# file here (including the AppState type shim) is mechanically derived; none is hand-written.
src/workoutLifecycle/prescriptionEngine/
src/workoutLifecycle/docs/
