rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // FASE 7 (docs/13_assinaturas_e_billing.md §10/§11/§26): same
    // server-side authorization as firestore.rules' `hasServerPremium`,
    // duplicated here on purpose — Storage Rules and Firestore Rules are
    // two separate rules engines with no shared function namespace (same
    // reason `PREMIUM_ENTITLEMENT_ID` is duplicated between the client and
    // functions/ — see functions/src/billing/constants.ts's top comment).
    // Both copies must read the exact same field
    // (`users/{userId}.subscription.entitlementActive`, written only by
    // `applySubscriptionEventAtomically` via the Admin SDK) and be kept in
    // sync manually if that field ever changes.
    //
    // Uses Cloud Storage for Firebase's cross-service Firestore access
    // (`firestore.get`/`firestore.exists`) rather than Custom Claims or a
    // Cloud Function proxy — see the Fase 7 report §4 for why: the mirror
    // already exists, is already hardened (idempotent, ordering-aware,
    // fail-closed), and is already the client's own mental model of
    // "server-controlled subscription state"; Custom Claims would add ID
    // token refresh latency on top of webhook latency for no benefit, and a
    // Function proxy would be strictly more code for a plain create/delete
    // that Storage Rules can already express safely. `.get(..., false)`
    // fails closed for a missing map or field — never defaults to `true`.
    function hasServerPremium(userId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId))
        && firestore.get(/databases/(default)/documents/users/$(userId))
             .data.subscription.get('entitlementActive', false) == true;
    }

    match /users/{userId}/profile/avatar {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Fotos privadas de evolução (Photo Vault, docs/20). O objeto é
    // ciphertext opaco (AES-256-GCM produzido no dispositivo), por isso o
    // contentType é application/octet-stream e NÃO image/* — o Storage
    // nunca vê uma imagem aqui. O metadado correspondente vive em
    // users/{userId}/progressPhotos/{photoId} no Firestore.
    match /users/{userId}/progressPhotos/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // FASE 7: ADD_PROGRESS_PHOTO/DELETE_PROGRESS_PHOTO are Premium
      // capabilities (Fase 3) — `hasServerPremium(userId)` is required
      // alongside ownership on create/delete, never instead of it. `read`
      // above stays ownership-only: Free keeps full read access to an
      // existing gallery, matching the Firestore-side rule for the same
      // metadata.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && hasServerPremium(userId)
        // Imutabilidade real: no Cloud Storage um upload sobre um caminho já
        // existente cria uma nova GERAÇÃO do objeto e é avaliado como
        // `create`, não como `update` — por isso `allow update: if false`
        // sozinho NÃO impede sobrescrita. `resource == null` exige que nada
        // exista no caminho. Substituir uma foto = excluir + novo photoId.
        && resource == null
        && request.resource.size > 0
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.metadata.keys().hasAll(['ownerId', 'photoId'])
        && request.resource.metadata.ownerId == userId
        && (
          // Full ciphertext. The two-key branch preserves rollout
          // compatibility with pre-Phase-13 clients; the new client labels
          // the asset explicitly.
          (
            fileName == request.resource.metadata.photoId + '.enc'
            && request.resource.size <= 10 * 1024 * 1024
            && (
              request.resource.metadata.keys().hasOnly(['ownerId', 'photoId'])
              || (
                request.resource.metadata.keys().hasOnly(['ownerId', 'photoId', 'assetKind'])
                && request.resource.metadata.assetKind == 'full'
              )
            )
          )
          ||
          // Thumbnail is independently encrypted and receives a deliberately
          // much smaller abuse ceiling. No plaintext image/* is accepted.
          (
            fileName == request.resource.metadata.photoId + '.thumb.enc'
            && request.resource.size <= 512 * 1024
            && request.resource.metadata.keys().hasOnly(['ownerId', 'photoId', 'assetKind'])
            && request.resource.metadata.assetKind == 'thumbnail'
          )
        );

      // Cobre updateMetadata(): os metadados de um objeto existente também
      // não podem ser alterados.
      allow update: if false;

      allow delete: if request.auth != null && request.auth.uid == userId && hasServerPremium(userId);
    }

    match /users/{userId}/support/{ticketId}/attachments/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata.ownerId == userId
        && request.resource.metadata.ticketId == ticketId;
      allow update, delete: if false;
    }
  }
}
